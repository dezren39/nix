{
  "pool": {
    "max": 4,
    "min": 0,
    "idleTimeout": "5m",
    "callTimeout": "120s",
    "startTimeout": "60s",
    "sharing": "shared",
    "scope": "global"
  },
  "logging": {
    "format": "text",
    "level": "info",
    "source": "warn",
    "maxBytes": 16777216,
    "maxLines": 200000,
    "maxAge": "24h",
    "keep": 8,
    "include": [
      "host",
      "user",
      "process",
      "version"
    ]
  },
  "daemon": {
    "reapInterval": "30s",
    "saveInterval": "5m"
  },
  "catalog": {
    "budget": 2000
  },
  "script": {
    "permissions": "all",
    "captureConsole": true,
    "typecheckTimeout": "60s"
  },
  "plumbing": {
    "shutdownGrace": "2s",
    "stdioDrainGrace": "3s",
    "stdioMaxLine": "64MiB",
    "daemonConnectTimeout": "20s",
    "daemonPollInterval": "50ms",
    "daemonRestartSettle": "100ms",
    "httpIdleTimeout": "30s",
    "httpRequestTimeout": "10m",
    "followPollInterval": "500ms",
    "logQueryLimit": 100,
    "restartBackoffStep": "2s",
    "restartBackoffMax": "30s",
    "registryTimeout": "30s",
    "eventHistory": 1024,
    "streamReconnect": "2s",
    "taskTTL": "10m",
    "taskResultWait": "2m",
    "statsTop": 20,
    "registryLimit": 20
  },
  "resolve": {
    "dialTimeout": "200ms"
  },
  "elicit": {
    "ttl": "120s",
    "pollInterval": "250ms",
    "handlerTimeout": "5m",
    "inputRounds": 8
  },
  "http": {
    "bodyLimit": "1MiB",
    "callBodyLimit": "64MiB",
    "controlBodyLimit": "64KiB",
    "readHeaderTimeout": "10s",
    "shutdownGrace": "5s",
    "ssePing": "15s",
    "sseRetry": "2s",
    "streamBufferInit": "64KiB",
    "streamBufferMax": "8MiB",
    "idleConns": 8,
    "remoteIdleConns": 16
  },
  "autostart": {
    "bin": "",
    "args": [
      "daemon",
      "--detached"
    ],
    "idleExit": "4h",
    "connectTimeout": "20s",
    "pollInterval": "50ms",
    "pingTimeout": "2s",
    "logTail": "2KB"
  },
  "limits": {
    "searchLimit": 20,
    "completionValues": 100,
    "elicitPending": 100,
    "registryPageSize": 30,
    "leaseTTL": "30m",
    "socketProbeTimeout": "500ms",
    "warmTimeout": "3m",
    "refreshTimeout": "3m",
    "inlineStartTimeout": "5s",
    "inlineStartPoll": "20ms",
    "inlineProbeTimeout": "200ms",
    "doctorTimeout": "20s",
    "releaseTimeout": "10s",
    "followBacklog": 1000
  },
  "files": {
    "dirMode": "0700",
    "privateMode": "0600",
    "publicMode": "0644",
    "publicDirMode": "0755"
  },
  "plugin": {
    "bin": "mcpx",
    "binArgs": [],
    "backend": "auto",
    "discoveryRetry": "60s",
    "toolTiming": false,
    "env": "full",
    "instructions": false,
    "tools": false,
    "skills": []
  }
}
