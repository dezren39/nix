{
  "pool": {
    "max": 4,
    "min": 0,
    "idleTimeout": "5m",
    "callTimeout": "120s",
    "startTimeout": "60s",
    "sharing": "shared",
    "scope": "global"
  },
  "logging": {
    "format": "text",
    "level": "info",
    "source": "warn",
    "maxBytes": 16777216,
    "maxLines": 200000,
    "maxAge": "24h",
    "keep": 8,
    "include": [
      "host",
      "user",
      "process",
      "version"
    ]
  },
  "daemon": {
    "reapInterval": "30s",
    "saveInterval": "5m"
  },
  "catalog": {
    "budget": 2000
  },
  "script": {
    "permissions": "all",
    "captureConsole": true,
    "typecheckTimeout": "60s"
  },
  "plumbing": {
    "shutdownGrace": "2s",
    "stdioDrainGrace": "3s",
    "stdioMaxLine": "64MiB",
    "daemonConnectTimeout": "20s",
    "daemonPollInterval": "50ms",
    "daemonRestartSettle": "100ms",
    "httpIdleTimeout": "30s",
    "httpRequestTimeout": "10m",
    "followPollInterval": "500ms",
    "logQueryLimit": 100,
    "restartBackoffStep": "2s",
    "restartBackoffMax": "30s",
    "registryTimeout": "30s",
    "eventHistory": 1024,
    "streamReconnect": "2s",
    "taskTTL": "10m",
    "taskResultWait": "2m",
    "statsTop": 20,
    "registryLimit": 20
  },
  "elicit": {
    "ttl": "120s",
    "pollInterval": "250ms",
    "handlerTimeout": "5m",
    "inputRounds": 8
  },
  "exec": {
    "timeout": "120s",
    "output": "text",
    "remoteOutput": "structured",
    "delivery": "reference"
  },
  "artifacts": {
    "ttl": "24h",
    "maxBytes": "64MiB",
    "quota": "1GiB",
    "inlineMaxBytes": "1MiB",
    "chunkBytes": "256KiB",
    "gcInterval": "10m",
    "interceptImages": true,
    "nameMaxLength": 200,
    "nameCollisionLimit": 1000,
    "idBytes": 16,
    "listLimit": 200
  }
}
