+def out_of_prefix_path_entries() -> list[str]:
+    """Return `sys.path` directories a bare `sys.executable` cannot find itself.
+
+    Console-script wrappers (nixpkgs, pipx, `pip install --target`) keep the
+    installed distributions outside the interpreter's own prefix and splice them
+    into `sys.path` at run time. The generated launcher re-invokes
+    `sys.executable -m sidepulse` directly, which skips that splicing and dies
+    with "No module named sidepulse". Capturing the out-of-prefix entries lets
+    the launcher restore them through `PYTHONPATH`.
+
+    For ordinary in-prefix installs (system Python, venv, Homebrew) nothing is
+    out of prefix, so this returns an empty list and the launcher is unchanged.
+    """
+    prefixes = tuple(
+        os.path.realpath(prefix)
+        for prefix in (
+            sys.prefix,
+            sys.base_prefix,
+            sys.exec_prefix,
+            sys.base_exec_prefix,
+        )
+        if prefix
+    )
+    # sys.path[0] is the running script's directory (or the cwd). It is an
+    # artifact of how setup was invoked, never part of the install layout.
+    script_dir = os.path.realpath(sys.path[0]) if sys.path and sys.path[0] else None
+
+    entries: list[str] = []
+    seen: set[str] = set()
+    for raw in sys.path:
+        if not raw:
+            continue
+        resolved = os.path.realpath(raw)
+        if resolved in seen or resolved == script_dir:
+            continue
+        if not os.path.isdir(resolved):
+            continue
+        if any(
+            resolved == prefix or resolved.startswith(prefix + os.sep)
+            for prefix in prefixes
+        ):
+            continue
+        seen.add(resolved)
+        entries.append(resolved)
+    return entries
+
