@@ -0,0 +1,222 @@
+"""Teardown on the `sidepulse setup` path must be bounded and self-healing.
+
+`launchctl bootout` blocks until the job's processes exit, so a status bar
+that launchd fails to signal used to wedge `sidepulse setup` indefinitely
+(observed: 22 minutes during a nix-darwin activation). These tests pin the
+bounded behaviour: the fast path is unchanged, a stuck bootout escalates to
+SIGTERM then SIGKILL, and nothing on the path raises or blocks.
+"""
+
+from __future__ import annotations
+
+import subprocess
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from sidepulse import launchctl, status_bar_launch
+
+
+def _completed(command, returncode=0, stdout="", stderr=""):
+    return subprocess.CompletedProcess(command, returncode, stdout, stderr)
+
+
+class BoundedBootoutTests(unittest.TestCase):
+    def test_prompt_bootout_does_not_escalate(self) -> None:
+        calls: list[list[str]] = []
+
+        def fake_run(command, *args, **kwargs):
+            calls.append(list(command))
+            self.assertIn("timeout", kwargs)
+            self.assertIsNotNone(kwargs["timeout"])
+            return _completed(command, 0)
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.launchctl.os.kill") as kill,
+        ):
+            ok = launchctl.bootout_service("gui/501", Path("/tmp/a.plist"), "io.x")
+
+        self.assertTrue(ok)
+        self.assertEqual(calls, [["launchctl", "bootout", "gui/501", "/tmp/a.plist"]])
+        kill.assert_not_called()
+
+    def test_failed_but_prompt_bootout_does_not_escalate(self) -> None:
+        # A job that was never loaded exits non-zero. That is the common case
+        # on first install and must not trigger any signalling.
+        calls: list[list[str]] = []
+
+        def fake_run(command, *args, **kwargs):
+            calls.append(list(command))
+            return _completed(command, 3)
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.launchctl.os.kill") as kill,
+        ):
+            ok = launchctl.bootout_service("gui/501", Path("/tmp/a.plist"), "io.x")
+
+        self.assertFalse(ok)
+        self.assertEqual(len(calls), 1)
+        kill.assert_not_called()
+
+    def test_timed_out_bootout_escalates_to_sigterm(self) -> None:
+        calls: list[list[str]] = []
+
+        def fake_run(command, *args, **kwargs):
+            calls.append(list(command))
+            if command[1] == "bootout" and len(calls) == 1:
+                raise subprocess.TimeoutExpired(command, kwargs.get("timeout", 1))
+            if command[1] == "print":
+                return _completed(command, 0, stdout="state = running\n\tpid = 4242\n")
+            return _completed(command, 0)
+
+        signalled: list[tuple[int, int]] = []
+
+        def fake_kill(pid, sig):
+            signalled.append((pid, sig))
+            if sig == 0:
+                raise ProcessLookupError
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.launchctl.os.kill", side_effect=fake_kill),
+        ):
+            ok = launchctl.bootout_service("gui/501", Path("/tmp/a.plist"), "io.x")
+
+        self.assertTrue(ok)
+        self.assertEqual([c[1] for c in calls], ["bootout", "print", "bootout"])
+        self.assertEqual(signalled[0], (4242, 15))
+        self.assertNotIn(9, [sig for _, sig in signalled])
+
+    def test_unkillable_job_escalates_to_sigkill_and_still_returns(self) -> None:
+        calls: list[list[str]] = []
+
+        def fake_run(command, *args, **kwargs):
+            calls.append(list(command))
+            if command[1] == "bootout":
+                raise subprocess.TimeoutExpired(command, kwargs.get("timeout", 1))
+            if command[1] == "print":
+                return _completed(command, 0, stdout="\tpid = 4242\n")
+            return _completed(command, 0)
+
+        signalled: list[int] = []
+
+        def fake_kill(pid, sig):
+            signalled.append(sig)  # never raises: the process refuses to die
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.launchctl.os.kill", side_effect=fake_kill),
+            patch("sidepulse.launchctl.time.sleep"),
+            patch("sidepulse.launchctl.time.monotonic", side_effect=range(0, 10_000)),
+            patch("sidepulse.launchctl.warn") as warn,
+        ):
+            ok = launchctl.bootout_service("gui/501", Path("/tmp/a.plist"), "io.x")
+
+        self.assertFalse(ok)
+        self.assertIn(15, signalled)
+        self.assertIn(9, signalled)
+        self.assertEqual([c[1] for c in calls], ["bootout", "print", "bootout"])
+        self.assertTrue(
+            any("could not boot out" in str(call.args[0]) for call in warn.call_args_list),
+            warn.call_args_list,
+        )
+
+    def test_missing_pid_still_retries_and_returns(self) -> None:
+        def fake_run(command, *args, **kwargs):
+            if command[1] == "bootout":
+                raise subprocess.TimeoutExpired(command, kwargs.get("timeout", 1))
+            return _completed(command, 1, stdout="")
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.launchctl.os.kill") as kill,
+            patch("sidepulse.launchctl.warn"),
+        ):
+            ok = launchctl.bootout_service("gui/501", Path("/tmp/a.plist"), "io.x")
+
+        self.assertFalse(ok)
+        kill.assert_not_called()
+
+    def test_launchctl_missing_is_not_fatal(self) -> None:
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=OSError("nope")),
+            patch("sidepulse.launchctl.warn"),
+        ):
+            self.assertFalse(
+                launchctl.bootout_service("gui/501", Path("/tmp/a.plist"), "io.x")
+            )
+
+    def test_every_launchctl_call_is_bounded(self) -> None:
+        seen: list[dict] = []
+
+        def fake_run(command, *args, **kwargs):
+            seen.append(kwargs)
+            return _completed(command, 0)
+
+        with patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run):
+            launchctl.run_launchctl(["launchctl", "print", "gui/501/io.x"])
+            launchctl.service_pid("gui/501/io.x")
+
+        self.assertTrue(seen)
+        for kwargs in seen:
+            self.assertIsInstance(kwargs.get("timeout"), (int, float))
+            self.assertGreater(kwargs["timeout"], 0)
+
+
+class RestartLaunchAgentTests(unittest.TestCase):
+    def test_restart_passes_timeouts_and_does_not_raise(self) -> None:
+        calls: list[list[str]] = []
+
+        def fake_run(command, *args, **kwargs):
+            calls.append(list(command))
+            self.assertIsInstance(kwargs.get("timeout"), (int, float))
+            return _completed(command, 0)
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.status_bar_launch.launch_domain", return_value="gui/501"),
+        ):
+            status_bar_launch.restart_launch_agent(Path("/tmp/a.plist"))
+
+        self.assertEqual(
+            [c[1] for c in calls], ["bootout", "bootstrap", "kickstart"]
+        )
+
+    def test_restart_survives_a_stuck_bootout(self) -> None:
+        # bootout wedges, the job cannot be signalled away, bootstrap then
+        # fails because the job is still loaded -- `kickstart -k` recovers it
+        # and setup continues.
+        def fake_run(command, *args, **kwargs):
+            if command[1] == "bootout":
+                raise subprocess.TimeoutExpired(command, kwargs.get("timeout", 1))
+            if command[1] == "print":
+                return _completed(command, 1)
+            if command[1] == "bootstrap":
+                return _completed(command, 5, stderr="Bootstrap failed: 37")
+            return _completed(command, 0)
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.status_bar_launch.launch_domain", return_value="gui/501"),
+            patch("sidepulse.launchctl.warn"),
+        ):
+            status_bar_launch.restart_launch_agent(Path("/tmp/a.plist"))
+
+    def test_restart_raises_only_when_bootstrap_and_kickstart_both_fail(self) -> None:
+        def fake_run(command, *args, **kwargs):
+            if command[1] == "bootout":
+                return _completed(command, 0)
+            return _completed(command, 5, stderr="Bootstrap failed: 5")
+
+        with (
+            patch("sidepulse.launchctl.subprocess.run", side_effect=fake_run),
+            patch("sidepulse.status_bar_launch.launch_domain", return_value="gui/501"),
+        ):
+            with self.assertRaises(subprocess.CalledProcessError):
+                status_bar_launch.restart_launch_agent(Path("/tmp/a.plist"))
+
+
+if __name__ == "__main__":  # pragma: no cover
+    unittest.main()
