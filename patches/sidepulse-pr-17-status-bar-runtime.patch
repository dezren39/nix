diff --git a/src/sidepulse/launchctl.py b/src/sidepulse/launchctl.py
new file mode 100644
index 0000000..e91fea1
--- /dev/null
+++ b/src/sidepulse/launchctl.py
@@ -0,0 +1,176 @@
+"""Bounded ``launchctl`` invocations.
+
+``launchctl bootout`` does not return until every process in the job has
+exited. A status-bar process that is slow to notice SIGTERM -- or that
+launchd never manages to signal -- therefore wedges the caller for as long
+as the job stays alive. ``sidepulse setup`` runs on every home-manager
+activation, so an unbounded ``bootout`` turns a routine ``switch`` into a
+multi-minute (observed: 22 minute) hang.
+
+Every helper here is bounded. When ``bootout`` overruns its timeout the
+job's own PID is looked up through ``launchctl print`` and signalled
+directly (SIGTERM, then SIGKILL), after which ``bootout`` is retried once.
+Teardown never raises and never blocks indefinitely: a stale job is
+recoverable, a hung activation is not.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any, Sequence
+
+# `launchctl bootout` normally completes in milliseconds. Anything beyond a
+# few seconds means the job is refusing to die, not that the machine is busy.
+LAUNCHCTL_TIMEOUT_SECONDS = 12.0
+# `launchctl print` is a pure query and should be near-instant.
+LAUNCHCTL_QUERY_TIMEOUT_SECONDS = 10.0
+SIGTERM_GRACE_SECONDS = 3.0
+SIGKILL_GRACE_SECONDS = 2.0
+_POLL_INTERVAL_SECONDS = 0.05
+
+_PID_PATTERN = re.compile(r"^\s*pid\s*=\s*(\d+)\s*$", re.MULTILINE)
+
+
+def warn(message: str) -> None:
+    """Report a teardown problem without failing the caller."""
+
+    print(f"sidepulse: {message}", file=sys.stderr)
+
+
+def _describe(args: Sequence[Any]) -> str:
+    return " ".join(str(part) for part in args)
+
+
+def run_launchctl(
+    args: Sequence[Any],
+    *,
+    timeout: float = LAUNCHCTL_TIMEOUT_SECONDS,
+    check: bool = False,
+    quiet: bool = True,
+    **kwargs: Any,
+) -> subprocess.CompletedProcess[Any] | None:
+    """Run ``launchctl`` with a hard timeout.
+
+    Returns the completed process, or ``None`` when the call timed out (the
+    child is killed by ``subprocess.run`` before the exception surfaces) or
+    when ``launchctl`` itself could not be executed.
+    """
+
+    if quiet:
+        kwargs.setdefault("stdout", subprocess.DEVNULL)
+        kwargs.setdefault("stderr", subprocess.DEVNULL)
+    command = [str(part) for part in args]
+    try:
+        return subprocess.run(command, check=check, timeout=timeout, **kwargs)
+    except subprocess.TimeoutExpired:
+        warn(f"`{_describe(command)}` did not finish within {timeout:g}s")
+        return None
+    except OSError as error:  # launchctl missing, or not permitted to exec
+        warn(f"`{_describe(command)}` could not be run: {error}")
+        return None
+
+
+def service_pid(target: str) -> int | None:
+    """Return the PID launchd reports for ``domain/label``, if any."""
+
+    result = run_launchctl(
+        ["launchctl", "print", target],
+        timeout=LAUNCHCTL_QUERY_TIMEOUT_SECONDS,
+        quiet=False,
+        capture_output=True,
+        text=True,
+    )
+    if result is None or result.returncode != 0:
+        return None
+    match = _PID_PATTERN.search(result.stdout or "")
+    if match is None:
+        return None
+    try:
+        pid = int(match.group(1))
+    except ValueError:  # pragma: no cover - guarded by the regex
+        return None
+    return pid if pid > 1 else None
+
+
+def process_alive(pid: int) -> bool:
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError:
+        return True
+    return True
+
+
+def _wait_for_exit(pid: int, grace: float) -> bool:
+    deadline = time.monotonic() + grace
+    while True:
+        if not process_alive(pid):
+            return True
+        if time.monotonic() >= deadline:
+            return False
+        time.sleep(_POLL_INTERVAL_SECONDS)
+
+
+def terminate_service_process(target: str) -> bool:
+    """Signal the job's process directly. Returns True when it is gone."""
+
+    pid = service_pid(target)
+    if pid is None:
+        warn(f"could not determine a pid for {target}")
+        return False
+    for sig, grace in (
+        (signal.SIGTERM, SIGTERM_GRACE_SECONDS),
+        (signal.SIGKILL, SIGKILL_GRACE_SECONDS),
+    ):
+        try:
+            os.kill(pid, sig)
+        except ProcessLookupError:
+            return True
+        except OSError as error:
+            warn(f"could not signal pid {pid} for {target}: {error}")
+            return not process_alive(pid)
+        if _wait_for_exit(pid, grace):
+            return True
+        warn(f"pid {pid} for {target} ignored {sig.name}")
+    return not process_alive(pid)
+
+
+def bootout_service(
+    domain: str,
+    plist_path: Path | str,
+    label: str | None = None,
+    *,
+    timeout: float = LAUNCHCTL_TIMEOUT_SECONDS,
+) -> bool:
+    """Boot a job out of ``domain`` without ever blocking indefinitely.
+
+    The fast path is a single ``launchctl bootout`` exactly as before. Only
+    when that call overruns ``timeout`` is the job's process signalled and
+    the bootout retried. Always returns; never raises.
+    """
+
+    args = ["launchctl", "bootout", domain, str(plist_path)]
+    result = run_launchctl(args, timeout=timeout)
+    if result is not None:
+        return result.returncode == 0
+
+    target = f"{domain}/{label}" if label else domain
+    warn(f"escalating teardown of {target} after a stuck `launchctl bootout`")
+    terminate_service_process(target)
+    retry = run_launchctl(args, timeout=timeout)
+    if retry is not None and retry.returncode == 0:
+        return True
+    warn(
+        f"could not boot out {target}; continuing with a possibly stale job "
+        "rather than blocking setup"
+    )
+    return False
