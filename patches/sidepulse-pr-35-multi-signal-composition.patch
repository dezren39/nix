+    def test_error_keeps_its_signature_others_breathe(self):
+        from sidepulse.compose import (
+            ARRIVAL_STYLE_BREATH,
+            ARRIVAL_STYLE_SIGNATURE,
+            SIGNALS,
+            arrival_plan,
+        )
+
+        # The double blink says "failure" before the colour registers;
+        # smoothing it into a breath would throw that away.
+        self.assertEqual(SIGNALS[SIGNAL_ERROR].arrival_style, ARRIVAL_STYLE_SIGNATURE)
+        self.assertIn("off 120ms", arrival_plan(SIGNAL_ERROR, self.ERROR).program)
+        for key in (SIGNAL_ASK, SIGNAL_DONE, SIGNAL_BUSY):
+            self.assertEqual(SIGNALS[key].arrival_style, ARRIVAL_STYLE_BREATH)
+            self.assertIn("pulse", arrival_plan(key, "").program, key)
