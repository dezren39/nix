+    def test_an_urgent_glow_arrives_faster_than_an_ambient_one(self):
+        # It wants to be recognised as itself; an ambient colour wants to
+        # drift. A long fade spends most of the frame partway between hues,
+        # which is what makes two similar colours blur into one.
+        import re
+
+        urgent = compose_program(
+            (SIGNAL_ERROR, SIGNAL_ASK), mode=MULTI_SIGNAL_BEACON
+        ).program
+        calm = compose_program(
+            (SIGNAL_ERROR, SIGNAL_DONE), mode=MULTI_SIGNAL_BEACON
+        ).program
+
+        def back_fade(program):
+            return int(re.search(r"1:#\w+ (\d+)ms", program).group(1))
+
+        self.assertLess(back_fade(urgent), back_fade(calm))
