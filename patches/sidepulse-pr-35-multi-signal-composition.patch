+class DeviceBudgetTests(unittest.TestCase):
+    """The device rejects an oversized program by blinking red six times.
+
+    That would read as a failure that never happened, so every combination the
+    app can produce is checked against both limits here rather than discovered
+    on the hardware.
+    """
+
+    def test_every_combination_fits(self):
+        for breathe in (False, True):
+            for mode in COMPOSITION_MODES:
+                for signals in every_combination():
+                    composed = compose_program(signals, mode=mode, breathe=breathe)
+                    self.assertTrue(composed.fits(), f"{mode} {signals} breathe={breathe}")
+                    self.assertLessEqual(composed.byte_length, MAX_PROGRAM_BYTES)
+                    self.assertLessEqual(composed.line_count, MAX_PROGRAM_LINES)
+
+    def test_every_combination_ends_in_repeat(self):
+        # Without it the program plays once and the device holds the last
+        # frame, which would silently freeze the status display.
+        for mode in COMPOSITION_MODES:
+            for signals in every_combination():
+                if len(signals) < 2:
+                    continue
+                program = compose_program(signals, mode=mode).program
+                self.assertEqual(program.splitlines()[-1].strip(), "repeat")
+
+    def test_no_indexed_off(self):
+        # `off` is device-wide and rejects an index; `1:off` is a parse error,
+        # not a dim LED. Darkness on one LED has to be an explicit black.
+        for mode in COMPOSITION_MODES:
+            for signals in every_combination():
+                program = compose_program(signals, mode=mode).program
+                for line in program.splitlines():
+                    for segment in line.split(";"):
+                        segment = segment.strip()
+                        if ":" in segment:
+                            self.assertNotIn(
+                                "off",
+                                segment.split(":", 1)[1],
+                                f"{mode} {signals}: {line}",
+                            )
+
