+    def test_every_arrival_plays_once(self):
+        from sidepulse.compose import arrival_plan
+
+        for key, native in (
+            (SIGNAL_ERROR, self.ERROR),
+            (SIGNAL_ASK, ""),
+            (SIGNAL_DONE, self.DONE),
+            (SIGNAL_BUSY, self.HEARTBEAT),
