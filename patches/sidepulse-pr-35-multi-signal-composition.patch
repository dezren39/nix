+        # would be too brief to notice, so the breath is synthesised instead.
+        from sidepulse.compose import arrival_plan
+
+        self.assertIsNotNone(arrival_plan(SIGNAL_DONE, ""))
+
+    def test_leading_silence_never_reaches_an_arrival(self):
+        # The heartbeat is dark for two minutes and then breathes once.
+        # Announcing a new signal with two minutes of nothing would be worse
+        # than not announcing it.
+        from sidepulse.compose import arrival_plan
+
+        plan = arrival_plan(SIGNAL_BUSY, self.HEARTBEAT)
