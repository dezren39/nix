+            composed = compose_program(["error", "done"], mode=mode, timing=timing)
+            corrected = apply_led_correction(composed.program, timing.for_mode(mode))
+            line = next(l for l in corrected.split("\n") if "#" in l)
+            colours = [w for w in line.split() if "#" in w]
+            self.assertEqual(len(colours), 2, f"{mode}: {line}")
+            self.assertNotEqual(colours[0], colours[1], f"{mode}: {line}")
