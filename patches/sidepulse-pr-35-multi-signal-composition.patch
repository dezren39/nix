+        out = _correct_colors("0:#FF0010 120ms; 1:#00FF66 120ms", 0.7, clock)
+        self.assertEqual(out.count("#"), 2)
+
+    def test_the_most_urgent_arrival_wins(self):
+        from sidepulse.compose import newest_arrival
+
+        self.assertEqual(
+            newest_arrival((SIGNAL_BUSY,), (SIGNAL_BUSY, SIGNAL_DONE, SIGNAL_ERROR)),
+            SIGNAL_ERROR,
+        )
+
+    def test_nothing_new_is_not_an_arrival(self):
+        from sidepulse.compose import newest_arrival
+
+        self.assertIsNone(newest_arrival((SIGNAL_ERROR,), (SIGNAL_ERROR,)))
+        self.assertIsNone(newest_arrival((SIGNAL_ERROR, SIGNAL_ASK), (SIGNAL_ERROR,)))
+
+    def test_bounded_repeat_is_why_this_needs_two_writes(self):
+        # The format allows exactly one `repeat`, so "play twice then loop the
+        # composition" cannot be one program. Guards the comment that explains
+        # the timer.
+        from sidepulse.compose import arrival_plan
+
+        program = arrival_plan(SIGNAL_ERROR, self.ERROR).program
+        self.assertEqual(program.count("repeat"), 1)
+
+    def test_cycle_length_is_measured_not_assumed(self):
+        from sidepulse.compose import program_cycle_ms
+
+        self.assertEqual(program_cycle_ms("#FF0010 100ms\noff 200ms\nrepeat"), 300)
+        # A segment with a duration and a delay finishes at their sum.
+        self.assertEqual(program_cycle_ms("0:#FF0010 100ms none 50ms"), 150)
+
+
+if __name__ == "__main__":
+    unittest.main()
