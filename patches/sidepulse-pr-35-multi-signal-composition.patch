+class LedCorrectionShapeTests(unittest.TestCase):
+    """The correction must not change how many LEDs a line addresses."""
+
+    def test_colour_list_lines_keep_one_colour_per_led(self):
+        timing = MultiSignalTiming()
+        for mode in MULTI_SIGNAL_MODES:
+            if mode == MULTI_SIGNAL_PRIORITY:
+                continue
+            composed = compose_program(["error", "done"], mode=mode, timing=timing)
+            corrected = apply_led_correction(composed.program, timing.for_mode(mode))
+            for before, after in zip(
+                composed.program.split("\n"), corrected.split("\n")
+            ):
+                want = before.count("#")
+                got = after.count("#")
+                if want <= 1:
+                    # A device-wide colour is meant to expand to a pair.
+                    self.assertLessEqual(got, 2, f"{mode}: {after}")
+                    continue
+                self.assertEqual(
+                    got, want, f"{mode}: {before!r} became {after!r}"
+                )
