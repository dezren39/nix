+    def test_the_led_correction_is_applied_once_at_the_boundary(self):
+        # Producers emit uncorrected colours and one pass corrects them on the
+        # way to the device. Correcting inside each producer meant several
+        # paths, and the ones added later kept missing it.
+        from sidepulse.compose import (
+            MultiSignalTiming,
+            apply_led_correction,
