+class ShippedDefaultsTests(unittest.TestCase):
+    """The values chosen on hardware, so a later edit has to be deliberate."""
+
+    def test_signal_colours_are_separable_when_dimmed(self):
+        # Dimming scales every channel equally, so two colours differing in one
+        # channel stop being distinguishable long before they stop being
+        # visible. Red and amber are the pair at risk.
+        from sidepulse.compose import MultiSignalTiming, dim
+
+        clock = MultiSignalTiming().for_mode(MULTI_SIGNAL_BEACON)
+
+        def spread(level):
+            def rgb(value):
+                value = value.lstrip("#")
+                return [int(value[i : i + 2], 16) for i in (0, 2, 4)]
+
+            a = rgb(dim(SIGNAL_COLORS[SIGNAL_ERROR], level))
+            b = rgb(dim(SIGNAL_COLORS[SIGNAL_ASK], level))
+            return max(abs(x - y) for x, y in zip(a, b))
+
+        # The original pair managed 19 at the glow level, which read as one
+        # colour on the device.
+        self.assertGreater(spread(clock.glow_level), 40)
+
+    def test_the_correction_sits_on_the_front_led(self):
+        # The back has a hard ceiling at 255 that several colours already
+        # reach, so boosting it fails silently and differently per colour.
+        from sidepulse.compose import DEFAULT_LED_GAIN
+
+        front, back = DEFAULT_LED_GAIN
+        self.assertLess(front, 1.0)
+        self.assertEqual(back, 1.0)
+
+    def test_nothing_clamps_at_the_shipped_correction(self):
+        # The point of correcting on the front: every colour gets the same
+        # ratio instead of whichever one the ceiling allowed.
+        from sidepulse.compose import MultiSignalTiming, dim, led
+
+        clock = MultiSignalTiming().for_mode(MULTI_SIGNAL_BEACON)
+        for key in SIGNAL_ORDER:
+            back = led(dim(SIGNAL_COLORS[key], 1.0), 1, clock).lstrip("#")
+            channels = [int(back[i : i + 2], 16) for i in (0, 2, 4)]
+            source = SIGNAL_COLORS[key].lstrip("#")
+            expected = [int(source[i : i + 2], 16) for i in (0, 2, 4)]
+            self.assertEqual(channels, expected, key)
