+    def test_a_demoted_urgent_signal_glows_above_ambient(self):
+        # Two urgent things, only one can blink at a time. Glowing the other at
+        # the ambient level would call it background, which it is not.
+        from sidepulse.compose import MultiSignalTiming, dim
+
+        clock = MultiSignalTiming().for_mode(MULTI_SIGNAL_BEACON)
+        self.assertGreater(clock.glow_level, clock.ambient_level)
+        self.assertLess(clock.glow_level, clock.demand_level)
+        program = compose_program(
+            (SIGNAL_ERROR, SIGNAL_ASK), mode=MULTI_SIGNAL_BEACON
