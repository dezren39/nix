diff -ruN base34/src/sidepulse/compose.py work/src/sidepulse/compose.py
--- a/src/sidepulse/compose.py	1969-12-31 18:00:00
+++ b/src/sidepulse/compose.py	2026-09-25 15:54:43
@@ -0,0 +1,1739 @@
+"""Show several things at once on a two-LED device.
+
+The aggregate has always answered "what is the single most urgent thing?" and
+painted that. With errors and prompts no longer expiring on a clock, several of
+them are routinely true at the same moment, and priority alone throws the rest
+away: a failure hides a pending permission prompt indefinitely, and you only
+learn about the prompt once you have dealt with the failure.
+
+This module composes one LEDS.LED program that carries the whole set.
+
+Signals, not names
+------------------
+
+Layouts are written against a *ranked list of signals with a tier*, never
+against "red" or "error". A layout asks which signals are present, which of
+them demand action and which are ambient, and lays those out. Adding a fifth
+signal, or recolouring one, needs no change to any layout.
+
+The tier is the part that stops layouts from special-casing. "Error and ask
+behave differently from done and busy" is true, but it is not a fact about
+errors - it is a fact about whether the signal is *asking the user to do
+something*. `TIER_DEMAND` and `TIER_AMBIENT` name that directly, so `beacon`
+can say "demand blinks, ambient glows" without ever mentioning a colour.
+
+What the hardware allows, and does not
+--------------------------------------
+
+The device runs the program by itself; the host writes it once and walks away.
+Everything in the *static* layouts therefore has to be one program, under 512
+bytes and 20 lines, with a single global `repeat` and no loop nesting. See
+docs/sidepulse-leds.md for the probes behind each of those limits.
+
+Two layouts (`drift`, `live`) deliberately break that contract and are driven
+by the host instead, which buys cadences a single static program cannot
+express. They cost a device write per tick, so they are opt-in and rate
+limited.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+MAX_PROGRAM_BYTES = 512
+MAX_PROGRAM_LINES = 20
+
+BLACK = "#000000"
+
+# --- signals ---------------------------------------------------------------
+
+TIER_DEMAND = "demand"
+TIER_AMBIENT = "ambient"
+
+
+# How a signal announces itself when it first appears.
+#
+# `signature` replays the authored animation, for signals whose rhythm is part
+# of their identity - the error's double blink says "failure" before the colour
+# has even registered, and smoothing it into a breath would throw that away.
+#
+# `breath` is a single slow swell in the signal's colour. Most animations are
+# built to repeat in the background, so replaying them verbatim as an
+# announcement is either too brief to notice (the done blip is 110ms) or too
+# busy. A breath is unmistakably "something just happened".
+ARRIVAL_STYLE_SIGNATURE = "signature"
+ARRIVAL_STYLE_BREATH = "breath"
+
+
+@dataclass(frozen=True)
+class StatusSignal:
+    """One thing the device can report.
+
+    `rank` orders urgency, lowest first. `tier` says whether the signal is a
+    request aimed at the user or background information; layouts branch on the
+    tier rather than on which signal it happens to be.
+    """
+
+    key: str
+    color: str
+    rank: int
+    tier: str
+    label: str
+    arrival_style: str = ARRIVAL_STYLE_BREATH
+
+
+SIGNAL_ERROR = "error"
+SIGNAL_ASK = "ask"
+SIGNAL_DONE = "done"
+SIGNAL_BUSY = "busy"
+
+SIGNALS: dict[str, StatusSignal] = {
+    # Pure red rather than the shipped #FF0010: that had a blue tint pushing it
+    # toward crimson, and dropping it reads as a truer red without changing the
+    # separation from amber (which differs only in green).
+    SIGNAL_ERROR: StatusSignal(
+        SIGNAL_ERROR, "#FF0000", 1, TIER_DEMAND, "failed", ARRIVAL_STYLE_SIGNATURE
+    ),
+    # Moved from #FF3A00, which differed from red by 58/255 of green and
+    # nothing else - so on a dimmed LED the two became the same colour long
+    # before they became invisible. At 45% the old pair had a spread of 26;
+    # this has 55. Chosen between #FF3A00 (indistinguishable) and #FFA000
+    # (legible but too yellow to read as a warning).
+    SIGNAL_ASK: StatusSignal(SIGNAL_ASK, "#FF7A00", 2, TIER_DEMAND, "waiting on you"),
+    SIGNAL_DONE: StatusSignal(SIGNAL_DONE, "#00FF66", 3, TIER_AMBIENT, "finished"),
+    SIGNAL_BUSY: StatusSignal(SIGNAL_BUSY, "#8800FF", 4, TIER_AMBIENT, "working"),
+}
+
+SIGNAL_ORDER = tuple(
+    signal.key for signal in sorted(SIGNALS.values(), key=lambda s: s.rank)
+)
+SIGNAL_COLORS = {key: signal.color for key, signal in SIGNALS.items()}
+
+
+def order_signals(signals) -> tuple[str, ...]:
+    """Normalise to rank order, dropping unknowns and duplicates."""
+
+    present = {str(signal) for signal in signals}
+    return tuple(key for key in SIGNAL_ORDER if key in present)
+
+
+def signals_in_tier(signals: tuple[str, ...], tier: str) -> tuple[str, ...]:
+    return tuple(key for key in signals if SIGNALS[key].tier == tier)
+
+
+# --- easing ----------------------------------------------------------------
+
+EASINGS = (
+    "linear",
+    "ease",
+    "ease-in",
+    "ease-out",
+    "ease-in-out",
+    "cosine",
+    "pulse",
+    "none",
+)
+
+
+def _easing(value: object, default: str) -> str:
+    return value if isinstance(value, str) and value in EASINGS else default
+
+
+def _direction(value: object, default: str) -> str:
+    return value if isinstance(value, str) and value in DIRECTIONS else default
+
+
+# --- modes -----------------------------------------------------------------
+
+MULTI_SIGNAL_PRIORITY = "priority"
+MULTI_SIGNAL_ROUND_ROBIN = "round-robin"
+MULTI_SIGNAL_SPLIT = "split"
+MULTI_SIGNAL_PAIRED = "paired"
+MULTI_SIGNAL_ORBIT = "orbit"
+MULTI_SIGNAL_DEPTH = "depth"
+MULTI_SIGNAL_BEACON = "beacon"
+MULTI_SIGNAL_TIDE = "tide"
+MULTI_SIGNAL_DRIFT = "drift"
+MULTI_SIGNAL_LIVE = "live"
+
+# Layouts the host has to keep feeding. Everything else is written once.
+MULTI_SIGNAL_DYNAMIC_MODES = (MULTI_SIGNAL_DRIFT, MULTI_SIGNAL_LIVE)
+
+MULTI_SIGNAL_MODES = (
+    MULTI_SIGNAL_PRIORITY,
+    MULTI_SIGNAL_ROUND_ROBIN,
+    MULTI_SIGNAL_SPLIT,
+    MULTI_SIGNAL_PAIRED,
+    MULTI_SIGNAL_ORBIT,
+    MULTI_SIGNAL_DEPTH,
+    MULTI_SIGNAL_BEACON,
+    MULTI_SIGNAL_TIDE,
+    MULTI_SIGNAL_DRIFT,
+    MULTI_SIGNAL_LIVE,
+)
+
+
+def mode_is_dynamic(mode: str) -> bool:
+    return mode in MULTI_SIGNAL_DYNAMIC_MODES
+
+
+# Compact motifs, whole-device, used by `round-robin` when more than one signal
+# is showing. Each is the authored animation reduced to its recognisable
+# gesture: the error's double blink, the ask's breathe, the done's single blip.
+COMPACT_MOTIFS: dict[str, tuple[str, ...]] = {
+    SIGNAL_ERROR: (
+        "{color} 120ms none",
+        "off 120ms none",
+        "{color} 120ms none",
+        "off 360ms none",
+    ),
+    SIGNAL_ASK: ("{color} 700ms pulse", "off 120ms none"),
+    SIGNAL_DONE: ("{color} 110ms none", "off 500ms ease-out"),
+    SIGNAL_BUSY: ("{color} 700ms pulse", "off 120ms none"),
+}
+
+# --- timing ----------------------------------------------------------------
+
+MIN_TIMING_MS = 20
+MAX_TIMING_MS = 65535
+
+DEFAULT_HOLD_MS = 140
+DEFAULT_GAP_MS = 420
+DEFAULT_SWELL_MS = 900
+DEFAULT_STAGGER_MS = 450
+DEFAULT_ROLL_MS = 1400
+# How long `orbit` takes to fade into each new pair of colours, and with what
+# curve. Short enough not to stall the revolution, long enough not to snap.
+DEFAULT_RESEED_MS = 320
+DEFAULT_RESEED_EASING = "cosine"
+DEFAULT_PUSH_MS = 700
+DEFAULT_MOTIF_SCALE = 1.0
+MIN_MOTIF_SCALE = 0.25
+MAX_MOTIF_SCALE = 8.0
+
+# A single dial over every duration in every layout. Each layout's numbers are
+# tuned relative to each other - a blink is shorter than the gap after it, a
+# swell longer than a blink - and those relationships are the design. Scaling
+# them together changes the pace without disturbing any of that, which is what
+# "the whole thing is too fast" actually asks for. Above 1 is slower.
+#
+# The default is not 1. The per-layout numbers below read naturally as a
+# design - 140ms blink, 420ms gap, 900ms swell - but on an LED a foot from
+# your face, at the edge of vision, every one of them was too quick. Rather
+# than multiply each constant through and lose the legibility of the ratios,
+# the pace lives here.
+DEFAULT_TEMPO = 2.5
+MIN_TEMPO = 0.25
+MAX_TEMPO = 6.0
+DEFAULT_EASING = "none"
+# Which way colours travel across the device in the rotating layouts.
+DIRECTION_BACK_TO_FRONT = "back-to-front"
+DIRECTION_FRONT_TO_BACK = "front-to-back"
+DIRECTIONS = (DIRECTION_BACK_TO_FRONT, DIRECTION_FRONT_TO_BACK)
+DEFAULT_DIRECTION = DIRECTION_BACK_TO_FRONT
+DEFAULT_MASTER_BRIGHTNESS = 255
+DEFAULT_AMBIENT_LEVEL = 0.28
+# How brightly a demand-tier signal is drawn. Full strength is not always
+# right: when the *only* difference between tiers is intensity, an urgent
+# colour at 255 does not read as "urgent", it reads as "glare", and the eye
+# stops distinguishing it from the next one. Pulling it down keeps the ratio
+# that carries the meaning while making the whole thing easier to sit beside.
+DEFAULT_DEMAND_LEVEL = 1.0
+
+# A demand-tier signal shown as *context* rather than as the blink - which
+# happens when two urgent things are live and only one can be on the front at a
+# time. Glowing it at the ambient level would say it is background, which it is
+# not; glowing it at full would compete with the blink.
+#
+# This is an absolute level rather than a fraction of `demand_level`, because
+# what it has to protect is *hue*, not proportion. Dimming scales every channel
+# equally, so two colours that differ only in one channel - red and amber
+# differ by 58/255 of green and nothing else - become indistinguishable well
+# before they become invisible. At 32% that 58 is down to 19 and the back LED
+# simply reads as dim red.
+DEFAULT_GLOW_LEVEL = 0.45
+
+# How much of the frame the back LED spends *travelling* to its next colour.
+#
+# Split by tier on the reasoning that an urgent colour on the back wants to
+# arrive and be recognised, where an ambient one wants to drift. A short fade
+# reaches the colour early and holds it, so it reads as itself; a long one
+# spends most of the frame partway between two hues, which is what makes two
+# similar colours blur into one.
+DEFAULT_GLOW_FADE_URGENT = 0.4
+DEFAULT_GLOW_FADE_AMBIENT = 1.0
+
+# How many blink frames the glow takes to travel between two colours.
+#
+# The blink and the sweep share a timeline, because a line lasts as long as its
+# longest segment - so simply giving the back a longer fade would stretch the
+# front's blink with it. Spreading one colour change over several frames, with
+# an interpolated colour at each step, is the only way to run the two at
+# different speeds on one device.
+#
+# 1 means the glow changes colour on every blink, which ties the two rates
+# together. Above that the sweep slows while the blink keeps its pace.
+DEFAULT_GLOW_STEPS = 1
+MAX_GLOW_STEPS = 6
+
+# Hold the *cycle* length constant instead of the step length.
+#
+# With a fixed step, a layout's pace depends on how many signals happen to be
+# live: four colours at 2.7s each come round every 10.8s, but two come round
+# every 5.4s. Fewer signals therefore read as *busier*, which is backwards -
+# less is happening. Dividing a target cycle by the signal count inverts that:
+# each step stretches as signals leave and tightens as they arrive, so the
+# rhythm of the device stays put while its contents change.
+#
+# Zero disables it and `hold_ms` is used directly.
+DEFAULT_CYCLE_MS = 0
+
+# Per-LED output correction, applied after every other level.
+#
+# The two LEDs on a Dot are not equivalent output devices. They face opposite
+# ways: one shines directly at you and saturates toward white in the middle of
+# its die at high values, losing hue exactly where the signal matters most; the
+# other shines onto whatever the device is resting on, losing light to the
+# surface and picking up a colour cast from it. They want opposite corrections,
+# which no single level can express.
+#
+# With this, a level means the same *perceived* thing in either position, and
+# the numbers elsewhere stop being compensation-by-feel for a physical
+# asymmetry. Defaults to no correction, because the right values depend on the
+# device, the surface and the room - they have to be dialled in by eye.
+# Calibrated on a SidePulse Dot standing on a desk. These are a property of the
+# device, the surface under it and the room - not of the software - so they are
+# the one set of defaults here that will not suit someone else's setup.
+#
+# The whole correction sits on the front because the back has a hard ceiling at
+# 255 and several colours already reach it while still reading dim. Boosting
+# the constrained side works until it saturates and then fails silently, and
+# differently for every colour; attenuating the unconstrained side always
+# works. See docs/sidepulse-modes.md for the measurements.
+DEFAULT_LED_GAIN = (0.48, 1.0)
+MIN_LED_GAIN = 0.1
+MAX_LED_GAIN = 2.0
+
+# Per-channel correction, per LED. `led_gain` scales all three channels
+# together and so preserves hue by construction - which is right for a
+# brightness difference, and useless for a *colour* one.
+#
+# The two LEDs do differ in colour, not only in level: one is seen directly and
+# one through whatever the device is resting on, which absorbs some wavelengths
+# more than others. Correcting that needs the channels moved independently -
+# lifting green on the LED that reads too red, say - and there is no way to
+# express it as a single multiplier.
+#
+# Ordered R, G, B. Defaults to no correction; the right values are a property
+# of the device and the surface, so they have to be found by eye.
+DEFAULT_LED_CHANNEL_GAIN = ((1.0, 0.876, 1.0), (1.0, 1.0, 1.0))
+MIN_LEVEL = 0.02
+MAX_LEVEL = 1.0
+
+# Per-layout departures from the base, applied before any user override.
+BUILT_IN_MODE_TIMING: dict[str, dict[str, object]] = {
+    MULTI_SIGNAL_SPLIT: {
+        # Both LEDs are usually lit and nothing fades, so this is the layout
+        # most continuously *present* - which makes running it at full the
+        # harshest option of the set. Slightly below `paired`, whose pulse
+        # peaks briefly and can afford more.
+        "demand_level": 0.75,
+        "ambient_level": 0.26,
+    },
+    # Two colours at once need longer on screen to be read as two, and the
+    # swell needs room to actually swell: at a short hold a `pulse` has no
+    # time to rise and fall, so it lands as a blink with soft edges rather
+    # than as a breath. The dark gap is correspondingly short - the pulse
+    # already returns to black on its own, so the gap only separates pairs.
+    MULTI_SIGNAL_PAIRED: {
+        "hold_ms": 820,
+        "gap_ms": 260,
+        "easing": "pulse",
+        # Both LEDs are lit at once, so position carries no urgency and
+        # intensity has to. Brighter than `tide`, which never goes dark, and
+        # dimmer than nothing - a pulse peaks briefly so it can afford more.
+        "demand_level": 0.78,
+        "ambient_level": 0.26,
+    },
+    MULTI_SIGNAL_ORBIT: {
+        # A roll is one continuous motion, so its "hold" is the whole
+        # revolution.
+        "easing": "linear",
+        # The slowest of any layout, and slower than `depth` despite showing
+        # brighter colours. Continuous motion reads faster than discrete
+        # blinking at the same nominal duration, because there is no dark gap
+        # punctuating it - the eye has nothing to measure the pace against.
+        "tempo": 4.5,
+    },
+    # A wash should never snap; cosine is the smoothest transition available.
+    MULTI_SIGNAL_TIDE: {
+        "hold_ms": 900,
+        "easing": "cosine",
+        # Never dark means never resting, so both levels sit lower than in the
+        # blinking layouts - and the gap between them is what carries urgency
+        # once darkness is not available to do it.
+        "demand_level": 0.8,
+        "ambient_level": 0.22,
+        # The wash holds its cycle rather than its step, so two colours drift
+        # slowly and four move briskly - the device keeps one rhythm whatever
+        # is happening on it. Chosen so two signals land at an effective tempo
+        # of 4.5; the rest follows, because a constant cycle is strictly 1/n.
+        "cycle_ms": 2700,
+        "tempo": 3.0,
+    },
+    # The glow underneath has to settle rather than flick on.
+    # The glow needs room to travel between colours, so the blink it sits
+    # under has to slow down with it - at the base 140ms the sweep would be
+    # over before the eye found it.
+    MULTI_SIGNAL_BEACON: {
+        "hold_ms": 700,
+        "gap_ms": 260,
+        "easing": "ease-out",
+        # The blink is the signal here, so it stays brighter than `depth`'s -
+        # but not at full, which on a device this close reads as glare rather
+        # than as urgency.
+        "demand_level": 0.72,
+        # The blink is at the right pace but the sweep underneath is not, so
+        # the glow takes two frames per colour instead of one. Same effect as
+        # running the back at a slower tempo, which a shared timeline cannot
+        # otherwise express.
+        "glow_steps": 2,
+    },
+    # Dimness is only legible against something brighter, and a whole-device
+    # rotation shows one colour at a time - so the only available reference is
+    # the *previous* frame. That makes both the dwell and the contrast
+    # load-bearing: too quick and the eye has nothing to compare, too shallow
+    # and there is nothing to notice.
+    MULTI_SIGNAL_DEPTH: {
+        "hold_ms": 700,
+        "gap_ms": 260,
+        # `pulse` rises to the colour and back down within the dwell, so the
+        # frame ends where the next one starts. With `ease-out` the colour was
+        # eased *in* and then cut to black by the `none` on the gap line, which
+        # put a hard drop at the peak of every frame - the one moment the eye
+        # was already looking at.
+        "easing": "pulse",
+        # Raised from 0.12 after the per-LED calibration: that number was set
+        # while the front ran unattenuated and the back was clamping, so the
+        # ambient being judged then is not the ambient seen now. Perceived
+        # brightness is roughly gamma-2.2, so a small step at the dark end
+        # lands harder than the figure suggests.
+        "ambient_level": 0.15,
+        "demand_level": 0.62,
+        # Slower than everything else, and for a structural reason: this is the
+        # only layout where brightness *is* the message, so the eye has to
+        # compare a frame against the one before it rather than read a colour
+        # outright. That comparison needs dwell, and needs more of it the
+        # dimmer the frames get.
+        "tempo": 4.0,
+    },
+}
+
+
+def _clamp_ms(value: object, default: int) -> int:
+    try:
+        number = int(round(float(value)))
+    except (TypeError, ValueError):
+        return default
+    return max(MIN_TIMING_MS, min(MAX_TIMING_MS, number))
+
+
+def _clamp_scale(value: object, default: float) -> float:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return default
+    return max(MIN_MOTIF_SCALE, min(MAX_MOTIF_SCALE, number))
+
+
+def _clamp_tempo(value: object, default: float) -> float:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return default
+    return max(MIN_TEMPO, min(MAX_TEMPO, number))
+
+
+def _clamp_level(value: object, default: float) -> float:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return default
+    return max(MIN_LEVEL, min(MAX_LEVEL, number))
+
+
+def _clamp_brightness(value: object, default: int) -> int:
+    try:
+        number = int(round(float(value)))
+    except (TypeError, ValueError):
+        return default
+    return max(1, min(255, number))
+
+
+TIMING_KEYS = frozenset(
+    {
+        "hold_ms",
+        "gap_ms",
+        "swell_ms",
+        "stagger_ms",
+        "roll_ms",
+        "push_ms",
+        "reseed_ms",
+        "reseed_easing",
+        "motif_scale",
+        "tempo",
+        "easing",
+        "master_brightness",
+        "ambient_level",
+        "demand_level",
+        "glow_level",
+        "glow_fade_urgent",
+        "glow_fade_ambient",
+        "glow_steps",
+        "cycle_ms",
+        "led_gain",
+        "led_channel_gain",
+        "direction",
+    }
+)
+
+
+@dataclass(frozen=True)
+class ModeTiming:
+    """Every tunable, already resolved for one layout."""
+
+    hold_ms: int = DEFAULT_HOLD_MS
+    gap_ms: int = DEFAULT_GAP_MS
+    swell_ms: int = DEFAULT_SWELL_MS
+    stagger_ms: int = DEFAULT_STAGGER_MS
+    roll_ms: int = DEFAULT_ROLL_MS
+    push_ms: int = DEFAULT_PUSH_MS
+    reseed_ms: int = DEFAULT_RESEED_MS
+    motif_scale: float = DEFAULT_MOTIF_SCALE
+    tempo: float = DEFAULT_TEMPO
+    easing: str = DEFAULT_EASING
+    reseed_easing: str = DEFAULT_RESEED_EASING
+    master_brightness: int = DEFAULT_MASTER_BRIGHTNESS
+    ambient_level: float = DEFAULT_AMBIENT_LEVEL
+    demand_level: float = DEFAULT_DEMAND_LEVEL
+    glow_level: float = DEFAULT_GLOW_LEVEL
+    glow_fade_urgent: float = DEFAULT_GLOW_FADE_URGENT
+    glow_fade_ambient: float = DEFAULT_GLOW_FADE_AMBIENT
+    glow_steps: int = DEFAULT_GLOW_STEPS
+    cycle_ms: int = DEFAULT_CYCLE_MS
+    led_gain: tuple[float, ...] = DEFAULT_LED_GAIN
+    led_channel_gain: tuple[tuple[float, ...], ...] = DEFAULT_LED_CHANNEL_GAIN
+    direction: str = DEFAULT_DIRECTION
+
+
+@dataclass(frozen=True)
+class MultiSignalTiming:
+    """Base timings plus per-layout overrides.
+
+    Three layers, each falling through to the next: a layout's override, then
+    the user's base, then the built-in default. So setting `hold_ms` once
+    changes every layout that has not deliberately departed from it, and a
+    layout override stays a statement about that layout only.
+    """
+
+    hold_ms: int = DEFAULT_HOLD_MS
+    gap_ms: int = DEFAULT_GAP_MS
+    swell_ms: int = DEFAULT_SWELL_MS
+    stagger_ms: int = DEFAULT_STAGGER_MS
+    roll_ms: int = DEFAULT_ROLL_MS
+    push_ms: int = DEFAULT_PUSH_MS
+    reseed_ms: int = DEFAULT_RESEED_MS
+    motif_scale: float = DEFAULT_MOTIF_SCALE
+    tempo: float = DEFAULT_TEMPO
+    easing: str = DEFAULT_EASING
+    reseed_easing: str = DEFAULT_RESEED_EASING
+    master_brightness: int = DEFAULT_MASTER_BRIGHTNESS
+    ambient_level: float = DEFAULT_AMBIENT_LEVEL
+    demand_level: float = DEFAULT_DEMAND_LEVEL
+    glow_level: float = DEFAULT_GLOW_LEVEL
+    glow_fade_urgent: float = DEFAULT_GLOW_FADE_URGENT
+    glow_fade_ambient: float = DEFAULT_GLOW_FADE_AMBIENT
+    glow_steps: int = DEFAULT_GLOW_STEPS
+    cycle_ms: int = DEFAULT_CYCLE_MS
+    led_gain: tuple[float, ...] = DEFAULT_LED_GAIN
+    led_channel_gain: tuple[tuple[float, ...], ...] = DEFAULT_LED_CHANNEL_GAIN
+    direction: str = DEFAULT_DIRECTION
+    overrides: dict[str, dict[str, object]] = field(default_factory=dict)
+    # Which base fields the user actually wrote. A built-in per-mode departure
+    # is a *default* chosen because the layout needs it - so it must lose to an
+    # explicit global, or settings the user sets by hand do nothing. Before
+    # this, `demand_level`, `glow_steps` and `cycle_ms` reached no mode at all
+    # and `tempo` reached four of nine.
+    explicit: frozenset = field(default_factory=frozenset, compare=False, repr=False)
+
+    def for_mode(self, mode: str) -> ModeTiming:
+        override = dict(BUILT_IN_MODE_TIMING.get(mode, {}))
+        # An explicit global beats the built-in departure; a per-mode block
+        # beats both. Precedence is therefore: mode block, then explicit base,
+        # then built-in departure, then the plain default.
+        for key in self.explicit:
+            override.pop(key, None)
+        if mode in self.overrides:
+            override.update(self.overrides[mode])
+        # Read after merging: a built-in per-mode pace was previously ignored
+        # because only user overrides were consulted here.
+        tempo = _clamp_tempo(override.get("tempo", self.tempo), self.tempo)
+
+        def paced(value: object, fallback: int) -> int:
+            # Clamped after scaling, so a slow tempo cannot push a duration
+            # past what the device will parse.
+            return _clamp_ms(round(_clamp_ms(value, fallback) * tempo), fallback)
+
+        return ModeTiming(
+            hold_ms=paced(override.get("hold_ms"), self.hold_ms),
+            gap_ms=paced(override.get("gap_ms"), self.gap_ms),
+            swell_ms=paced(override.get("swell_ms"), self.swell_ms),
+            stagger_ms=paced(override.get("stagger_ms"), self.stagger_ms),
+            roll_ms=paced(override.get("roll_ms"), self.roll_ms),
+            push_ms=_clamp_ms(override.get("push_ms"), self.push_ms),
+            reseed_ms=paced(override.get("reseed_ms"), self.reseed_ms),
+            reseed_easing=_easing(
+                override.get("reseed_easing"), self.reseed_easing
+            ),
+            motif_scale=_clamp_scale(override.get("motif_scale"), self.motif_scale),
+            tempo=tempo,
+            easing=_easing(override.get("easing"), self.easing),
+            master_brightness=_clamp_brightness(
+                override.get("master_brightness"), self.master_brightness
+            ),
+            ambient_level=_clamp_level(
+                override.get("ambient_level"), self.ambient_level
+            ),
+            # Never below ambient: intensity is what carries urgency in the
+            # tiered layouts, and a user reaching for "the glow is too faint"
+            # would otherwise invert the meaning of their own indicator.
+            demand_level=max(
+                _clamp_level(override.get("demand_level"), self.demand_level),
+                _clamp_level(override.get("ambient_level"), self.ambient_level),
+            ),
+            glow_level=_clamp_level(override.get("glow_level"), self.glow_level),
+            glow_fade_urgent=_clamp_level(
+                override.get("glow_fade_urgent"), self.glow_fade_urgent
+            ),
+            glow_fade_ambient=_clamp_level(
+                override.get("glow_fade_ambient"), self.glow_fade_ambient
+            ),
+            glow_steps=_clamp_steps(override.get("glow_steps"), self.glow_steps),
+            cycle_ms=(
+                paced(override.get("cycle_ms"), self.cycle_ms)
+                if (override.get("cycle_ms") or self.cycle_ms)
+                else 0
+            ),
+            led_gain=_led_gain_setting(override.get("led_gain"), self.led_gain),
+            led_channel_gain=_led_channel_gain_setting(
+                override.get("led_channel_gain"), self.led_channel_gain
+            ),
+            direction=_direction(override.get("direction"), self.direction),
+        )
+
+    @classmethod
+    def from_mapping(cls, data: object) -> "MultiSignalTiming":
+        """Read a settings block, ignoring anything malformed.
+
+        Hand-edited settings are the expected source, so one bad value falls
+        back to its default rather than discarding the whole block.
+        """
+
+        if not isinstance(data, dict):
+            return cls()
+        explicit = frozenset(key for key in data if key in TIMING_KEYS)
+        overrides: dict[str, dict[str, object]] = {}
+        for mode in MULTI_SIGNAL_MODES:
+            block = data.get(mode)
+            if isinstance(block, dict):
+                overrides[mode] = {
+                    key: value for key, value in block.items() if key in TIMING_KEYS
+                }
+        return cls(
+            hold_ms=_clamp_ms(data.get("hold_ms"), DEFAULT_HOLD_MS),
+            gap_ms=_clamp_ms(data.get("gap_ms"), DEFAULT_GAP_MS),
+            swell_ms=_clamp_ms(data.get("swell_ms"), DEFAULT_SWELL_MS),
+            stagger_ms=_clamp_ms(data.get("stagger_ms"), DEFAULT_STAGGER_MS),
+            roll_ms=_clamp_ms(data.get("roll_ms"), DEFAULT_ROLL_MS),
+            push_ms=_clamp_ms(data.get("push_ms"), DEFAULT_PUSH_MS),
+            reseed_ms=_clamp_ms(data.get("reseed_ms"), DEFAULT_RESEED_MS),
+            reseed_easing=_easing(data.get("reseed_easing"), DEFAULT_RESEED_EASING),
+            motif_scale=_clamp_scale(data.get("motif_scale"), DEFAULT_MOTIF_SCALE),
+            tempo=_clamp_tempo(data.get("tempo"), DEFAULT_TEMPO),
+            easing=_easing(data.get("easing"), DEFAULT_EASING),
+            master_brightness=_clamp_brightness(
+                data.get("master_brightness"), DEFAULT_MASTER_BRIGHTNESS
+            ),
+            ambient_level=_clamp_level(
+                data.get("ambient_level"), DEFAULT_AMBIENT_LEVEL
+            ),
+            demand_level=_clamp_level(
+                data.get("demand_level"), DEFAULT_DEMAND_LEVEL
+            ),
+            glow_level=_clamp_level(data.get("glow_level"), DEFAULT_GLOW_LEVEL),
+            glow_fade_urgent=_clamp_level(
+                data.get("glow_fade_urgent"), DEFAULT_GLOW_FADE_URGENT
+            ),
+            glow_fade_ambient=_clamp_level(
+                data.get("glow_fade_ambient"), DEFAULT_GLOW_FADE_AMBIENT
+            ),
+            glow_steps=_clamp_steps(data.get("glow_steps"), DEFAULT_GLOW_STEPS),
+            cycle_ms=_clamp_ms(data.get("cycle_ms"), DEFAULT_CYCLE_MS)
+            if data.get("cycle_ms")
+            else DEFAULT_CYCLE_MS,
+            led_gain=_led_gain_setting(data.get("led_gain"), DEFAULT_LED_GAIN),
+            led_channel_gain=_led_channel_gain_setting(
+                data.get("led_channel_gain"), DEFAULT_LED_CHANNEL_GAIN
+            ),
+            direction=_direction(data.get("direction"), DEFAULT_DIRECTION),
+            explicit=explicit,
+            overrides=overrides,
+        )
+
+    def to_dict(self) -> dict[str, object]:
+        out: dict[str, object] = {
+            "hold_ms": self.hold_ms,
+            "gap_ms": self.gap_ms,
+            "swell_ms": self.swell_ms,
+            "stagger_ms": self.stagger_ms,
+            "roll_ms": self.roll_ms,
+            "push_ms": self.push_ms,
+            "reseed_ms": self.reseed_ms,
+            "reseed_easing": self.reseed_easing,
+            "motif_scale": self.motif_scale,
+            "tempo": self.tempo,
+            "easing": self.easing,
+            "master_brightness": self.master_brightness,
+            "ambient_level": self.ambient_level,
+            "demand_level": self.demand_level,
+            "glow_level": self.glow_level,
+            "glow_fade_urgent": self.glow_fade_urgent,
+            "glow_fade_ambient": self.glow_fade_ambient,
+            "glow_steps": self.glow_steps,
+            "cycle_ms": self.cycle_ms,
+            "led_gain": list(self.led_gain),
+            "led_channel_gain": [list(row) for row in self.led_channel_gain],
+            "direction": self.direction,
+        }
+        for mode, block in sorted(self.overrides.items()):
+            if block:
+                out[mode] = dict(block)
+        return out
+
+
+def _led_gain_setting(value: object, default: tuple[float, ...]) -> tuple[float, ...]:
+    if not isinstance(value, (list, tuple)) or not value:
+        return default
+    return tuple(
+        _clamp_gain(item, default[index] if index < len(default) else 1.0)
+        for index, item in enumerate(value)
+    )
+
+
+def _led_channel_gain_setting(value: object, default) -> tuple:
+    if not isinstance(value, (list, tuple)) or not value:
+        return default
+    rows = []
+    for index, row in enumerate(value):
+        fallback = default[index] if index < len(default) else (1.0, 1.0, 1.0)
+        if not isinstance(row, (list, tuple)):
+            rows.append(fallback)
+            continue
+        rows.append(
+            tuple(
+                _clamp_gain(item, fallback[pos] if pos < len(fallback) else 1.0)
+                for pos, item in enumerate(row[:3])
+            )
+            or fallback
+        )
+    return tuple(rows)
+
+
+DEFAULT_TIMING = MultiSignalTiming()
+
+
+def _clamp_steps(value: object, default: int) -> int:
+    try:
+        number = int(value)
+    except (TypeError, ValueError):
+        return default
+    return max(1, min(MAX_GLOW_STEPS, number))
+
+
+def _clamp_gain(value: object, default: float) -> float:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return default
+    return max(MIN_LED_GAIN, min(MAX_LED_GAIN, number))
+
+
+def blend(start: str, end: str, position: float) -> str:
+    """A colour `position` of the way from `start` to `end`."""
+
+    def channels(value: str) -> list[int]:
+        value = value.lstrip("#")
+        return [int(value[pos : pos + 2], 16) for pos in (0, 2, 4)]
+
+    mixed = [
+        max(0, min(255, int(round(a + (b - a) * position))))
+        for a, b in zip(channels(start), channels(end))
+    ]
+    return "#{:02X}{:02X}{:02X}".format(*mixed)
+
+
+def dim(color: str, level: float) -> str:
+    """Scale a colour toward black.
+
+    Per-colour rather than via the `brightness` keyword, because brightness is
+    a global multiplier: it cannot make one LED dim while another stays full,
+    which is exactly what the tiered layouts need.
+    """
+
+    text = color.lstrip("#")
+    channels = [int(text[index : index + 2], 16) for index in (0, 2, 4)]
+    scaled = [max(0, min(255, int(round(value * level)))) for value in channels]
+    return "#{:02X}{:02X}{:02X}".format(*scaled)
+
+
+def scale_channels(color: str, factors) -> str:
+    """Scale R, G and B independently, clamped."""
+
+    text = color.lstrip("#")
+    channels = [int(text[pos : pos + 2], 16) for pos in (0, 2, 4)]
+    scaled = [
+        max(0, min(255, int(round(value * factor))))
+        for value, factor in zip(channels, factors)
+    ]
+    return "#{:02X}{:02X}{:02X}".format(*scaled)
+
+
+def led_factors(index: int, clock: ModeTiming) -> tuple[float, float, float]:
+    """The R/G/B multipliers for one LED: overall gain times channel gain."""
+
+    gains = clock.led_gain or DEFAULT_LED_GAIN
+    gain = gains[index] if index < len(gains) else 1.0
+    rows = clock.led_channel_gain or DEFAULT_LED_CHANNEL_GAIN
+    row = rows[index] if index < len(rows) else (1.0, 1.0, 1.0)
+    row = tuple(row) + (1.0,) * (3 - len(row))
+    return (gain * row[0], gain * row[1], gain * row[2])
+
+
+def led(color: str, index: int, clock: ModeTiming) -> str:
+    """A colour as it should be written to one specific LED."""
+
+    factors = led_factors(index, clock)
+    if factors == (1.0, 1.0, 1.0):
+        return color
+    return scale_channels(color, factors)
+
+
+def device(color: str, clock: ModeTiming) -> str:
+    """A colour for a whole-device line.
+
+    Written as a plain colour when the LEDs need no correction, and as a
+    position-indexed colour list when they do - which costs bytes but is the
+    only way to give two LEDs different values on one line.
+    """
+
+    if all(
+        led_factors(index, clock) == (1.0, 1.0, 1.0) for index in (0, 1)
+    ):
+        return color
+    return f"{led(color, 0, clock)} {led(color, 1, clock)}"
+
+
+@dataclass(frozen=True)
+class ComposedProgram:
+    program: str
+    signals: tuple[str, ...]
+    mode: str
+
+    @property
+    def byte_length(self) -> int:
+        return len(self.program.encode("utf-8"))
+
+    @property
+    def line_count(self) -> int:
+        return len([line for line in self.program.splitlines() if line.strip()])
+
+    def fits(self) -> bool:
+        return (
+            self.byte_length <= MAX_PROGRAM_BYTES
+            and self.line_count <= MAX_PROGRAM_LINES
+        )
+
+
+def compose_program(
+    signals,
+    *,
+    mode: str = MULTI_SIGNAL_PRIORITY,
+    breathe: bool = False,
+    timing: MultiSignalTiming | None = None,
+    native_programs: dict[str, str] | None = None,
+    phase: int = 0,
+) -> ComposedProgram:
+    """Build one program showing `signals`, laid out according to `mode`.
+
+    `native_programs` supplies each signal's authored animation. A lone signal
+    always uses its native program, whatever the layout: a composition of one
+    is just that signal, and the authored version is the one tuned to look
+    right.
+
+    `phase` advances the host-driven layouts. Static layouts ignore it, so the
+    same call is safe either way.
+    """
+
+    ordered = order_signals(signals)
+    native = native_programs or {}
+    clock = (timing or DEFAULT_TIMING).for_mode(mode)
+
+    if not ordered:
+        return ComposedProgram(program="off", signals=(), mode=mode)
+
+    if len(ordered) == 1 or mode == MULTI_SIGNAL_PRIORITY:
+        top = ordered[0]
+        program = native.get(top) or _rotation((top,), clock)
+        return ComposedProgram(program=program, signals=(top,), mode=mode)
+
+    builder = _BUILDERS.get(mode)
+    if builder is None:
+        raise ValueError(f"Unknown multi-signal mode: {mode}")
+    if breathe and mode in _BREATHING:
+        builder = _BREATHING[mode]
+    program = _with_master_brightness(builder(ordered, clock, phase), clock)
+
+    composed = ComposedProgram(program=program, signals=ordered, mode=mode)
+    if composed.fits():
+        return composed
+
+    # Rather than let the device reject an oversized program - which blinks all
+    # LEDs red six times and would read as a failure that did not happen - drop
+    # the least urgent signal and try again.
+    return compose_program(
+        ordered[:-1],
+        mode=mode,
+        breathe=breathe,
+        timing=timing,
+        native_programs=native_programs,
+        phase=phase,
+    )
+
+
+def _with_master_brightness(program: str, clock: ModeTiming) -> str:
+    if clock.master_brightness >= 255:
+        return program
+    return f"brightness {clock.master_brightness}\n{program}"
+
+
+def step_ms(clock: ModeTiming, count: int) -> int:
+    """How long one step lasts, holding the cycle constant when asked.
+
+    Without this a layout speeds up as signals leave, because the same step
+    length covers fewer of them. Dividing the cycle by the count keeps the
+    device's rhythm steady and lets the contents change underneath it.
+    """
+
+    if clock.cycle_ms <= 0 or count <= 0:
+        return clock.hold_ms
+    return max(MIN_TIMING_MS, min(MAX_TIMING_MS, round(clock.cycle_ms / count)))
+
+
+def _loop(lines: list[str]) -> str:
+    return "\n".join(lines + ["repeat"])
+
+
+# --- static layouts --------------------------------------------------------
+
+
+def _rotation(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """round-robin: each signal's authored gesture in turn, whole device."""
+
+    lines: list[str] = []
+    for key in signals:
+        color = SIGNAL_COLORS[key]
+        # Falls back by tier: a signal without its own authored motif still
+        # renders, rather than taking the layout down with a KeyError.
+        motif = COMPACT_MOTIFS.get(key) or COMPACT_MOTIFS[
+            SIGNAL_ASK if SIGNALS[key].tier == TIER_DEMAND else SIGNAL_DONE
+        ]
+        lines.extend(step.format(color=color) for step in motif)
+    program = _loop(lines)
+    if clock.motif_scale != 1.0:
+        from .led_status import scale_program_durations
+
+        program = scale_program_durations(program, clock.motif_scale)
+    return program
+
+
+def _split(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """split: urgent in front, quiet behind, both lit, changing on the beat.
+
+    The front carries the demand-tier signals and the back the ambient ones, so
+    which LED a colour appears on says what *kind* of thing it is rather than
+    where it landed in the priority order.
+
+    Both stay lit and each side advances through its own pool independently -
+    the front cycling what is urgent, the back cycling what is merely true. The
+    two sides therefore fall in and out of step whenever the pools are
+    different lengths, which is the closest a single static program gets to two
+    independent rhythms.
+
+    Nothing fades: `none` snaps to the next colour and holds it. The other
+    layouts breathe or sweep; this one simply *is* two colours, changing on a
+    beat.
+
+    With a single urgent signal the front blinks instead of holding. A lone
+    colour sitting steady has no rhythm of its own and stops registering as a
+    demand at all - it just becomes part of the background it is supposed to
+    stand out from. Cycling between two urgent colours provides that rhythm by
+    itself, so the blink is only needed when there is nothing to cycle with.
+    The back is untouched either way: only the front is darkened, and an
+    unassigned LED holds its colour.
+    """
+
+    demand = signals_in_tier(signals, TIER_DEMAND)
+    ambient = signals_in_tier(signals, TIER_AMBIENT)
+    front_pool = demand or signals
+    back_pool = ambient or (signals[1:] if len(signals) > 1 else signals)
+    # With nothing urgent, both sides fall back to the same pool and would show
+    # the identical colour on both LEDs - two LEDs saying one thing. Offsetting
+    # the back by one makes them show different members of that pool, so the
+    # quiet state still uses the whole device.
+    back_offset = 1 if front_pool == back_pool and len(back_pool) > 1 else 0
+    # A demand signal shown as context keeps the demoted level rather than
+    # dropping to ambient, same as `beacon`.
+    back_level = clock.ambient_level if ambient else clock.glow_level
+    # With nothing urgent live, the front is holding an ambient signal and has
+    # no claim on the demand level - the whole device is quiet, so both sides
+    # should say so. Otherwise the same colour would look urgent on one LED and
+    # not on the other.
+    front_level = clock.demand_level if demand else clock.ambient_level
+
+    # The gap is folded into the dwell rather than spent on darkness, so
+    # removing the dark does not double the rate.
+    dwell = min(MAX_TIMING_MS, clock.hold_ms + clock.gap_ms)
+
+    # Enough frames for both pools to return to their starting pair at once.
+    from math import lcm
+
+    # Several urgent signals and nothing else: there is no quiet half to hold
+    # steady, so the two sides stop meaning "urgent" and "background" and the
+    # layout has nothing left to say by position. Alternating them across the
+    # device restores a rhythm, and says "these two, in turn" rather than
+    # parking two similar colours side by side where they blur together.
+    alternate_urgent = len(demand) > 1 and not ambient
+    if alternate_urgent:
+        half = max(MIN_TIMING_MS, dwell // 2)
+        lines = []
+        for index, key in enumerate(demand):
+            lit = dim(SIGNAL_COLORS[key], clock.demand_level)
+            if index % 2 == 0:
+                lines.append(f"0:{lit} {half}ms none; 1:{BLACK} {half}ms none")
+            else:
+                lines.append(f"0:{BLACK} {half}ms none; 1:{lit} {half}ms none")
+        return _loop(lines)
+
+    frames = lcm(max(1, len(front_pool)), max(1, len(back_pool)))
+    blink_front = len(front_pool) == 1
+    lines: list[str] = []
+    for index in range(frames):
+        front = dim(
+            SIGNAL_COLORS[front_pool[index % len(front_pool)]], front_level
+        )
+        back = dim(
+            SIGNAL_COLORS[back_pool[(index + back_offset) % len(back_pool)]],
+            back_level,
+        )
+        if blink_front:
+            lines.append(
+                f"0:{front} {clock.hold_ms}ms none; 1:{back} {clock.hold_ms}ms none"
+            )
+            lines.append(f"0:{BLACK} {clock.gap_ms}ms none")
+        else:
+            lines.append(f"0:{front} {dwell}ms none; 1:{back} {dwell}ms none")
+    return _loop(lines)
+
+
+def _paired(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """paired: two colours lit at once, rotating through every signal.
+
+    A sliding window rather than fixed pairs. Frame `i` puts signal `i` on the
+    front and signal `i+1` on the back, so on the next frame that second colour
+    has moved to the front: each signal enters at the back and travels forward,
+    and every signal is seen twice per cycle, once in each position.
+
+    Fixed pairs (red+amber, then green+purple) showed the same colour in the
+    same place forever, which read as two alternating states rather than as one
+    rotation. The travel is what makes it legible as a cycle through everything.
+
+    `direction` reverses it, so colours run front to back instead.
+    """
+
+    hold, ease = clock.hold_ms, clock.easing
+    count = len(signals)
+    lines: list[str] = []
+    for index in range(count):
+        near = _tier_color(signals[index], clock)
+        far = _tier_color(signals[(index + 1) % count], clock)
+        front, back = (near, far)
+        if clock.direction == DIRECTION_FRONT_TO_BACK:
+            front, back = back, front
+        lines.append(
+            f"{front} {back} {hold}ms {ease}"
+        )
+        lines.append(f"off {clock.gap_ms}ms none")
+    return _loop(lines)
+
+
+def _orbit(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """orbit: colours circulating continuously, every signal taking a turn.
+
+    `roll` rotates whatever is currently visible through one full wraparound,
+    so a seed plus a roll is a complete circulating animation in two lines.
+
+    Seeding once would be cheaper still, but on a two-LED device a seed only
+    ever lights two colours - so with four signals live the two least urgent
+    would never appear at all, which defeats the point of composing. Instead
+    the seed advances as a sliding window: each revolution re-seeds with the
+    next pair, sharing one colour with the previous pair so the handover has
+    something in common rather than being a cut.
+
+    That re-seed is itself eased rather than instantaneous. A bare seed line
+    snaps, and after a smooth revolution a snap is the only thing the eye
+    notices; `reseed_ms` of easing folds the change into the motion.
+
+    On an eight-LED Pro the whole set fits one seed and this reduces to a
+    single continuous revolution, which is what it should be.
+    """
+
+    count = len(signals)
+    lines: list[str] = []
+    for index in range(count):
+        near = SIGNAL_COLORS[signals[index]]
+        far = SIGNAL_COLORS[signals[(index + 1) % count]]
+        front, back = (near, far)
+        if clock.direction == DIRECTION_FRONT_TO_BACK:
+            front, back = back, front
+        lines.append(
+            f"{front} {back} "
+            f"{clock.reseed_ms}ms {clock.reseed_easing}"
+        )
+        lines.append(f"roll {clock.roll_ms}ms {clock.easing}")
+    return _loop(lines)
+
+
+def _depth(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """depth: everything in turn, but urgency sets intensity.
+
+    A rotation where demand-tier signals burn at full strength and ambient ones
+    are dimmed toward black. Glance at it and the bright flashes tell you
+    whether anything needs you; look longer and the dim ones tell you what else
+    is going on.
+    """
+
+    lines: list[str] = []
+    for key in signals:
+        level = (
+            clock.ambient_level
+            if SIGNALS[key].tier == TIER_AMBIENT
+            else clock.demand_level
+        )
+        lines.append(
+            f"{dim(SIGNAL_COLORS[key], level)} "
+            f"{clock.hold_ms}ms {clock.easing}"
+        )
+        lines.append(f"off {clock.gap_ms}ms none")
+    return _loop(lines)
+
+
+def _beacon(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """beacon: what is asking for you blinks, the rest glows underneath.
+
+    The front LED blinks through the **demand-tier** signals, one per frame -
+    so two urgent things both get seen rather than the second hiding behind the
+    first. The back LED never goes out: it cross-fades through the ambient
+    signals, dimmed, so the glow is a slow sweep rather than a sequence of held
+    states.
+
+    With nothing demanding attention there is no beacon to light, and blinking
+    the least-bad news at you would be a lie about its urgency - so the layout
+    steps aside and becomes the wash instead. The device only blinks when
+    something actually wants you.
+
+    Only the front is darkened between blinks. An unassigned LED holds its
+    colour, so the glow survives the dark half for free.
+    """
+
+    demand = signals_in_tier(signals, TIER_DEMAND)
+    hold, ease = clock.hold_ms, clock.easing
+
+    if not demand:
+        # Nothing wants you, so nothing blinks - but the wash that replaces the
+        # blink stays at the ambient level. Rendering it at full would mean the
+        # device got *brighter* the moment the urgent thing cleared, which is
+        # exactly backwards.
+        count = len(signals)
+        lines = []
+        for index in range(count):
+            near = dim(SIGNAL_COLORS[signals[index]], clock.ambient_level)
+            far = dim(SIGNAL_COLORS[signals[(index + 1) % count]], clock.ambient_level)
+            front, back = (near, far)
+            if clock.direction == DIRECTION_FRONT_TO_BACK:
+                front, back = back, front
+            lines.append(
+                f"{front} {back} {hold}ms {ease}"
+            )
+        return _loop(lines)
+
+    ambient = signals_in_tier(signals, TIER_AMBIENT)
+    # With no ambient signals the demand colours glow for each other, offset by
+    # one so the two LEDs never show the same colour at once.
+    glow, offset = (ambient, 0) if ambient else (demand, 1)
+    urgent_glow = not ambient
+    glow_level = max(
+        clock.ambient_level, clock.glow_level if urgent_glow else clock.ambient_level
+    )
+    # An urgent colour on the back arrives early and holds, so it is seen as
+    # itself; an ambient one drifts across the whole frame.
+    fade = round(
+        hold * (clock.glow_fade_urgent if urgent_glow else clock.glow_fade_ambient)
+    )
+    fade = max(MIN_TIMING_MS, min(hold, fade))
+
+    steps = max(1, clock.glow_steps)
+    frames = max(len(demand), len(glow) * steps)
+    lines = []
+    for index in range(frames):
+        lead = dim(SIGNAL_COLORS[demand[index % len(demand)]], clock.demand_level)
+        # The glow advances once every `steps` frames, interpolating on the way
+        # so a slower sweep still reads as travel rather than as a hold.
+        slot = (index // steps + offset) % len(glow)
+        previous = glow[(slot - 1) % len(glow)]
+        toward = dim(SIGNAL_COLORS[glow[slot]], glow_level)
+        position = (index % steps + 1) / steps
+        mixed = blend(dim(SIGNAL_COLORS[previous], glow_level), toward, position)
+        under = mixed
+        lines.append(f"0:{lead} {hold}ms {ease}; 1:{under} {fade}ms cosine")
+        lines.append(f"0:{BLACK} {clock.gap_ms}ms {ease}")
+    return _loop(lines)
+
+
+def _tide(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """tide: a wash that never goes dark, with the two LEDs offset.
+
+    Each colour cross-fades into the next with `cosine`, the smoothest
+    transition the DSL has. No blink and no gap anywhere.
+
+    The two LEDs are deliberately one step apart in the sequence rather than
+    showing the same colour: the front carries where the wash *is* and the back
+    carries where it came from, so a colour visibly travels across the device
+    instead of both ends changing in lockstep. Setting both to one colour threw
+    away the only spatial dimension a two-LED device has, and made a four-signal
+    wash indistinguishable from a single colour cycling.
+
+    Each colour is drawn at its tier's level. This is the one layout that is
+    never off, so it is also the one where constant full brightness is most
+    tiring - and with no darkness to punctuate it, intensity is the only thing
+    left to say which of the colours matters. The wash brightens as it reaches
+    something urgent and settles as it passes.
+    """
+
+    count = len(signals)
+    hold = step_ms(clock, count)
+    lines: list[str] = []
+    for index in range(count):
+        near = _tier_color(signals[index], clock)
+        far = _tier_color(signals[(index + 1) % count], clock)
+        front, back = (near, far)
+        if clock.direction == DIRECTION_FRONT_TO_BACK:
+            front, back = back, front
+        lines.append(
+            f"{front} {back} {hold}ms {clock.easing}"
+        )
+    return _loop(lines)
+
+
+def _tier_color(key: str, clock: ModeTiming) -> str:
+    """A signal's colour drawn at its tier's intensity."""
+
+    level = (
+        clock.ambient_level
+        if SIGNALS[key].tier == TIER_AMBIENT
+        else clock.demand_level
+    )
+    return dim(SIGNAL_COLORS[key], level)
+
+
+# --- breathing variants ----------------------------------------------------
+
+
+def _breathe_frame(front: str, back: str, clock: ModeTiming) -> str:
+    return (
+        f"0:{front} {clock.swell_ms}ms pulse 0ms; "
+        f"1:{back} {clock.swell_ms}ms pulse {clock.stagger_ms}ms"
+    )
+
+
+def _breathe_rotation(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    return _loop(
+        [
+            _breathe_frame(_tier_color(key, clock), _tier_color(key, clock), clock)
+            for key in signals
+        ]
+    )
+
+
+def _breathe_split(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    # Tiers, not position. `signals[0]` dropped every other demand signal, so
+    # with a failure and a prompt both live the prompt was undisplayable.
+    demand = signals_in_tier(signals, TIER_DEMAND) or signals
+    rest = signals_in_tier(signals, TIER_AMBIENT) or signals[1:] or signals
+    return _loop(
+        [
+            _breathe_frame(
+                _tier_color(demand[index % len(demand)], clock),
+                _tier_color(rest[index % len(rest)], clock),
+                clock,
+            )
+            for index in range(max(len(demand), len(rest)))
+        ]
+    )
+
+
+def _breathe_paired(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    lines: list[str] = []
+    for index in range(0, len(signals), 2):
+        pair = signals[index : index + 2]
+        first = _tier_color(pair[0], clock)
+        second = _tier_color(pair[1], clock) if len(pair) > 1 else first
+        lines.append(_breathe_frame(first, second, clock))
+    return _loop(lines)
+
+
+def _breathe_beacon(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    demand = signals_in_tier(signals, TIER_DEMAND) or signals
+    glow = signals_in_tier(signals, TIER_AMBIENT) or signals[1:] or signals
+    return _loop(
+        [
+            _breathe_frame(
+                dim(SIGNAL_COLORS[demand[index % len(demand)]], clock.demand_level),
+                dim(SIGNAL_COLORS[glow[index % len(glow)]], clock.ambient_level),
+                clock,
+            )
+            for index in range(max(len(demand), len(glow)))
+        ]
+    )
+
+
+# --- host-driven layouts ---------------------------------------------------
+
+# How many frames of the virtual timeline each `drift` push carries. Two frames
+# per push keeps the program tiny while leaving the device something to play if
+# the next push is late.
+DRIFT_FRAMES_PER_PUSH = 2
+
+# Periods, in frames, assigned by rank. Chosen coprime so the combined pattern
+# takes their product to repeat rather than their (much smaller) common factor.
+DRIFT_PERIODS = (2, 3, 5, 7)
+
+
+def drift_period_for(rank_index: int) -> int:
+    return DRIFT_PERIODS[min(rank_index, len(DRIFT_PERIODS) - 1)]
+
+
+def _drift(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """drift: independent rhythms that go genuinely out of phase.
+
+    A single static program cannot do this. The device has one global loop, so
+    everything in it resyncs every cycle; the longest non-repeating pattern
+    that fits in 20 lines is about eleven seconds.
+
+    So the timeline lives on the host instead. Each signal is assigned a period
+    in frames by rank - 2, 3, 5, 7, deliberately coprime - and is lit on frames
+    divisible by it. The host advances `phase` and pushes the next couple of
+    frames. With four signals the pattern repeats after 2x3x5x7 = 210 frames,
+    around two and a half minutes, which is long enough that nobody sees it.
+
+    Front carries demand-tier signals, back carries ambient, so the two halves
+    of the device drift against each other rather than the colours smearing.
+    """
+
+    demand = signals_in_tier(signals, TIER_DEMAND)
+    ambient = signals_in_tier(signals, TIER_AMBIENT)
+    lines: list[str] = []
+    for step in range(DRIFT_FRAMES_PER_PUSH):
+        frame = phase * DRIFT_FRAMES_PER_PUSH + step
+        front = _drift_pick(demand, frame)
+        back = _drift_pick(ambient, frame)
+        lines.append(
+            f"0:{front} {clock.hold_ms}ms {clock.easing}; "
+            f"1:{back} {clock.hold_ms}ms {clock.easing}"
+        )
+        lines.append(f"off {clock.gap_ms}ms none")
+    return _loop(lines)
+
+
+def _drift_pick(group: tuple[str, ...], frame: int) -> str:
+    """The colour this half of the device shows on `frame`, or black."""
+
+    for index, key in enumerate(group):
+        if frame % drift_period_for(SIGNALS[key].rank - 1) == 0:
+            return SIGNAL_COLORS[key]
+    return BLACK
+
+
+def _live(signals: tuple[str, ...], clock: ModeTiming, phase: int = 0) -> str:
+    """live: every signal on its own clock, recomputed every push.
+
+    Where `drift` keeps a shared frame grid, this gives each signal a real
+    independent cadence - its authored cycle length, unquantised - and asks,
+    at the moment of each push, what every LED should be showing right now.
+    The answer is a one-line program, so the write is as small as the format
+    allows.
+
+    This is the layout that does what a single static program provably cannot,
+    and it pays for it with a device write per tick. `push_ms` is the dial: at
+    the 700ms default it is roughly one write per second.
+    """
+
+    demand = signals_in_tier(signals, TIER_DEMAND) or signals
+    ambient = signals_in_tier(signals, TIER_AMBIENT) or signals
+    now = phase * clock.push_ms
+    front = _live_pick(demand, now)
+    back = _live_pick(ambient, now)
+    return _loop(
+        [
+            f"0:{front} {clock.push_ms}ms {clock.easing}; "
+            f"1:{back} {clock.push_ms}ms {clock.easing}"
+        ]
+    )
+
+
+# Each signal's own cycle length in `live`, in milliseconds. These are the
+# authored cadences from the device's own animations, so a signal keeps the
+# rhythm it has when it is alone.
+LIVE_CYCLE_MS = {
+    SIGNAL_ERROR: 1120,
+    SIGNAL_ASK: 1600,
+    SIGNAL_DONE: 790,
+    SIGNAL_BUSY: 1800,
+}
+
+
+def _live_pick(group: tuple[str, ...], now_ms: int) -> str:
+    """Whichever signal in `group` is inside the lit part of its own cycle."""
+
+    for key in group:
+        cycle = LIVE_CYCLE_MS.get(key, 1200)
+        if (now_ms % cycle) < cycle // 2:
+            return SIGNAL_COLORS[key]
+    return BLACK
+
+
+_BUILDERS = {
+    MULTI_SIGNAL_ROUND_ROBIN: _rotation,
+    MULTI_SIGNAL_SPLIT: _split,
+    MULTI_SIGNAL_PAIRED: _paired,
+    MULTI_SIGNAL_ORBIT: _orbit,
+    MULTI_SIGNAL_DEPTH: _depth,
+    MULTI_SIGNAL_BEACON: _beacon,
+    MULTI_SIGNAL_TIDE: _tide,
+    MULTI_SIGNAL_DRIFT: _drift,
+    MULTI_SIGNAL_LIVE: _live,
+}
+
+_BREATHING = {
+    MULTI_SIGNAL_ROUND_ROBIN: _breathe_rotation,
+    MULTI_SIGNAL_SPLIT: _breathe_split,
+    MULTI_SIGNAL_PAIRED: _breathe_paired,
+    MULTI_SIGNAL_BEACON: _breathe_beacon,
+}
+
+
+# --- arrivals --------------------------------------------------------------
+
+# How many times a newly-arrived signal plays its own animation before folding
+# into the composition. Keyed by tier, not by name: something asking you to act
+# earns a second pass, something merely reporting does not.
+# Every arrival plays exactly once. A second pass reads as the signal having
+# *started* rather than as an announcement, and at these lengths one is plenty.
+ARRIVAL_REPEATS = {TIER_DEMAND: 1, TIER_AMBIENT: 1}
+
+# How long an arrival breath takes to rise and fall. Demand-tier signals get a
+# longer one - not louder, just held a beat more, which is the difference
+# between "look at this" and "for your information".
+ARRIVAL_BREATH_MS = {TIER_DEMAND: 2600, TIER_AMBIENT: 1800}
+
+# Where an arrival sits between its tier level and the demand level.
+#
+# An announcement has to be noticed, so playing an ambient signal at its
+# ambient level would defeat the point - `busy` lives at 15-28% and would
+# announce itself at a brightness the eye is trained to ignore. Playing it at
+# full contradicts the tier system just as badly, and on the front LED lands
+# squarely in the saturation that washes colour to white.
+#
+# Demand-tier arrivals use the demand level unchanged; ambient ones are lifted
+# halfway toward it. Loud enough to interrupt, quiet enough to still be the
+# thing it is.
+ARRIVAL_AMBIENT_LIFT = 0.5
+
+# A lone repetition of a very short animation is easy to miss entirely, so an
+# arrival is held at least this long regardless of how brief its cycle is.
+MIN_ARRIVAL_MS = 700
+
+# And no arrival may hold the device for longer than this, however long the
+# authored animation is. An arrival is an announcement, not a takeover.
+MAX_ARRIVAL_MS = 5000
+
+_DURATION = None
+
+
+def program_cycle_ms(program: str) -> int:
+    """How long one pass of `program` takes.
+
+    A line lasts as long as its longest delay-plus-duration, so the cycle is
+    the sum of those. Measured from the authored text rather than assumed,
+    because these programs can come from a user's own custom animation.
+    """
+
+    global _DURATION
+    if _DURATION is None:
+        import re
+
+        _DURATION = re.compile(r"(\d+(?:\.\d+)?)\s*(ms|s)")
+    total = 0.0
+    for line in program.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("repeat"):
+            continue
+        longest = 0.0
+        for segment in stripped.split(";"):
+            found = [
+                float(value) * (1000.0 if unit == "s" else 1.0)
+                for value, unit in _DURATION.findall(segment)
+            ]
+            # Two numbers on a segment are a duration and a delay; the segment
+            # finishes at their sum. One is just a duration. None is a single
+            # 60Hz frame.
+            longest = max(longest, sum(found) if found else 16.7)
+        total += longest
+    return int(round(total))
+
+
+@dataclass(frozen=True)
+class ArrivalPlan:
+    signal: str
+    program: str
+    duration_ms: int
+
+
+def arrival_level(signal: str, clock: ModeTiming) -> float:
+    """How bright a signal announces itself."""
+
+    if SIGNALS[signal].tier == TIER_DEMAND:
+        return clock.demand_level
+    return clock.ambient_level + (
+        (clock.demand_level - clock.ambient_level) * ARRIVAL_AMBIENT_LIFT
+    )
+
+
+def apply_led_correction(program: str, clock: ModeTiming) -> str:
+    """Put a finished program through the per-LED correction.
+
+    This is the single place the device's asymmetry is compensated for, and it
+    runs on *every* program - the composed layouts, the authored animation
+    played when one signal is live, and the arrival announcements. Correcting
+    inside each composer instead meant three separate paths, and the two that
+    were added later (arrivals, then solo animations) each silently missed it.
+
+    An indexed colour already names an LED, so it gets that LED's factors. A
+    whole-device colour is expanded into a position-indexed pair, which is the
+    only way to give two LEDs different values on one line.
+
+    Idempotent only in the sense that a no-op correction leaves the text
+    untouched; applying it twice with a real correction would square it, so it
+    belongs at the write boundary and nowhere else.
+    """
+
+    return _rewrite_colors(program, lambda color: color, clock)
+
+
+def _correct_colors(program: str, level: float, clock: ModeTiming) -> str:
+    """Scale every colour in a program to `level`.
+
+    Deliberately does *not* apply the per-LED correction: that happens once, at
+    the write boundary. Applying it here as well would square the gain, and the
+    two halves would not even square equally - only the signature arrivals pass
+    through this function, so breath arrivals would be corrected once and
+    signature arrivals twice.
+    """
+
+    import re
+
+    return re.sub(
+        r"(?<![\w:])(#[0-9A-Fa-f]{6})", lambda m: dim(m.group(1), level), program
+    )
+
+
+def _rewrite_colors(program: str, transform, clock: ModeTiming) -> str:
+    """Apply `transform` then the per-LED correction to every colour.
+
+    Correction has to be decided per *line*, because what a colour means
+    depends on how many share its line:
+
+      - `#RRGGBB`           one colour, the whole device. Expanded into a pair
+                            so the two LEDs can be given different values.
+      - `#RRGGBB #RRGGBB`   a colour list, already one colour per LED. Each
+                            gets its own position's factors and the line keeps
+                            its length.
+      - `0:#RRGGBB`         names an LED outright, so it gets that LED's
+                            factors. Expanding it would be a syntax error.
+
+    Expanding a colour list as if each entry were device-wide is what the
+    first version did, and it doubled the line: `A B` became `Af Ab Bf Bb`, of
+    which a 2-LED device shows only `Af Ab`. Every mode that puts a different
+    colour on each LED - tide, paired, orbit, depth, round-robin - therefore
+    showed the front colour on *both* LEDs and dropped the back one entirely,
+    collapsing exactly the front/back offset those modes exist to produce.
+    """
+
+    import re
+
+    pattern = re.compile(r"(\d:)?(#[0-9A-Fa-f]{6})")
+
+    # re.sub gives fresh match objects, so map by offset instead of identity.
+    def rewrite(line: str) -> str:
+        matches = list(pattern.finditer(line))
+        bare_offsets = [m.start() for m in matches if not m.group(1)]
+        as_list = len(bare_offsets) > 1
+        order = {off: i for i, off in enumerate(bare_offsets)}
+
+        def replace(match: re.Match[str]) -> str:
+            shifted = transform(match.group(2))
+            if match.group(1):
+                return f"{match.group(1)}{led(shifted, int(match.group(1)[0]), clock)}"
+            if as_list:
+                return led(shifted, order[match.start()], clock)
+            return device(shifted, clock)
+
+        return pattern.sub(replace, line)
+
+    return "\n".join(rewrite(line) for line in program.split("\n"))
+
+
+def arrival_plan(
+    signal: str,
+    native_program: str,
+    *,
+    timing: MultiSignalTiming | None = None,
+    mode: str = MULTI_SIGNAL_PRIORITY,
+    repeats: dict[str, int] | None = None,
+) -> ArrivalPlan | None:
+    """The program a just-arrived signal plays before joining the rotation.
+
+    Uses the DSL's bounded `repeat N`, which runs the animation N times and
+    then holds - so the device stops on its own and the host only has to write
+    the composition once the time is up.
+
+    Note the format allows exactly one `repeat` per program, so "play twice
+    then loop the composition" cannot be a single program. That is the whole
+    reason this is two writes and a timer rather than one clever program.
+    """
+
+    key = str(signal)
+    if key not in SIGNALS:
+        return None
+    if not native_program and SIGNALS[key].arrival_style == ARRIVAL_STYLE_SIGNATURE:
+        return None
+    signal = SIGNALS[key]
+    counts = repeats or ARRIVAL_REPEATS
+    times = max(1, int(counts.get(signal.tier, 1)))
+    clock = (timing or DEFAULT_TIMING).for_mode(mode)
+    level = arrival_level(key, clock)
+
+    if signal.arrival_style == ARRIVAL_STYLE_BREATH:
+        swell = ARRIVAL_BREATH_MS.get(signal.tier, ARRIVAL_BREATH_MS[TIER_AMBIENT])
+        lines = ["off", f"{dim(signal.color, level)} {swell}ms pulse"]
+    else:
+        lines = [
+            _correct_colors(line, level, clock)
+            for line in _arrival_gesture(native_program)
+        ]
+    if not lines:
+        return None
+    if lines and lines[-1].strip().startswith("repeat"):
+        lines[-1] = f"repeat {times}"
+    else:
+        lines.append(f"repeat {times}")
+    program = "\n".join(lines)
+    duration = max(MIN_ARRIVAL_MS, program_cycle_ms(program) * times)
+    return ArrivalPlan(
+        signal=key, program=program, duration_ms=min(MAX_ARRIVAL_MS, duration)
+    )
+
+
+def _arrival_gesture(program: str) -> list[str]:
+    """An animation reduced to the part a person would recognise.
+
+    Silence at either end of a looping animation is its *spacing*, not its
+    gesture. Leading darkness is periodicity - the two-minute purple heartbeat
+    is dark for 120 seconds and then breathes once - and trailing darkness is
+    the rest between repetitions, which as a one-shot announcement is just dead
+    air before the rotation resumes. Both are dropped.
+
+    Pauses *inside* the gesture stay: the beat between the error's two blinks
+    is what makes it a double blink rather than two blinks.
+    """
+
+    lines = [
+        line
+        for line in program.splitlines()
+        if line.strip() and not line.strip().startswith("repeat")
+    ]
+    while lines and lines[0].strip().startswith("off"):
+        lines.pop(0)
+    while lines and lines[-1].strip().startswith("off"):
+        lines.pop()
+    return lines
+
+
+def new_arrivals(previous, current) -> tuple[str, ...]:
+    """Every signal in `current` that was not in `previous`, most urgent first.
+
+    All of them, not just the winner. Several signals routinely appear in the
+    same snapshot - a run fails and another finishes in the same second - and
+    announcing only the most urgent means the quieter ones are never seen to
+    arrive at all. They are played in turn instead, so each still gets its
+    moment and the order still says which mattered most.
+    """
+
+    fresh = set(order_signals(current)) - set(order_signals(previous or ()))
+    return tuple(key for key in SIGNAL_ORDER if key in fresh)
+
+
+def newest_arrival(previous, current) -> str | None:
+    """The most urgent signal in `current` that was not in `previous`."""
+
+    arrivals = new_arrivals(previous, current)
+    return arrivals[0] if arrivals else None
+
+
+def arrival_queue(
+    previous,
+    current,
+    natives,
+    *,
+    timing: MultiSignalTiming | None = None,
+    mode: str = MULTI_SIGNAL_PRIORITY,
+) -> tuple[ArrivalPlan, ...]:
+    """A plan per newly-arrived signal, in the order they should be played."""
+
+    plans = []
+    for key in new_arrivals(previous, current):
+        plan = arrival_plan(
+            key, (natives or {}).get(key, ""), timing=timing, mode=mode
+        )
+        if plan is not None:
+            plans.append(plan)
+    return tuple(plans)
