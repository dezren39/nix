+def tempo_scale_for_active_count(active_count: int) -> float:
+    """Duration multiplier for `active_count` concurrently working sessions.
+
+    Smaller is faster. One session runs the animation at its authored speed so
+    the single-agent case looks exactly as it always has.
+    """
+
+    index = max(1, int(active_count or 1)) - 1
+    if index >= len(CONCURRENCY_TEMPO_SCALE):
+        return MIN_TEMPO_SCALE
+    return CONCURRENCY_TEMPO_SCALE[index]
+
+
+# Durations look like `760ms`, `0ms`, `1.6s`. Colours (`#00E5FF`) and bare
+# counts (`brightness 128`) carry no unit, so they are left alone.
+_DURATION_PATTERN = re.compile(r"(?<![\w.])(\d+(?:\.\d+)?)\s*(ms|s)(?![\w])")
+
+# Below roughly two display frames an animation stops reading as a pulse and
+# starts reading as flicker, so scaled durations are floored rather than
+# allowed to collapse.
+MIN_SCALED_DURATION_MS = 40.0
+
+
+def scale_program_durations(program: str, scale: float) -> str:
+    """Rescale every duration in an LED program, preserving its units.
+
+    This works on the authored program text rather than on a parsed model
+    because programs also arrive from user-authored files and custom
+    animations, where round-tripping through a parser would lose formatting.
+    """
+
+    if scale == 1.0:
+        return program
+
+    def rescale(match: re.Match[str]) -> str:
+        value = float(match.group(1))
+        unit = match.group(2)
+        milliseconds = value * (1000.0 if unit == "s" else 1.0)
+        scaled = milliseconds * scale
+        # A zero delay is a real instruction ("start immediately"), not a
+        # duration to stretch, so it must survive scaling untouched.
+        if milliseconds > 0.0:
+            scaled = max(scaled, MIN_SCALED_DURATION_MS)
+        if unit == "s":
+            seconds = scaled / 1000.0
+            text = f"{seconds:.3f}".rstrip("0").rstrip(".")
+            return f"{text or '0'}s"
+        return f"{int(round(scaled))}ms"
+
+    return _DURATION_PATTERN.sub(rescale, program)
+
+
+def mode_overrides_quiet_hours(mode: AgentMode) -> bool:
+    """Modes that stay visible even while Do Not Disturb is suppressing LEDs.
+
+    Only a failure qualifies. Quiet hours are exactly when nobody is watching
+    the terminal, so silencing the one signal that says a run is dead defeats
+    the point of latching it. Everything else - working, waiting, done - goes
+    dark as DND intends.
+    """
+
+    return mode is AgentMode.BLOCKED_ERROR
+
