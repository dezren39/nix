diff --git c/tests/test_led_signals.py i/tests/test_led_signals.py
new file mode 100644
index 0000000..68ffc4a
--- /dev/null
+++ i/tests/test_led_signals.py
@@ -0,0 +1,256 @@
+"""Tests for the error/concurrency LED signals.
+
+These cover the three behaviours that were previously impossible to express:
+a failure that is visually distinct from a permission prompt, a failure that
+outlives the single refresh it was reported in, and an animation that reflects
+how many sessions are actually running.
+"""
+
+from __future__ import annotations
+
+import re
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from sidepulse.error_latch import SessionErrorLatch
+from sidepulse.led_status import (
+    CONCURRENCY_TEMPO_SCALE,
+    MIN_SCALED_DURATION_MS,
+    LedDisplayState,
+    display_state_for_mode,
+    program_for_display_state,
+    mode_overrides_quiet_hours,
+    scale_program_durations,
+    tempo_scale_for_active_count,
+)
+from sidepulse.models import AgentMode
+from sidepulse.settings import AgentMonitorSettings
+
+BASE_TIME = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def status(
+    agent_id: str,
+    mode: AgentMode,
+    *,
+    offset_seconds: float = 0.0,
+    message: str | None = None,
+):
+    from sidepulse.models import AgentStatus
+
+    return AgentStatus(
+        provider="opencode",
+        agent_id=agent_id,
+        display_name=agent_id,
+        mode=mode,
+        updated_at=BASE_TIME + timedelta(seconds=offset_seconds),
+        event_name="StopFailure" if mode is AgentMode.BLOCKED_ERROR else "Stop",
+        message=message,
+    )
+
+
+def durations_ms(program: str) -> list[float]:
+    found = []
+    for value, unit in re.findall(r"(?<![\w.])(\d+(?:\.\d+)?)\s*(ms|s)(?![\w])", program):
+        found.append(float(value) * (1000.0 if unit == "s" else 1.0))
+    return found
+
+
+# --- error is its own display state -----------------------------------------
+
+
+def test_blocked_error_no_longer_collapses_into_ask():
+    assert display_state_for_mode(AgentMode.BLOCKED_ERROR) is LedDisplayState.ERROR
+    assert display_state_for_mode(AgentMode.WAITING_FOR_INPUT) is LedDisplayState.ASK
+
+
+def test_error_and_ask_render_different_programs():
+    error = program_for_display_state(LedDisplayState.ERROR, led_count=2)
+    ask = program_for_display_state(LedDisplayState.ASK, led_count=2)
+    assert error != ask
+    assert "#FF0010" in error
+
+
+# --- concurrency drives tempo -----------------------------------------------
+
+
+def test_single_session_runs_at_authored_speed():
+    assert tempo_scale_for_active_count(1) == 1.0
+    # Zero and None-ish counts must not accelerate anything.
+    assert tempo_scale_for_active_count(0) == 1.0
+
+
+def test_tempo_accelerates_then_clamps():
+    scales = [tempo_scale_for_active_count(n) for n in range(1, 9)]
+    assert scales[:len(CONCURRENCY_TEMPO_SCALE)] == list(CONCURRENCY_TEMPO_SCALE)
+    # Monotonically faster, never inverting.
+    assert all(later <= earlier for earlier, later in zip(scales, scales[1:]))
+    # And it stops accelerating rather than running away.
+    assert scales[-1] == CONCURRENCY_TEMPO_SCALE[-1]
+
+
+def test_more_sessions_produce_a_strictly_faster_working_program():
+    one = program_for_display_state(LedDisplayState.WORKING, led_count=2, active_count=1)
+    many = program_for_display_state(LedDisplayState.WORKING, led_count=2, active_count=5)
+    assert one != many
+    slow, fast = durations_ms(one), durations_ms(many)
+    assert len(slow) == len(fast)
+    # Every non-zero duration shrinks; zero delays stay pinned at zero.
+    for before, after in zip(slow, fast):
+        if before == 0.0:
+            assert after == 0.0
+        else:
+            assert after < before
+
+
+def test_error_program_ignores_session_count():
+    """An alarm must not change meaning because the machine got busy."""
+    quiet = program_for_display_state(LedDisplayState.ERROR, led_count=2, active_count=1)
+    busy = program_for_display_state(LedDisplayState.ERROR, led_count=2, active_count=8)
+    assert quiet == busy
+
+
+# --- duration rescaling -----------------------------------------------------
+
+
+def test_scale_preserves_units_and_zero_delays():
+    scaled = scale_program_durations("off 320ms cosine\n0:#00E5FF 760ms pulse 0ms", 0.5)
+    assert "160ms" in scaled
+    assert "380ms" in scaled
+    assert "0ms" in scaled
+
+
+def test_scale_handles_second_units():
+    assert "0.8s" in scale_program_durations("#FF3A00 1.6s pulse", 0.5)
+
+
+def test_scale_floors_at_a_visible_duration():
+    scaled = scale_program_durations("off 100ms", 0.001)
+    assert durations_ms(scaled) == [MIN_SCALED_DURATION_MS]
+
+
+def test_identity_scale_is_a_noop():
+    program = "off 320ms cosine\n0:#00E5FF 760ms pulse 0ms\nrepeat"
+    assert scale_program_durations(program, 1.0) == program
+
+
+# --- the latch --------------------------------------------------------------
+
+
+def test_error_survives_the_session_going_idle_again():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    assert latch.active
+
+    # This is the exact sequence that used to erase the failure.
+    latch.update([status("a", AgentMode.IDLE_READY, offset_seconds=1)])
+    assert latch.active, "a failure must not be erased by the next snapshot"
+
+
+def test_closing_the_session_clears_it():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.update([])
+    assert not latch.active
+
+
+def test_acknowledge_clears_and_does_not_immediately_relatch():
+    latch = SessionErrorLatch()
+    failing = status("a", AgentMode.BLOCKED_ERROR)
+    latch.update([failing])
+    assert latch.acknowledge() == 1
+    assert not latch.active
+
+    # A session stuck reporting the same error must stay quiet once handled.
+    latch.update([failing])
+    assert not latch.active
+
+
+def test_a_newer_failure_relatches_after_acknowledgement():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.acknowledge()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR, offset_seconds=30)])
+    assert latch.active, "a new failure after acknowledgement must light up again"
+
+
+def test_latch_tracks_several_sessions_independently():
+    latch = SessionErrorLatch()
+    latch.update([
+        status("a", AgentMode.BLOCKED_ERROR),
+        status("b", AgentMode.WORKING),
+        status("c", AgentMode.BLOCKED_ERROR),
+    ])
+    assert latch.count == 2
+    assert latch.agent_ids() == frozenset({"a", "c"})
+
+    latch.update([status("a", AgentMode.IDLE_READY, offset_seconds=5)])
+    assert latch.agent_ids() == frozenset({"a"}), "c is gone, a is latched"
+
+
+def test_first_seen_is_kept_across_repeated_failures():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.update([status("a", AgentMode.BLOCKED_ERROR, offset_seconds=10)])
+    entry = latch.entries()[0]
+    assert entry.first_seen == BASE_TIME
+    assert entry.last_seen == BASE_TIME + timedelta(seconds=10)
+
+
+def test_acknowledged_session_is_forgotten_once_it_closes():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.acknowledge()
+    latch.update([])
+    # Reusing the id later must behave like a fresh session, not a suppressed one.
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    assert latch.active
+
+
+# --- completion is its own signal -------------------------------------------
+
+
+def test_done_repeats_instead_of_firing_once():
+    """A single non-repeating solid was missable; this one holds."""
+    done = program_for_display_state(LedDisplayState.DONE, led_count=2)
+    assert done.strip().splitlines()[-1] == "repeat"
+    assert "#00FF66" in done
+
+
+def test_done_is_distinguishable_from_error():
+    done = program_for_display_state(LedDisplayState.DONE, led_count=2)
+    error = program_for_display_state(LedDisplayState.ERROR, led_count=2)
+    # Different colour and a different number of pulses per cycle, so the two
+    # are not just "a blinking light".
+    assert done != error
+    assert done.count("#00FF66") == 1, "success is one flash"
+    assert error.count("#FF0010") == 2, "error is a double blink"
+
+
+def test_done_ignores_session_count():
+    quiet = program_for_display_state(LedDisplayState.DONE, led_count=2, active_count=1)
+    busy = program_for_display_state(LedDisplayState.DONE, led_count=2, active_count=7)
+    assert quiet == busy
+
+
+# --- DND policy -------------------------------------------------------------
+
+
+def test_only_errors_survive_quiet_hours():
+    assert mode_overrides_quiet_hours(AgentMode.BLOCKED_ERROR) is True
+    for mode in (
+        AgentMode.WORKING,
+        AgentMode.TOOL_RUNNING,
+        AgentMode.LONG_TASK_PROGRESS,
+        AgentMode.WAITING_FOR_INPUT,
+        AgentMode.COMPLETED,
+        AgentMode.IDLE_READY,
+        AgentMode.UNKNOWN,
+    ):
+        assert mode_overrides_quiet_hours(mode) is False, mode
+
+
+def test_quiet_hours_override_is_not_configurable():
+    """DND suppression is policy, not a setting, so nothing can switch it off."""
+    assert not hasattr(AgentMonitorSettings(), "dnd_error_override")
