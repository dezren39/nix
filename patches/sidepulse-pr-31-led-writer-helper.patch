+class DeviceWriterFallbackTests(unittest.TestCase):
+    def setUp(self) -> None:
+        device_writer._grant_hint_shown = False
+        self.addCleanup(setattr, device_writer, "_grant_hint_shown", False)
+
+    @staticmethod
+    def denied(*_args, **_kwargs):
+        raise PermissionError(errno.EPERM, "Operation not permitted")
+
+    def test_in_process_write_stays_the_fast_path(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            target = Path(tmp) / "LEDS.LED"
+
+            with patch.object(device_writer, "write_text_via_helper") as helper:
+                device_writer.write_text_synced(target, "off")
+
+            helper.assert_not_called()
+            self.assertEqual(target.read_text(), "off")
+
+    def test_denied_write_falls_back_to_the_helper(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            target = Path(tmp) / "LEDS.LED"
+            written: list[tuple[Path, str]] = []
+
+            def fake_helper(path: Path, text: str) -> bool:
+                written.append((path, text))
+                path.write_text(text)
+                return True
+
+            with (
+                patch.object(device_writer, "write_text_in_process", self.denied),
+                patch.object(device_writer, "write_text_via_helper", fake_helper),
+            ):
+                device_writer.write_text_synced(target, "#FF00FF pulse")
+
+            self.assertEqual(written, [(target, "#FF00FF pulse")])
+            self.assertEqual(target.read_text(), "#FF00FF pulse")
+
+    def test_eacces_also_falls_back(self) -> None:
+        def refused(*_args, **_kwargs):
+            raise PermissionError(errno.EACCES, "Permission denied")
+
+        calls: list[int] = []
+        with tempfile.TemporaryDirectory() as tmp:
+            with (
+                patch.object(device_writer, "write_text_in_process", refused),
+                patch.object(
+                    device_writer,
+                    "write_text_via_helper",
+                    lambda *_args: bool(calls.append(1)) or True,
+                ),
+            ):
+                device_writer.write_text_synced(Path(tmp) / "LEDS.LED", "off")
+
+        self.assertEqual(len(calls), 1)
+
+    def test_other_errors_never_reach_the_helper(self) -> None:
+        def out_of_space(*_args, **_kwargs):
+            raise OSError(errno.ENOSPC, "No space left on device")
+
+        with tempfile.TemporaryDirectory() as tmp:
+            with (
+                patch.object(device_writer, "write_text_in_process", out_of_space),
+                patch.object(device_writer, "write_text_via_helper") as helper,
+                self.assertRaises(OSError) as caught,
+            ):
+                device_writer.write_text_synced(Path(tmp) / "LEDS.LED", "off")
+
+            helper.assert_not_called()
+            self.assertEqual(caught.exception.errno, errno.ENOSPC)
+
+    def test_absent_helper_surfaces_the_original_error(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            with (
+                patch.dict(os.environ, {LED_WRITER_PATH_ENV: str(Path(tmp) / "absent")}),
+                patch.object(device_writer, "write_text_in_process", self.denied),
+                self.assertRaises(PermissionError) as caught,
+            ):
+                device_writer.write_text_synced(Path(tmp) / "LEDS.LED", "off")
+
+            self.assertEqual(caught.exception.errno, errno.EPERM)
+
+    def test_denied_helper_surfaces_the_original_error_and_reports_once(self) -> None:
+        def deny(*_args, **_kwargs):
+            raise LedWriterFailed(LED_WRITER_EXIT_DENIED, "open: Operation not permitted")
+
+        with tempfile.TemporaryDirectory() as tmp:
+            with (
+                patch.object(device_writer, "write_text_in_process", self.denied),
+                patch("sidepulse.led_writer_launch.run_led_writer", deny),
+                patch.object(device_writer, "report_led_writer_denied") as report,
+                self.assertRaises(PermissionError),
+            ):
+                device_writer.write_text_synced(Path(tmp) / "LEDS.LED", "off")
+
+            report.assert_called_once_with()
+
+    def test_grant_hint_is_printed_once_per_process(self) -> None:
+        stream = io.StringIO()
+
+        with redirect_stderr(stream):
+            device_writer.report_led_writer_denied()
+            device_writer.report_led_writer_denied()
+            device_writer.report_led_writer_denied()
+
+        rendered = stream.getvalue()
+        self.assertEqual(rendered.count("Removable Volumes"), 1)
+        self.assertIn(LED_WRITER_BINARY_NAME, rendered)
+
+
+if __name__ == "__main__":
+    unittest.main()
