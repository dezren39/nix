index 0000000..2f6b336
--- /dev/null
+++ b/tests/test_led_writer.py
@@ -0,0 +1,365 @@
+"""Tests for the fixed-path native LED writer helper.
+
+The helper exists so a Removable Volumes TCC grant can outlive interpreter
+rebuilds. Two properties matter more than the write itself and are pinned
+here: recompiling only when the source actually changes (a rebuild changes the
+code directory hash and revokes the grant), and never regressing the
+in-process write when the helper is absent or denied.
+"""
+
+from __future__ import annotations
+
+import errno
+import hashlib
+import io
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from contextlib import redirect_stderr
+from importlib.resources import as_file
+from pathlib import Path
+from unittest.mock import patch
+
+from sidepulse import device_writer
+from sidepulse.led_writer_launch import (
+    LED_WRITER_BINARY_NAME,
+    LED_WRITER_EXIT_DENIED,
+    LED_WRITER_EXIT_INPUT,
+    LED_WRITER_EXIT_USAGE,
+    LED_WRITER_PATH_ENV,
+    LedWriterFailed,
+    LedWriterUnavailable,
+    default_led_writer_path,
+    install_led_writer,
+    led_writer_grant_hint,
+    led_writer_path,
+    led_writer_stamp_path,
+    packaged_led_writer_source,
+    run_led_writer,
+)
+
+CLANG = shutil.which("clang")
+
+
+def packaged_source_bytes() -> bytes:
+    with as_file(packaged_led_writer_source()) as path:
+        return Path(path).read_bytes()
+
+
+class LedWriterPathTests(unittest.TestCase):
+    def test_default_path_is_stable_and_outside_the_nix_store(self) -> None:
+        path = default_led_writer_path(home=Path("/Users/alice"))
+
+        self.assertEqual(
+            path,
+            Path("/Users/alice/.local/share/sidepulse/led-writer") / LED_WRITER_BINARY_NAME,
+        )
+        self.assertNotIn("/nix/store/", str(path))
+
+    def test_environment_variable_overrides_the_helper_path(self) -> None:
+        with patch.dict(os.environ, {LED_WRITER_PATH_ENV: "~/custom/led-writer"}):
+            self.assertEqual(led_writer_path(), Path("~/custom/led-writer").expanduser())
+
+    def test_blank_environment_variable_falls_back_to_the_default(self) -> None:
+        with patch.dict(os.environ, {LED_WRITER_PATH_ENV: "   "}):
+            self.assertEqual(led_writer_path(), default_led_writer_path())
+
+    def test_grant_hint_names_the_exact_binary_to_authorise(self) -> None:
+        hint = led_writer_grant_hint(Path("/tmp/holder/SidePulse LED Writer"))
+
+        self.assertIn("Removable Volumes", hint)
+        self.assertIn("/tmp/holder/SidePulse LED Writer", hint)
+
+    def test_source_ships_as_a_package_resource(self) -> None:
+        self.assertIn(b"kTCCServiceSystemPolicyRemovableVolumes", packaged_source_bytes())
+
