+@unittest.skipIf(CLANG is None, "clang is unavailable")
+class LedWriterCompileTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.root = Path(self._tmp.name)
+        self.binary = self.root / "bin" / LED_WRITER_BINARY_NAME
+
+    def build(self) -> Path:
+        return install_led_writer(binary_path=self.binary).binary_path
+
+    def local_source(self, suffix: str = "") -> Path:
+        source = self.root / "led_writer.c"
+        source.write_bytes(packaged_source_bytes() + suffix.encode("utf-8"))
+        return source
+
+    def test_source_compiles_to_an_executable(self) -> None:
+        result = install_led_writer(binary_path=self.binary)
+
+        self.assertTrue(result.compiled)
+        self.assertTrue(result.changed)
+        self.assertTrue(self.binary.exists())
+        self.assertTrue(os.access(self.binary, os.X_OK))
+
+    def test_second_install_leaves_the_binary_untouched(self) -> None:
+        self.build()
+        before = self.binary.stat()
+        before_bytes = self.binary.read_bytes()
+
+        result = install_led_writer(binary_path=self.binary)
+
+        after = self.binary.stat()
+        self.assertFalse(result.compiled)
+        self.assertFalse(result.changed)
+        # Rebuilding would change the code directory hash and revoke the TCC
+        # grant that the fixed path exists to preserve.
+        self.assertEqual(before.st_mtime_ns, after.st_mtime_ns)
+        self.assertEqual(before.st_ino, after.st_ino)
+        self.assertEqual(before_bytes, self.binary.read_bytes())
+
+    def test_a_fresh_source_mtime_alone_does_not_force_a_rebuild(self) -> None:
+        self.build()
+        before = self.binary.stat().st_mtime_ns
+        source = self.local_source()
+        os.utime(source, None)
+
+        result = install_led_writer(binary_path=self.binary, source_path=source)
+
+        self.assertFalse(result.compiled)
+        self.assertEqual(before, self.binary.stat().st_mtime_ns)
+
+    def test_changed_source_triggers_a_rebuild(self) -> None:
+        self.build()
+        source = self.local_source("\n// cache buster\n")
+
+        result = install_led_writer(binary_path=self.binary, source_path=source)
+
+        self.assertTrue(result.compiled)
+        self.assertEqual(
+            led_writer_stamp_path(self.binary).read_text().strip(),
+            hashlib.sha256(source.read_bytes()).hexdigest(),
+        )
+
+    def test_dry_run_reports_without_building(self) -> None:
+        result = install_led_writer(binary_path=self.binary, dry_run=True)
+
+        self.assertTrue(result.dry_run)
+        self.assertTrue(result.changed)
+        self.assertFalse(self.binary.exists())
+
+    def test_helper_writes_a_new_program_file(self) -> None:
+        helper = self.build()
+        device = self.root / "device"
+        device.mkdir()
+        target = device / "LEDS.LED"
+
+        self.assertEqual(run_led_writer(target, "off\n#FF00FF pulse", binary_path=helper), target)
+        self.assertEqual(target.read_bytes(), b"off\n#FF00FF pulse")
+
+    def test_a_new_file_still_writes_when_the_directory_cannot_be_synced(self) -> None:
+        # A new file also gets its directory entry flushed, but that sync is
+        # best effort: an unreadable parent must not fail the write.
+        helper = self.build()
+        device = self.root / "write-only"
+        device.mkdir()
+        device.chmod(0o300)
+        self.addCleanup(device.chmod, 0o700)
+
+        run_led_writer(device / "LEDS.LED", "off", binary_path=helper)
+
+        device.chmod(0o700)
+        self.assertEqual((device / "LEDS.LED").read_text(), "off")
+
+    def test_helper_truncates_an_existing_program(self) -> None:
+        helper = self.build()
+        target = self.root / "LEDS.LED"
+        target.write_text("a much longer previous program")
+
+        run_led_writer(target, "off", binary_path=helper)
+
+        self.assertEqual(target.read_text(), "off")
+
+    def test_helper_reads_the_payload_from_stdin_not_argv(self) -> None:
+        helper = self.build()
+        target = self.root / "LEDS.LED"
+
+        completed = subprocess.run(
+            [str(helper), str(target)],
+            input=b"#00FF00 solid",
+            capture_output=True,
+        )
+
+        self.assertEqual(completed.returncode, 0)
+        self.assertEqual(target.read_bytes(), b"#00FF00 solid")
+
+    def test_helper_reports_a_denied_target(self) -> None:
+        helper = self.build()
+        locked = self.root / "locked"
+        locked.mkdir()
+        locked.chmod(0o500)
+        self.addCleanup(locked.chmod, 0o700)
+
+        with self.assertRaises(LedWriterFailed) as caught:
+            run_led_writer(locked / "LEDS.LED", "off", binary_path=helper)
+
+        failure = caught.exception
+        self.assertTrue(failure.denied)
+        self.assertEqual(failure.returncode, LED_WRITER_EXIT_DENIED)
+        self.assertIn("LEDS.LED", failure.stderr)
+        self.assertIn(f"errno={errno.EACCES}", failure.stderr)
+
+    def test_helper_reports_a_missing_directory_without_claiming_denial(self) -> None:
+        helper = self.build()
+
+        with self.assertRaises(LedWriterFailed) as caught:
+            run_led_writer(self.root / "absent" / "LEDS.LED", "off", binary_path=helper)
+
+        self.assertFalse(caught.exception.denied)
+        self.assertIn(f"errno={errno.ENOENT}", caught.exception.stderr)
+
+    def test_helper_rejects_a_missing_target_argument(self) -> None:
+        helper = self.build()
+
+        completed = subprocess.run([str(helper)], input=b"off", capture_output=True)
+
+        self.assertEqual(completed.returncode, LED_WRITER_EXIT_USAGE)
+        self.assertIn(b"usage:", completed.stderr)
+
+    def test_helper_refuses_an_absurd_payload(self) -> None:
+        helper = self.build()
+        target = self.root / "LEDS.LED"
+
+        completed = subprocess.run(
+            [str(helper), str(target)],
+            input=b"a" * (1024 * 1024),
+            capture_output=True,
+        )
+
+        self.assertEqual(completed.returncode, LED_WRITER_EXIT_INPUT)
+        self.assertIn(b"errno=", completed.stderr)
+
+
+class LedWriterRunnerTests(unittest.TestCase):
+    def test_missing_helper_raises_unavailable(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            with self.assertRaises(LedWriterUnavailable) as caught:
+                run_led_writer(
+                    Path(tmp) / "LEDS.LED",
+                    "off",
+                    binary_path=Path(tmp) / "absent-helper",
+                )
+
+        self.assertIn("absent-helper", str(caught.exception))
+
