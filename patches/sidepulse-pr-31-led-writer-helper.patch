diff --git a/src/sidepulse/led_writer_launch.py b/src/sidepulse/led_writer_launch.py
new file mode 100644
index 0000000..1470d21
--- /dev/null
+++ b/src/sidepulse/led_writer_launch.py
@@ -0,0 +1,270 @@
+"""Compile and install the fixed-path native LED writer helper.
+
+macOS gates `/Volumes/*` behind the `kTCCServiceSystemPolicyRemovableVolumes`
+TCC service. A launchd-spawned process has no responsible application, so it
+cannot raise the consent prompt and TCC denies it outright - the SidePulse Dot
+write fails with ``[Errno 1] Operation not permitted``.
+
+An explicit grant *is* honoured from launchd, but TCC keys grants to a binary
+path. SidePulse normally writes in-process, from an interpreter that lives in
+the Nix store at a hash-addressed path which changes on every rebuild, so the
+grant is invalidated within days. Wrapping the interpreter does not help
+either: the status-bar launcher `exec`s the interpreter, which replaces the
+process image, and attribution follows the final image.
+
+This module compiles ``resources/led_writer.c`` to a fixed path under the
+SidePulse data directory. The user grants Removable Volumes access to that path
+once; because the binary only changes when its own source changes, the grant
+survives interpreter and dependency rebuilds.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import subprocess
+from dataclasses import dataclass
+from importlib.resources import as_file, files
+from pathlib import Path
+
+from .sd_eject_guard_launch import default_user_data_dir
+
+LED_WRITER_DISPLAY_NAME = "SidePulse LED Writer"
+LED_WRITER_BINARY_NAME = LED_WRITER_DISPLAY_NAME
+LED_WRITER_DIR_NAME = "led-writer"
+LED_WRITER_SOURCE_NAME = "led_writer.c"
+LED_WRITER_PATH_ENV = "SIDEPULSE_LED_WRITER"
+LED_WRITER_TIMEOUT_SECONDS = 15.0
+
+# Exit codes agreed with resources/led_writer.c.
+LED_WRITER_EXIT_OK = 0
+LED_WRITER_EXIT_USAGE = 2
+LED_WRITER_EXIT_INPUT = 3
+LED_WRITER_EXIT_DENIED = 4
+LED_WRITER_EXIT_IO = 5
+
+
+class LedWriterInstallError(RuntimeError):
+    """Compiling or installing the helper failed."""
+
+
+class LedWriterUnavailable(RuntimeError):
+    """The helper is not installed, or could not be executed at all."""
+
+
+class LedWriterFailed(RuntimeError):
+    """The helper ran but refused the write."""
+
+    def __init__(self, returncode: int, stderr: str) -> None:
+        detail = stderr.strip() or f"exit status {returncode}"
+        super().__init__(detail)
+        self.returncode = returncode
+        self.stderr = stderr.strip()
+
+    @property
+    def denied(self) -> bool:
+        """True when the write was refused by TCC or by file permissions."""
+
+        return self.returncode == LED_WRITER_EXIT_DENIED
+
+
+@dataclass(frozen=True)
+class LedWriterResult:
+    binary_path: Path
+    compiled: bool
+    changed: bool = False
+    dry_run: bool = False
+
+
+def led_writer_path(home: Path | None = None) -> Path:
+    """The path the helper is invoked from.
+
+    ``SIDEPULSE_LED_WRITER`` overrides it, mirroring how
+    ``SIDEPULSE_MOUNT_ROOTS`` overrides device discovery, so tests and unusual
+    installs can point at their own build.
+    """
+
+    override = os.environ.get(LED_WRITER_PATH_ENV)
+    if override and override.strip():
+        return Path(override).expanduser()
+    return default_led_writer_path(home)
+
+
+def default_led_writer_path(home: Path | None = None) -> Path:
+    return (
+        default_user_data_dir(home)
+        / "sidepulse"
+        / LED_WRITER_DIR_NAME
+        / LED_WRITER_BINARY_NAME
+    )
+
+
+def packaged_led_writer_source():
+    return files("sidepulse.resources").joinpath(LED_WRITER_SOURCE_NAME)
+
+
+def led_writer_stamp_path(binary_path: Path) -> Path:
+    return binary_path.with_name(f"{binary_path.name}.source-sha256")
+
+
+def source_digest(source_path: Path) -> str:
+    return hashlib.sha256(source_path.read_bytes()).hexdigest()
+
+
+def binary_needs_compile(binary_path: Path, source_path: Path) -> bool:
+    """Decide whether the helper has to be rebuilt.
+
+    Recompiling rewrites the binary, which changes its code directory hash and
+    therefore invalidates the Removable Volumes grant the whole helper exists
+    to keep. So this has to stay conservative: rebuild only when the source
+    really changed.
+
+    The recorded source digest is authoritative. ``importlib.resources`` may
+    hand back a freshly extracted copy of the source whose mtime is always
+    "now", which would make an mtime comparison rebuild on every run; the
+    digest does not care. The mtime comparison is only the fallback for a
+    binary installed before the stamp existed.
+    """
+
+    if not binary_path.exists():
+        return True
+
+    stamp = led_writer_stamp_path(binary_path)
+    try:
+        recorded = stamp.read_text(encoding="utf-8").strip()
+    except OSError:
+        recorded = ""
+    if recorded:
+        try:
+            return recorded != source_digest(source_path)
+        except OSError:
+            return True
+
+    try:
+        return binary_path.stat().st_mtime < source_path.stat().st_mtime
+    except OSError:
+        return True
+
+
+def compile_led_writer(source_path: Path, binary_path: Path) -> None:
+    """Build the helper and move it into place atomically."""
+
+    tmp_binary = binary_path.with_name(f"{binary_path.name}.tmp")
+    try:
+        subprocess.run(
+            ["clang", "-O2", "-o", str(tmp_binary), str(source_path)],
+            check=True,
+        )
+    except FileNotFoundError as exc:
+        raise LedWriterInstallError(
+            "clang is required to build the LED writer helper; "
+            "install the Xcode command line tools"
+        ) from exc
+    tmp_binary.chmod(0o755)
+    tmp_binary.replace(binary_path)
+    write_source_stamp(binary_path, source_path)
+
+
+def write_source_stamp(binary_path: Path, source_path: Path) -> None:
+    stamp = led_writer_stamp_path(binary_path)
+    try:
+        stamp.write_text(f"{source_digest(source_path)}\n", encoding="utf-8")
+    except OSError:
+        # The stamp is an optimisation; without it the mtime comparison still
+        # works for a normal filesystem install.
+        pass
+
+
+def install_led_writer(
+    *,
+    binary_path: Path | None = None,
+    source_path: Path | None = None,
+    dry_run: bool = False,
+) -> LedWriterResult:
+    """Install the helper if it is missing or out of date.
+
+    Idempotent by design: an up-to-date binary is left byte-for-byte and
+    mtime-for-mtime alone, so repeated ``sidepulse setup`` runs never disturb
+    the Removable Volumes grant.
+    """
+
+    target = binary_path or led_writer_path()
+    source = source_path if source_path is not None else packaged_led_writer_source()
+    context = as_file(source) if not isinstance(source, Path) else _path_context(source)
+    with context as resolved_source:
+        needs_compile = binary_needs_compile(target, resolved_source)
+        if dry_run:
+            return LedWriterResult(
+                binary_path=target,
+                compiled=False,
+                changed=needs_compile,
+                dry_run=True,
+            )
+        if not needs_compile:
+            return LedWriterResult(binary_path=target, compiled=False, changed=False)
+
+        try:
+            target.parent.mkdir(parents=True, exist_ok=True)
+        except OSError as exc:
+            raise LedWriterInstallError(
+                f"cannot create {target.parent}: {exc}"
+            ) from exc
+        compile_led_writer(resolved_source, target)
+        target.chmod(0o755)
+    return LedWriterResult(binary_path=target, compiled=True, changed=True)
+
+
+def run_led_writer(target: Path, text: str, *, binary_path: Path | None = None) -> Path:
+    """Write ``text`` to ``target`` through the fixed-path helper.
+
+    The payload travels on stdin so LED programs never appear in the process
+    table.
+    """
+
+    helper = binary_path or led_writer_path()
+    if not helper.exists():
+        raise LedWriterUnavailable(
+            f"the {LED_WRITER_DISPLAY_NAME} helper is not installed at {helper}; "
+            "run `sidepulse setup` to build it"
+        )
+
+    try:
+        completed = subprocess.run(
+            [str(helper), str(target)],
+            input=text.encode("utf-8"),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=LED_WRITER_TIMEOUT_SECONDS,
+        )
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise LedWriterUnavailable(f"cannot run {helper}: {exc}") from exc
+
+    if completed.returncode != LED_WRITER_EXIT_OK:
+        raise LedWriterFailed(
+            completed.returncode,
+            completed.stderr.decode("utf-8", errors="replace"),
+        )
+    return target
+
+
+def led_writer_grant_hint(helper: Path | None = None) -> str:
+    """The one message worth showing when even the helper is denied."""
+
+    path = helper or led_writer_path()
+    return (
+        f"{LED_WRITER_DISPLAY_NAME}: macOS is blocking writes to the SidePulse "
+        "device. Open System Settings > Privacy & Security > Files and Folders, "
+        f'find "{LED_WRITER_BINARY_NAME}", and enable Removable Volumes. '
+        f"If it is not listed, add it manually: {path}"
+    )
+
+
+class _path_context:
+    def __init__(self, path: Path) -> None:
+        self.path = path
+
+    def __enter__(self) -> Path:
+        return self.path
+
+    def __exit__(self, *_exc: object) -> None:
+        return None
diff --git a/src/sidepulse/resources/led_writer.c b/src/sidepulse/resources/led_writer.c
new file mode 100644
index 0000000..f3bf5c7
--- /dev/null
+++ b/src/sidepulse/resources/led_writer.c
@@ -0,0 +1,211 @@
+// SidePulse LED Writer - write an LED program to a mounted SidePulse volume.
+//
+// SidePulse talks to SidePulse Pro / SidePulse Dot by writing LEDS.LED on the
+// device's FAT volume: the firmware snoops the FAT LBA writes, so the file
+// write *is* the protocol. macOS gates every path under /Volumes behind the
+// `kTCCServiceSystemPolicyRemovableVolumes` TCC service. A launchd-spawned
+// process has no responsible app and cannot show the consent prompt, so TCC
+// auto-denies it and open(2) fails with EPERM.
+//
+// Explicit grants *are* honoured from launchd, but TCC keys them to the
+// binary's path (and code identity). SidePulse normally issues the write from
+// the interpreter itself, which lives at /nix/store/<hash>/bin/python3.x and
+// changes on every rebuild, so a grant is invalidated within days. This helper
+// lives at a fixed path under the SidePulse data directory and only changes
+// when this source file changes, so a single grant keeps working.
+//
+// The payload is read from stdin, never from argv, so LED programs stay out of
+// the process table.
+//
+// Build: clang -O2 -o "SidePulse LED Writer" led_writer.c
+// Run:   printf 'off' | ./"SidePulse LED Writer" /Volumes/PulseDot/LEDS.LED
+//
+// Exit status:
+//   0  wrote the payload
+//   2  usage error (wrong argument count, empty path)
+//   3  could not read stdin, or the payload exceeded the size cap
+//   4  filesystem denied the write (EPERM / EACCES) - this is the TCC case
+//   5  any other filesystem error
+// Failures always print "<op> <path>: <strerror> (errno=<n>)" to stderr so the
+// caller can recover the real errno.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <libgen.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// LED programs are capped at 512 bytes by the device, and the only other
+// payload SidePulse writes is an empty keepalive file. 64 KiB leaves room to
+// spare while refusing to buffer anything absurd.
+#define MAX_PAYLOAD_BYTES (64 * 1024)
+#define INITIAL_BUFFER_BYTES 4096
+
+#define EXIT_OK 0
+#define EXIT_USAGE 2
+#define EXIT_INPUT 3
+#define EXIT_DENIED 4
+#define EXIT_IO 5
+
+#ifndef O_DIRECTORY
+#define O_DIRECTORY 0
+#endif
+
+static const char *k_program_name = "sidepulse-led-writer";
+
+static int report_errno(const char *operation, const char *path, int saved_errno) {
+    fprintf(stderr, "%s: %s %s: %s (errno=%d)\n", k_program_name, operation, path,
+            strerror(saved_errno), saved_errno);
+    if (saved_errno == EPERM || saved_errno == EACCES)
+        return EXIT_DENIED;
+    return EXIT_IO;
+}
+
+// Read the whole payload from stdin. Returns NULL and sets errno on failure;
+// an over-long payload reports EFBIG. The returned buffer may be NULL-sized
+// only when malloc fails, so a zero-length payload still yields a valid
+// pointer.
+static char *read_payload(size_t *out_length) {
+    size_t capacity = INITIAL_BUFFER_BYTES;
+    size_t length = 0;
+    char *buffer = malloc(capacity);
+    if (buffer == NULL)
+        return NULL;
+
+    for (;;) {
+        if (length == capacity) {
+            if (capacity > MAX_PAYLOAD_BYTES) {
+                free(buffer);
+                errno = EFBIG;
+                return NULL;
+            }
+            size_t next = capacity * 2;
+            if (next > (size_t)MAX_PAYLOAD_BYTES + 1)
+                next = (size_t)MAX_PAYLOAD_BYTES + 1;
+            if (next == capacity) {
+                free(buffer);
+                errno = EFBIG;
+                return NULL;
+            }
+            char *grown = realloc(buffer, next);
+            if (grown == NULL) {
+                free(buffer);
+                return NULL;
+            }
+            buffer = grown;
+            capacity = next;
+        }
+
+        ssize_t taken = read(STDIN_FILENO, buffer + length, capacity - length);
+        if (taken < 0) {
+            if (errno == EINTR)
+                continue;
+            free(buffer);
+            return NULL;
+        }
+        if (taken == 0)
+            break;
+        length += (size_t)taken;
+        if (length > MAX_PAYLOAD_BYTES) {
+            free(buffer);
+            errno = EFBIG;
+            return NULL;
+        }
+    }
+
+    *out_length = length;
+    return buffer;
+}
+
+static int write_all(int fd, const char *data, size_t length) {
+    size_t written = 0;
+    while (written < length) {
+        ssize_t taken = write(fd, data + written, length - written);
+        if (taken < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        if (taken == 0) {
+            errno = EIO;
+            return -1;
+        }
+        written += (size_t)taken;
+    }
+    return 0;
+}
+
+// Flush a brand-new file's directory entry. Best effort, exactly like the
+// Python `sync_directory` helper this mirrors: a filesystem that refuses must
+// not fail the write.
+static void sync_parent_directory(const char *path) {
+    char *copy = strdup(path);
+    if (copy == NULL)
+        return;
+    const char *directory = dirname(copy);
+    if (directory != NULL) {
+        int fd = open(directory, O_RDONLY | O_DIRECTORY);
+        if (fd < 0 && O_DIRECTORY != 0)
+            fd = open(directory, O_RDONLY);
+        if (fd >= 0) {
+            (void)fsync(fd);
+            (void)close(fd);
+        }
+    }
+    free(copy);
+}
+
+int main(int argc, char **argv) {
+    if (argc != 2 || argv[1][0] == '\0') {
+        fprintf(stderr, "usage: %s <target-path>   (payload is read from stdin)\n",
+                argc > 0 && argv[0] != NULL ? argv[0] : k_program_name);
+        return EXIT_USAGE;
+    }
+
+    const char *target = argv[1];
+    size_t length = 0;
+    char *payload = read_payload(&length);
+    if (payload == NULL) {
+        int saved = errno;
+        fprintf(stderr, "%s: read payload from stdin: %s (errno=%d)\n", k_program_name,
+                strerror(saved), saved);
+        return EXIT_INPUT;
+    }
+
+    struct stat existing;
+    int is_new = stat(target, &existing) != 0;
+
+    int fd = open(target, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0) {
+        int saved = errno;
+        free(payload);
+        return report_errno("open", target, saved);
+    }
+
+    if (write_all(fd, payload, length) != 0) {
+        int saved = errno;
+        (void)close(fd);
+        free(payload);
+        return report_errno("write", target, saved);
+    }
+    free(payload);
+
+    // Removable devices buffer writes, so the LED firmware may not see the
+    // program until the data reaches the disk. Syncing is best effort: the
+    // bytes are already handed to the OS, so a filesystem that refuses to sync
+    // must not fail the write.
+    (void)fsync(fd);
+
+    if (close(fd) != 0) {
+        int saved = errno;
+        return report_errno("close", target, saved);
+    }
+
+    if (is_new)
+        sync_parent_directory(target);
+
+    return EXIT_OK;
+}
