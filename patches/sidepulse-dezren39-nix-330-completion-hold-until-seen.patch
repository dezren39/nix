diff --git a/tests/test_completion_hold.py b/tests/test_completion_hold.py
new file mode 100644
index 0000000..688834d
--- /dev/null
+++ b/tests/test_completion_hold.py
@@ -0,0 +1,171 @@
+"""The completion signal is held until somebody is actually there to see it."""
+
+from __future__ import annotations
+
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from sidepulse.presence import (
+    DEFAULT_INPUT_GAP_SECONDS,
+    AttentionWatcher,
+    bundle_id_holds_attention,
+)
+
+GHOSTTY = "com.mitchellh.ghostty"
+BROWSER = "app.zen-browser.zen"
+
+
+class AttentionBundleTests(unittest.TestCase):
+    def test_terminals_and_editors_hold_attention(self):
+        for bundle_id in (GHOSTTY, "dev.zed.Zed", "com.microsoft.VSCode"):
+            self.assertTrue(bundle_id_holds_attention(bundle_id), bundle_id)
+
+    def test_jetbrains_and_todesktop_match_by_prefix(self):
+        # Cursor ships a generated ToDesktop id and JetBrains one per IDE, so
+        # neither can be enumerated ahead of time.
+        self.assertTrue(bundle_id_holds_attention("com.jetbrains.pycharm"))
+        self.assertTrue(bundle_id_holds_attention("com.todesktop.230313mzl4w4u92"))
+
+    def test_a_browser_does_not_hold_attention(self):
+        self.assertFalse(bundle_id_holds_attention(BROWSER))
+
+    def test_unknown_frontmost_app_does_not_hold_attention(self):
+        self.assertFalse(bundle_id_holds_attention(None))
+        self.assertFalse(bundle_id_holds_attention(""))
+
+    def test_extra_bundle_ids_extend_the_default_list(self):
+        self.assertTrue(
+            bundle_id_holds_attention("com.example.term", extra_bundle_ids=("com.example.term",))
+        )
+
+
+class AttentionWatcherTests(unittest.TestCase):
+    def setUp(self):
+        self.watcher = AttentionWatcher(sustained_seconds=2.5, gap_seconds=1.5)
+
+    def observe(self, now, idle=0.1, bundle_id=GHOSTTY):
+        return self.watcher.observe(now, idle_seconds=idle, bundle_id=bundle_id)
+
+    def test_a_single_sample_never_acknowledges(self):
+        # The entire point: one keystroke is not "reading the result".
+        self.assertFalse(self.observe(0.0))
+
+    def test_one_keystroke_then_an_empty_room_never_acknowledges(self):
+        # The case that makes the gap-below-sustain invariant load-bearing:
+        # the tally starts on a single event, and if nothing else arrives the
+        # silence must retire it before the sustain window can ever elapse.
+        self.assertFalse(self.observe(0.0, idle=0.0))
+        for tick in range(1, 120):
+            self.assertFalse(self.observe(float(tick), idle=float(tick)), tick)
+
+    def test_sustained_input_in_a_terminal_acknowledges(self):
+        self.assertFalse(self.observe(0.0))
+        self.assertFalse(self.observe(1.0))
+        self.assertFalse(self.observe(2.0))
+        self.assertTrue(self.observe(2.5))
+
+    def test_a_brief_touch_then_silence_does_not_acknowledge(self):
+        self.assertFalse(self.observe(0.0))
+        self.assertFalse(self.observe(1.0))
+        # Walked away: the last event is now older than the gap tolerance.
+        self.assertFalse(self.observe(10.0, idle=9.0))
+        # Coming back starts the clock over rather than resuming it.
+        self.assertFalse(self.observe(11.0))
+        self.assertFalse(self.observe(12.0))
+        self.assertTrue(self.observe(13.5))
+
+    def test_micro_pauses_between_keystrokes_do_not_reset(self):
+        # Typing is not a metronome; a beat of hesitation is still presence.
+        self.assertFalse(self.observe(0.0))
+        self.assertFalse(self.observe(1.2, idle=1.2))
+        self.assertFalse(self.observe(2.0, idle=0.8))
+        self.assertTrue(self.observe(2.6, idle=0.6))
+
+    def test_gap_tolerance_is_forced_below_the_sustain_window(self):
+        # A hand-edited settings file must not be able to invert the two and
+        # make a single keystroke count as sustained presence.
+        watcher = AttentionWatcher(sustained_seconds=2.0, gap_seconds=30.0)
+        self.assertLess(watcher.effective_gap_seconds, watcher.sustained_seconds)
+        self.assertFalse(watcher.observe(0.0, idle_seconds=0.0, bundle_id=GHOSTTY))
+        for tick in range(1, 60):
+            self.assertFalse(
+                watcher.observe(float(tick), idle_seconds=float(tick), bundle_id=GHOSTTY),
+                tick,
+            )
+
+    def test_typing_in_a_browser_does_not_acknowledge(self):
+        for tick in range(10):
+            self.assertFalse(self.observe(float(tick), bundle_id=BROWSER))
+
+    def test_leaving_the_terminal_resets_progress(self):
+        self.assertFalse(self.observe(0.0))
+        self.assertFalse(self.observe(1.0))
+        self.assertFalse(self.observe(2.0, bundle_id=BROWSER))
+        # Back in the terminal, but the browser detour cleared the tally.
+        self.assertFalse(self.observe(2.5))
+        self.assertTrue(self.observe(5.0, idle=1.0))
+
+    def test_unreadable_idle_time_never_acknowledges(self):
+        # A headless or permission-starved host must fall back to the timeout,
+        # never silently behave as though somebody were present.
+        for tick in range(10):
+            self.assertFalse(
+                self.watcher.observe(float(tick), idle_seconds=None, bundle_id=GHOSTTY)
+            )
+
+    def test_reset_clears_activity_already_underway(self):
+        self.assertFalse(self.observe(0.0))
+        self.assertFalse(self.observe(2.0))
+        self.watcher.reset()
+        # Without the reset the very next sample would acknowledge a result
+        # that had only just appeared.
+        self.assertFalse(self.observe(2.6))
+
+    def test_poll_interval_stays_under_the_gap_tolerance(self):
+        # A sample interval longer than the gap could step over a silence
+        # entirely and read an absent user as a continuously present one.
+        from sidepulse.completion import COMPLETION_HOLD_POLL_SECONDS
+
+        self.assertLess(COMPLETION_HOLD_POLL_SECONDS, DEFAULT_INPUT_GAP_SECONDS)
+
+
+class CompletionHoldSettingsTests(unittest.TestCase):
+    def load(self, data):
+        from sidepulse.settings import load_settings
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "settings.json"
+            path.write_text(json.dumps(data), encoding="utf-8")
+            return load_settings(path)
+
+    def test_hold_settings_round_trip(self):
+        from sidepulse.settings import AgentMonitorSettings
+
+        settings = AgentMonitorSettings(
+            completion_hold_enabled=False,
+            completion_hold_max_seconds=42.0,
+            completion_hold_sustained_input_seconds=1.5,
+            completion_hold_extra_bundle_ids=("com.example.term",),
+        )
+        restored = self.load(settings.to_dict())
+        self.assertFalse(restored.completion_hold_enabled)
+        self.assertEqual(restored.completion_hold_max_seconds, 42.0)
+        self.assertEqual(restored.completion_hold_sustained_input_seconds, 1.5)
+        self.assertEqual(restored.completion_hold_extra_bundle_ids, ("com.example.term",))
+
+    def test_missing_section_keeps_the_hold_on_by_default(self):
+        restored = self.load({})
+        self.assertTrue(restored.completion_hold_enabled)
+        self.assertEqual(restored.completion_hold_max_seconds, 300.0)
+
+    def test_malformed_bundle_id_entries_are_dropped(self):
+        restored = self.load(
+            {"completion_hold": {"extra_bundle_ids": ["ok", 3, None, "  ", " padded "]}}
+        )
+        self.assertEqual(restored.completion_hold_extra_bundle_ids, ("ok", "padded"))
+
+
+if __name__ == "__main__":
+    unittest.main()
