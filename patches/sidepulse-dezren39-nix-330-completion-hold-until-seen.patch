diff --git a/src/sidepulse/presence.py b/src/sidepulse/presence.py
new file mode 100644
index 0000000..93d1ab3
--- /dev/null
+++ b/src/sidepulse/presence.py
@@ -0,0 +1,220 @@
+"""Is the person actually back at the keyboard, in front of their work?
+
+The completion signal is the one LED state that exists purely to be *seen*.
+Working, waiting and failed all describe something the machine is doing right
+now; "done" describes something that already happened, so the only thing that
+should retire it is a human noticing. A fixed timeout cannot tell the
+difference between "you saw it" and "you were in another room", which is
+exactly the case where holding the signal matters most.
+
+Two questions decide it, and macOS answers both without asking the user for a
+single extra permission:
+
+``CGEventSourceSecondsSinceLastEventType``
+    Seconds since the last HID event. Covers keystrokes and mouse movement
+    alike, needs neither Accessibility nor Input Monitoring, and - unlike an
+    event tap - cannot drop events or wedge the input stream when the process
+    stalls.
+
+``NSWorkspace.frontmostApplication``
+    Which app owns the screen. Only the *application*, never the window or
+    tab: window titles of other processes require Screen Recording on macOS 15
+    and later, so "is the terminal in front" is the finest grain available for
+    free, and this module does not pretend otherwise.
+
+Both are read defensively. A headless test runner, a login window, or a
+sandbox without a window server makes these return nothing, and the caller
+must degrade to the plain timeout rather than hold the LEDs forever.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+# Terminals, editors and IDEs that host an agent session. Being frontmost in
+# one of these is what separates "went back to the work" from "opened a
+# browser": the completion belongs to a terminal, so acknowledging it anywhere
+# else is not acknowledgement.
+DEFAULT_ATTENTION_BUNDLE_IDS: frozenset[str] = frozenset(
+    {
+        # Terminals
+        "com.mitchellh.ghostty",
+        "com.apple.Terminal",
+        "com.googlecode.iterm2",
+        "org.alacritty",
+        "com.github.wez.wezterm",
+        "net.kovidgoyal.kitty",
+        "dev.warp.Warp-Stable",
+        "dev.warp.Warp-Preview",
+        "co.zeit.hyper",
+        "org.tabby",
+        "com.raphaelamorim.rio",
+        "io.alacritty",
+        # Editors and IDEs that run agents in an integrated terminal
+        "dev.zed.Zed",
+        "dev.zed.Zed-Preview",
+        "dev.zed.Zed-Dev",
+        "com.microsoft.VSCode",
+        "com.microsoft.VSCodeInsiders",
+        "com.vscodium",
+        "com.exafunction.windsurf",
+        "com.apple.dt.Xcode",
+        "org.gnu.Emacs",
+        "org.vim.MacVim",
+    }
+)
+
+# Cursor ships under a generated ToDesktop id and JetBrains ships one bundle
+# per IDE, so those are matched on a prefix rather than enumerated.
+DEFAULT_ATTENTION_BUNDLE_PREFIXES: tuple[str, ...] = (
+    "com.jetbrains.",
+    "com.google.android.studio",
+    "com.todesktop.",
+)
+
+# How long input has to keep arriving before it counts. A single keystroke, a
+# nudged trackpad or a notification stealing focus are all "a short moment";
+# they are not somebody sitting down to read what happened.
+DEFAULT_SUSTAINED_INPUT_SECONDS = 2.5
+
+# The longest silence tolerated inside one burst of activity, so that the
+# natural micro-pauses between keystrokes do not restart the tally.
+#
+# This *must* stay below `DEFAULT_SUSTAINED_INPUT_SECONDS`, and that is a
+# correctness constraint rather than a preference. If a silence longer than
+# the sustain window were tolerated, one keystroke followed by an empty room
+# would satisfy "sustained": the tally would start on that single event and
+# nothing afterwards would ever clear it. Keeping the gap shorter guarantees
+# that reaching the sustain threshold required at least one further event, so
+# the ceiling - not a stray keypress - is what retires an unwatched signal.
+# `AttentionWatcher` enforces this on every instance it is given.
+DEFAULT_INPUT_GAP_SECONDS = 1.5
+
+
+def frontmost_bundle_id() -> str | None:
+    """Bundle id of the frontmost application, or None if unknowable."""
+
+    try:
+        from AppKit import NSWorkspace
+    except Exception:
+        return None
+    try:
+        app = NSWorkspace.sharedWorkspace().frontmostApplication()
+    except Exception:
+        return None
+    if app is None:
+        return None
+    try:
+        bundle_id = app.bundleIdentifier()
+    except Exception:
+        return None
+    return str(bundle_id) if bundle_id else None
+
+
+def seconds_since_last_input() -> float | None:
+    """Seconds since the last keystroke or mouse movement, or None."""
+
+    try:
+        import Quartz
+    except Exception:
+        return None
+    try:
+        value = Quartz.CGEventSourceSecondsSinceLastEventType(
+            Quartz.kCGEventSourceStateHIDSystemState,
+            Quartz.kCGAnyInputEventType,
+        )
+    except Exception:
+        return None
+    if value is None:
+        return None
+    try:
+        seconds = float(value)
+    except (TypeError, ValueError):
+        return None
+    # A negative or absurd reading means the event source is not answering
+    # honestly; treat it as "no idea" rather than as "wide awake".
+    if seconds < 0.0:
+        return None
+    return seconds
+
+
+def bundle_id_holds_attention(
+    bundle_id: str | None,
+    *,
+    extra_bundle_ids: frozenset[str] | set[str] | tuple[str, ...] = (),
+) -> bool:
+    """Whether being frontmost in `bundle_id` counts as looking at the work."""
+
+    if not bundle_id:
+        return False
+    if bundle_id in DEFAULT_ATTENTION_BUNDLE_IDS or bundle_id in set(extra_bundle_ids):
+        return True
+    return bundle_id.startswith(DEFAULT_ATTENTION_BUNDLE_PREFIXES)
+
+
+@dataclass
+class AttentionWatcher:
+    """Tracks whether the user is *sustainedly* present in their terminal.
+
+    Sampled by the caller rather than driven by a thread so that the whole
+    thing stays pure and testable: `observe` takes the clock and the two
+    readings and returns a verdict, and nothing in here touches AppKit.
+    """
+
+    sustained_seconds: float = DEFAULT_SUSTAINED_INPUT_SECONDS
+    gap_seconds: float = DEFAULT_INPUT_GAP_SECONDS
+    _active_since: float | None = None
+
+    @property
+    def effective_gap_seconds(self) -> float:
+        """Gap tolerance, forced below the sustain window.
+
+        `sustained_seconds` is user-configurable, so a hand-edited settings
+        file could otherwise invert the relationship the whole design rests on
+        and make one keystroke count as sustained presence.
+        """
+
+        return min(self.gap_seconds, max(self.sustained_seconds * 0.5, 0.1))
+
+    def reset(self) -> None:
+        """Forget any activity so far. Called when a fresh hold begins.
+
+        Without this, typing that was already underway when a session finished
+        would acknowledge it instantly - which is the bug this whole module
+        exists to avoid.
+        """
+
+        self._active_since = None
+
+    def observe(
+        self,
+        now: float,
+        *,
+        idle_seconds: float | None,
+        bundle_id: str | None,
+        extra_bundle_ids: frozenset[str] | set[str] | tuple[str, ...] = (),
+    ) -> bool:
+        """Feed one sample; return True once attention has been sustained.
+
+        Returns False - never True - whenever a reading is unavailable. An
+        unknown answer must not be mistaken for a present user, because the
+        caller uses True to *stop* showing the completion.
+        """
+
+        if idle_seconds is None:
+            self._active_since = None
+            return False
+        if not bundle_id_holds_attention(bundle_id, extra_bundle_ids=extra_bundle_ids):
+            # Focus left the work. Whatever was accumulating was somebody
+            # answering a message, not reading the run that finished.
+            self._active_since = None
+            return False
+        if idle_seconds > self.effective_gap_seconds:
+            self._active_since = None
+            return False
+        if self._active_since is None:
+            # Start counting from now, not from the last event: the point is
+            # continued presence after we started watching.
+            self._active_since = now
+            return False
+        return (now - self._active_since) >= self.sustained_seconds
