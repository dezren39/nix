+def test_error_and_ask_render_differently_through_the_settings_path():
+    """End-to-end through the path status_bar actually takes."""
+    from sidepulse.led_status import program_for_agent_mode
+    from sidepulse.settings import AgentMonitorSettings
+
+    settings = AgentMonitorSettings()
+
+    def rendered(mode):
+        animation = settings.agent_animation(mode)
+        return program_for_agent_mode(
+            mode, led_count=2, animation_style=animation.style,
+            custom_program=animation.custom_program,
+        )
+
+    error = rendered(AgentMode.BLOCKED_ERROR)
+    ask = rendered(AgentMode.WAITING_FOR_INPUT)
+    done = rendered(AgentMode.COMPLETED)
+
+    assert "#FF0010" in error and "#FF3A00" not in error, "error must not be amber"
+    assert "#FF3A00" in ask
+    assert "#00FF66" in done
+    assert len({error, ask, done}) == 3
+
