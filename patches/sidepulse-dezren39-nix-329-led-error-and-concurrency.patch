+    from sidepulse.completion import CompletionWatcher
+
+    w = CompletionWatcher()
+    backlog = [
+        status(f"opencode:session:{i}", AgentMode.COMPLETED, session_id=str(i))
+        for i in range(12)
+    ]
+    assert w.newly_completed(backlog) == ()
+    assert w.newly_completed(backlog) == (), "still quiet on the next pass"
+
