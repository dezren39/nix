+def test_completion_is_visible_even_while_other_sessions_work():
+    """The whole point: COMPLETED loses to WORKING in the aggregate."""
+    from sidepulse.completion import CompletionWatcher
+    from sidepulse.models import MODE_PRIORITY
+
+    assert MODE_PRIORITY[AgentMode.COMPLETED] > MODE_PRIORITY[AgentMode.WORKING]
+    w = CompletionWatcher()
+    w.newly_completed([])  # prime
+    finished = w.newly_completed([
+        status("opencode:session:a", AgentMode.COMPLETED, session_id="a"),
+        status("opencode:session:b", AgentMode.WORKING, session_id="b"),
+    ])
+    assert finished == ("opencode:session:a",)
