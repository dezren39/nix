diff --git a/tests/test_led_signals.py b/tests/test_led_signals.py
new file mode 100644
index 0000000..850aa8c
--- /dev/null
+++ b/tests/test_led_signals.py
@@ -0,0 +1,579 @@
+"""Tests for the error/concurrency LED signals.
+
+These cover the three behaviours that were previously impossible to express:
+a failure that is visually distinct from a permission prompt, a failure that
+outlives the single refresh it was reported in, and an animation that reflects
+how many sessions are actually running.
+"""
+
+from __future__ import annotations
+
+import re
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from sidepulse.error_latch import SessionErrorLatch
+from sidepulse.led_status import (
+    CONCURRENCY_TEMPO_SCALE,
+    MIN_SCALED_DURATION_MS,
+    LedDisplayState,
+    display_state_for_mode,
+    program_for_display_state,
+    mode_overrides_quiet_hours,
+    scale_program_durations,
+    tempo_scale_for_active_count,
+)
+from sidepulse.models import AgentMode
+from sidepulse.settings import AgentMonitorSettings
+
+BASE_TIME = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def status(
+    agent_id: str,
+    mode: AgentMode,
+    *,
+    offset_seconds: float = 0.0,
+    message: str | None = None,
+    session_id: str | None = None,
+    parent_session_id: str | None = None,
+    prompted_at: float | None = None,
+):
+    from sidepulse.models import AgentStatus
+
+    return AgentStatus(
+        provider="opencode",
+        agent_id=agent_id,
+        display_name=agent_id,
+        mode=mode,
+        updated_at=BASE_TIME + timedelta(seconds=offset_seconds),
+        event_name="StopFailure" if mode is AgentMode.BLOCKED_ERROR else "Stop",
+        message=message,
+        session_id=session_id if session_id is not None else agent_id,
+        parent_session_id=parent_session_id,
+        last_user_prompt_at=(
+            None if prompted_at is None else BASE_TIME + timedelta(seconds=prompted_at)
+        ),
+    )
+
+
+def durations_ms(program: str) -> list[float]:
+    found = []
+    for value, unit in re.findall(r"(?<![\w.])(\d+(?:\.\d+)?)\s*(ms|s)(?![\w])", program):
+        found.append(float(value) * (1000.0 if unit == "s" else 1.0))
+    return found
+
+
+# --- error is its own display state -----------------------------------------
+
+
+def test_blocked_error_no_longer_collapses_into_ask():
+    assert display_state_for_mode(AgentMode.BLOCKED_ERROR) is LedDisplayState.ERROR
+    assert display_state_for_mode(AgentMode.WAITING_FOR_INPUT) is LedDisplayState.ASK
+
+
+def test_error_and_ask_render_different_programs():
+    error = program_for_display_state(LedDisplayState.ERROR, led_count=2)
+    ask = program_for_display_state(LedDisplayState.ASK, led_count=2)
+    assert error != ask
+    assert "#FF0010" in error
+
+
+# --- concurrency drives tempo -----------------------------------------------
+
+
+def test_single_session_runs_at_authored_speed():
+    assert tempo_scale_for_active_count(1) == 1.0
+    # Zero and None-ish counts must not accelerate anything.
+    assert tempo_scale_for_active_count(0) == 1.0
+
+
+def test_tempo_accelerates_then_clamps():
+    scales = [tempo_scale_for_active_count(n) for n in range(1, 9)]
+    assert scales[:len(CONCURRENCY_TEMPO_SCALE)] == list(CONCURRENCY_TEMPO_SCALE)
+    # Monotonically faster, never inverting.
+    assert all(later <= earlier for earlier, later in zip(scales, scales[1:]))
+    # And it stops accelerating rather than running away.
+    assert scales[-1] == CONCURRENCY_TEMPO_SCALE[-1]
+
