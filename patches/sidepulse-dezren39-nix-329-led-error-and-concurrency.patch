+def test_more_sessions_produce_a_strictly_faster_working_program():
+    one = program_for_display_state(LedDisplayState.WORKING, led_count=2, active_count=1)
+    many = program_for_display_state(LedDisplayState.WORKING, led_count=2, active_count=5)
+    assert one != many
+    slow, fast = durations_ms(one), durations_ms(many)
+    assert len(slow) == len(fast)
+    # Every non-zero duration shrinks; zero delays stay pinned at zero.
+    for before, after in zip(slow, fast):
+        if before == 0.0:
+            assert after == 0.0
+        else:
+            assert after < before
+
