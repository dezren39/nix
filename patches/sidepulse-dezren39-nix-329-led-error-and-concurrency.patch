+        session_id: input?.sessionID,
+        agent_id: agentIdFor(input?.sessionID),
+        parent_session_id: parentOf(input?.sessionID),
+        cwd,
+        tool_name: input?.tool,
+        timestamp: new Date().toISOString(),
+        ...ORIGIN,
