+def test_completion_is_seen_even_after_the_aggregate_demotes_it():
+    """The bug this pins.
+
+    snapshot_from_statuses moves finished rows into stale_statuses whenever any
+    top-level session is active, so a watcher reading only snapshot.statuses
+    fires exclusively when nothing else runs - the opposite of the intent.
+    """
+    from sidepulse.completion import CompletionWatcher
+
+    w = CompletionWatcher()
+    w.newly_completed([])  # prime
+
+    # What the status bar hands over: fresh (working) + stale (the completion).
+    fresh = (status("opencode:session:busy", AgentMode.WORKING, session_id="busy"),)
+    stale = (status("opencode:session:done", AgentMode.COMPLETED, session_id="done"),)
+    assert w.newly_completed(fresh + stale) == ("opencode:session:done",)
