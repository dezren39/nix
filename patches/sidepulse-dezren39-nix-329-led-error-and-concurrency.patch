+# --- the latch --------------------------------------------------------------
+
+
+def test_error_survives_the_session_going_idle_again():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    assert latch.active
+
+    # This is the exact sequence that used to erase the failure.
+    latch.update([status("a", AgentMode.IDLE_READY, offset_seconds=1)])
+    assert latch.active, "a failure must not be erased by the next snapshot"
+
+
+def test_closing_the_session_clears_it():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.update([])
+    assert not latch.active
+
+
+def test_acknowledge_clears_and_does_not_immediately_relatch():
+    latch = SessionErrorLatch()
+    failing = status("a", AgentMode.BLOCKED_ERROR)
+    latch.update([failing])
+    assert latch.acknowledge() == 1
+    assert not latch.active
+
+    # A session stuck reporting the same error must stay quiet once handled.
+    latch.update([failing])
+    assert not latch.active
+
+
+def test_a_newer_failure_relatches_after_acknowledgement():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.acknowledge()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR, offset_seconds=30)])
+    assert latch.active, "a new failure after acknowledgement must light up again"
+
+
+def test_latch_tracks_several_sessions_independently():
+    latch = SessionErrorLatch()
+    latch.update([
+        status("a", AgentMode.BLOCKED_ERROR),
+        status("b", AgentMode.WORKING),
+        status("c", AgentMode.BLOCKED_ERROR),
+    ])
+    assert latch.count == 2
+    assert latch.agent_ids() == frozenset({"a", "c"})
+
+    latch.update([status("a", AgentMode.IDLE_READY, offset_seconds=5)])
+    assert latch.agent_ids() == frozenset({"a"}), "c is gone, a is latched"
+
+
+def test_first_seen_is_kept_across_repeated_failures():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.update([status("a", AgentMode.BLOCKED_ERROR, offset_seconds=10)])
+    entry = latch.entries()[0]
+    assert entry.first_seen == BASE_TIME
+    assert entry.last_seen == BASE_TIME + timedelta(seconds=10)
+
+
+def test_acknowledged_session_is_forgotten_once_it_closes():
+    latch = SessionErrorLatch()
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    latch.acknowledge()
+    latch.update([])
+    # Reusing the id later must behave like a fresh session, not a suppressed one.
+    latch.update([status("a", AgentMode.BLOCKED_ERROR)])
+    assert latch.active
