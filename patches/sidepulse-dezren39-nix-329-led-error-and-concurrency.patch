diff --git a/src/sidepulse/completion.py b/src/sidepulse/completion.py
new file mode 100644
index 0000000..5980bc8
--- /dev/null
+++ b/src/sidepulse/completion.py
@@ -0,0 +1,82 @@
+"""Announce a primary session finishing, rather than waiting for silence.
+
+``COMPLETED`` sits at priority 6 in ``MODE_PRIORITY``, below ``WORKING`` at 5.
+That is correct for a steady-state display - while anything is still running,
+"working" is the honest summary - but it means the green completion animation
+only ever appears once *everything* has stopped. With several sessions in
+flight, finishing one produces no signal at all, which is exactly the moment
+you most want to know about.
+
+So completion is treated as an event instead of a state: when a top-level
+session transitions into ``COMPLETED``, the device plays the success animation
+for a few seconds and then falls back to whatever the aggregate says. This
+mirrors how the battery preview and the lid animations already borrow the LEDs
+for a moment without owning them.
+
+Subagents are excluded deliberately. They finish constantly and in bursts, and
+a flash per subagent would turn the device into a strobe that says nothing
+about the work you actually asked for.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from .models import AgentMode, AgentStatus
+
+# Long enough to notice across a room, short enough that a burst of sessions
+# finishing together does not hold the LEDs hostage from live work.
+COMPLETION_PULSE_SECONDS = 4.0
+
+
+class CompletionWatcher:
+    """Detects top-level sessions newly entering COMPLETED."""
+
+    def __init__(self) -> None:
+        self._completed: set[str] = set()
+        self._primed = False
+
+    def newly_completed(self, statuses: Iterable[AgentStatus]) -> tuple[str, ...]:
+        """Return the agent ids that have just finished.
+
+        Only reports a session the first time it is seen completed; a session
+        sitting in COMPLETED across many snapshots fires once. Sessions that go
+        back to work are re-armed, so a follow-up turn can announce itself.
+
+        Callers must pass *both* the fresh and the stale rows. While any
+        top-level session is active, ``snapshot_from_statuses`` moves every
+        finished row out of ``statuses`` and into ``stale_statuses`` so the
+        aggregate reads "working" rather than "done". A completion demoted that
+        way is still a completion, and it is exactly the case this pulse exists
+        for - reading only the fresh rows makes it fire solely when nothing
+        else is running, which is when it is least needed.
+        """
+
+        rows = [row for row in statuses if ":agent:" not in row.agent_id]
+        present = {row.agent_id for row in rows}
+
+        # The status bar restarts with no memory while the monitor is already
+        # full of finished sessions. Announcing all of them at once would be a
+        # strobe that says nothing, so the first snapshot only sets a baseline.
+        if not self._primed:
+            self._primed = True
+            self._completed = {
+                row.agent_id for row in rows if row.mode is AgentMode.COMPLETED
+            }
+            return ()
+
+        fresh: list[str] = []
+        for row in rows:
+            if row.mode is AgentMode.COMPLETED:
+                if row.agent_id not in self._completed:
+                    self._completed.add(row.agent_id)
+                    fresh.append(row.agent_id)
+            else:
+                # Re-arm: this session is working again, so its next completion
+                # is a new event worth showing.
+                self._completed.discard(row.agent_id)
+
+        # Forget sessions that have left the monitor entirely, so the set does
+        # not grow without bound over a long-lived status bar.
+        self._completed &= present
+        return tuple(fresh)
diff --git a/src/sidepulse/error_latch.py b/src/sidepulse/error_latch.py
new file mode 100644
index 0000000..5eab2da
--- /dev/null
+++ b/src/sidepulse/error_latch.py
@@ -0,0 +1,163 @@
+"""Keep a failed session's error visible until it is dealt with.
+
+An agent that fails reports ``BLOCKED_ERROR`` once and then, usually within a
+second, reports itself idle again. ``aggregate_status`` only ever looks at the
+*current* mode of each session, so the error owned the LED for a single refresh
+and was then overwritten by cyan or off. In practice that is indistinguishable
+from never having failed: if you were not looking at the device in that exact
+second, the failure is gone.
+
+This module latches the error instead. Once a session has failed it stays
+latched until one of two things happens:
+
+* the session disappears from the monitor entirely - it was closed, or aged
+  out via ``idle_timeout_seconds`` / ``recent_session_retention_seconds``;
+* a human prompts the session again, which is the everyday "handled" case; or
+* the user acknowledges it from the menu.
+
+The prompt rule is what makes a failed *subagent* tractable. A subagent that
+dies never runs again and never receives input of its own, so on its own terms
+its error could never clear. But its parent will be prompted again, and that is
+the moment the human has demonstrably moved past the failure - so a prompt to a
+session also clears errors latched against everything descended from it.
+
+Acknowledgement records the timestamp of the error that was cleared rather than
+simply forgetting the session. A session that keeps reporting ``BLOCKED_ERROR``
+would otherwise re-latch on the very next refresh and the acknowledgement would
+appear to do nothing, while a genuinely *new* failure after an acknowledgement
+still has to light the device back up. Comparing against the acknowledged
+timestamp distinguishes those two cases.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime
+
+from .models import AgentMode, AgentStatus
+
+
+@dataclass(frozen=True)
+class LatchedError:
+    agent_id: str
+    display_name: str
+    first_seen: datetime
+    last_seen: datetime
+    message: str | None = None
+    session_id: str | None = None
+
+
+class SessionErrorLatch:
+    """Remembers which sessions are in a failed state."""
+
+    def __init__(self) -> None:
+        self._latched: dict[str, LatchedError] = {}
+        self._acknowledged_through: dict[str, datetime] = {}
+
+    def update(self, statuses: Iterable[AgentStatus]) -> None:
+        """Fold the current snapshot into the latch."""
+
+        rows = list(statuses)
+        present: dict[str, AgentStatus] = {status.agent_id: status for status in rows}
+        prompted = self._prompt_times(rows)
+
+        # A session that is no longer reported has been closed or aged out, so
+        # neither its error nor its acknowledgement is meaningful any more.
+        # Dropping the acknowledgement too keeps this dict from growing without
+        # bound across a long-running status bar.
+        for agent_id in tuple(self._latched):
+            if agent_id not in present:
+                del self._latched[agent_id]
+        for agent_id in tuple(self._acknowledged_through):
+            if agent_id not in present:
+                del self._acknowledged_through[agent_id]
+
+        for agent_id, status in present.items():
+            if status.mode is not AgentMode.BLOCKED_ERROR:
+                continue
+            acknowledged = self._acknowledged_through.get(agent_id)
+            if acknowledged is not None and status.updated_at <= acknowledged:
+                continue
+            existing = self._latched.get(agent_id)
+            self._latched[agent_id] = LatchedError(
+                agent_id=agent_id,
+                display_name=status.display_name,
+                first_seen=existing.first_seen if existing else status.updated_at,
+                last_seen=status.updated_at,
+                message=status.message or (existing.message if existing else None),
+                session_id=status.session_id,
+            )
+
+        # Finally, drop anything the human has already responded to. This runs
+        # after latching so that a failure arriving in the same snapshot as an
+        # older prompt is still shown.
+        for agent_id, entry in tuple(self._latched.items()):
+            responded_at = prompted.get(entry.session_id or "")
+            if responded_at is not None and responded_at > entry.last_seen:
+                del self._latched[agent_id]
+
+    def _prompt_times(self, rows: list[AgentStatus]) -> dict[str, datetime]:
+        """Latest human prompt per session, propagated down to descendants.
+
+        A prompt to a parent counts for its children, transitively, because a
+        subagent cannot be prompted directly. Depth is bounded by walking with
+        a seen-set, so a malformed cycle in the reported lineage cannot hang
+        the status bar.
+        """
+
+        direct: dict[str, datetime] = {}
+        parents: dict[str, str] = {}
+        for row in rows:
+            if not row.session_id:
+                continue
+            if row.last_user_prompt_at is not None:
+                current = direct.get(row.session_id)
+                if current is None or row.last_user_prompt_at > current:
+                    direct[row.session_id] = row.last_user_prompt_at
+            if row.parent_session_id:
+                parents[row.session_id] = row.parent_session_id
+
+        effective = dict(direct)
+        for session_id in parents:
+            best = effective.get(session_id)
+            seen = {session_id}
+            cursor = parents.get(session_id)
+            while cursor and cursor not in seen:
+                seen.add(cursor)
+                candidate = direct.get(cursor)
+                if candidate is not None and (best is None or candidate > best):
+                    best = candidate
+                cursor = parents.get(cursor)
+            if best is not None:
+                effective[session_id] = best
+        return effective
+
+    def acknowledge(self) -> int:
+        """Mark every latched error handled. Returns how many were cleared."""
+
+        cleared = len(self._latched)
+        for agent_id, entry in self._latched.items():
+            self._acknowledged_through[agent_id] = entry.last_seen
+        self._latched.clear()
+        return cleared
+
+    def forget(self, agent_id: str) -> None:
+        self._latched.pop(agent_id, None)
+        self._acknowledged_through.pop(agent_id, None)
+
+    @property
+    def active(self) -> bool:
+        return bool(self._latched)
+
+    @property
+    def count(self) -> int:
+        return len(self._latched)
+
+    def entries(self) -> tuple[LatchedError, ...]:
+        return tuple(
+            sorted(self._latched.values(), key=lambda entry: entry.first_seen)
+        )
+
+    def agent_ids(self) -> frozenset[str]:
+        return frozenset(self._latched)
