+def test_default_animation_table_sends_errors_to_red_not_amber():
+    """The bug this pins: display_state_for_mode only supplies the label.
+
+    status_bar resolves `settings.agent_animation(mode).style` and passes a
+    concrete style to program_for_agent_mode, which short-circuits the display
+    state entirely. Splitting ERROR from ASK in led_status alone left errors
+    rendering amber on the device while the log correctly said "Error".
+    """
+    from sidepulse.settings import (
+        AGENT_ANIMATION_AMBER_PULSE,
+        AGENT_ANIMATION_ERROR_RED,
+        AGENT_ANIMATION_SUCCESS_FLASH,
+        default_agent_animation_id,
+    )
+
+    assert default_agent_animation_id(AgentMode.BLOCKED_ERROR) == AGENT_ANIMATION_ERROR_RED
+    assert default_agent_animation_id(AgentMode.WAITING_FOR_INPUT) == AGENT_ANIMATION_AMBER_PULSE
+    assert default_agent_animation_id(AgentMode.COMPLETED) == AGENT_ANIMATION_SUCCESS_FLASH
+
