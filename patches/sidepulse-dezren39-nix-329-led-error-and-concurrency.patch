   return firstString(p.sessionID, p.sessionId, p.session_id, p.id, p.info?.id, p.session?.id)
 }}
 
+// Task-tool subagents are full OpenCode sessions carrying `info.parentID`, so
+// without this they arrive indistinguishable from top-level work and inflate
+// every "how much is running" signal. SidePulse already excludes rows keyed
+// `<provider>:agent:<id>`, and it derives that key from `agent_id`, so tagging
+// a child session is all it takes to have it treated as a subagent.
+//
+// `session.updated` is the reliable source rather than `session.created`: it
+// fires on every touch and always carries a complete `info`, so a subagent
+// resumed by task_id (which publishes no `created`) is still classified.
+const parentBySession = new Map()
+
+function rememberLineage(event) {{
+  const info = event?.properties?.info
+  if (!info || typeof info.id !== "string") return
+  const parent = typeof info.parentID === "string" && info.parentID.length > 0
+    ? info.parentID
+    : null
+  parentBySession.set(info.id, parent)
+}}
+
+function agentIdFor(sessionID) {{
+  // Unknown lineage is treated as top-level. Mislabelling a real session as a
+  // subagent would silently drop it from the aggregate, which is the worse
+  // failure of the two.
+  return parentBySession.get(sessionID) ? sessionID : undefined
+}}
+
+function parentOf(sessionID) {{
+  return parentBySession.get(sessionID) || undefined
+}}
+
+// A human actually typing is a different thing from the session becoming busy,
+// which happens constantly and for many reasons. SidePulse uses this to decide
+// that a failure has been seen and dealt with, so it must only fire for real
+// input. `message.updated` carries the authored message, and role is the
+// discriminator.
+function isUserPrompt(event) {{
+  if (event?.type !== "message.updated") return false
+  const info = event.properties?.info
+  return info?.role === "user" || info?.type === "user"
+}}
+
 function eventName(event) {{
   if (event?.type === "session.status") {{
     const status = event.properties?.status?.type ?? event.properties?.status
+    // The status union is idle | busy | retry. Retry is still work in flight,
+    // just degraded, so it stays busy rather than reading as finished.
     if (status === "idle") return "session.idle"
+    if (status === "busy" || status === "retry") return "session.status"
+    // An unrecognised status must not be guessed into "busy"; dropping it
+    // leaves the previous state standing, which is the conservative choice.
+    return undefined
   }}
   return event?.type
 }}
 
