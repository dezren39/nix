+        "T3_CODE_HOME",
+        "T3CODE_HOME",
+        "T3_MCP_BEARER_TOKEN",
+    ):
+        if str(env.get(key) or "").strip():
+            return True
+
+    bundle_id = str(env.get("__CFBundleIdentifier") or "").strip().lower()
+    if any(marker in bundle_id.replace("_", " ") for marker in ("t3 code", "t3-code", "t3code")):
+        return True
+
