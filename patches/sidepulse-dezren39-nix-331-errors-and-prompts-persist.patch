+class OpenCodeErrorSurfaceTests(unittest.TestCase):
+    """Every failure that stops a run has to reach the device."""
+
+    def plugin_source(self) -> str:
+        from pathlib import Path
+
+        from sidepulse.install import opencode_plugin_source
+
+        return opencode_plugin_source(Path("/tmp/sidepulse-test.jsonl"))
+
+    def test_both_session_runners_report_failures(self):
+        # OpenCode has two session pipelines; only one publishes
+        # `session.error`. Forwarding just that one loses every failure on the
+        # other.
+        source = self.plugin_source()
+        for event in ("session.error", "session.next.step.failed", "session.next.tool.failed"):
+            self.assertIn(event, source, event)
+
+    def test_assistant_message_errors_are_watched(self):
+        # StructuredOutputError never publishes `session.error` at all - it is
+        # only ever recorded on the assistant message - so a session.error-only
+        # subscriber reports a failed run as a clean finish.
+        source = self.plugin_source()
+        self.assertIn("assistantErrorEvent", source)
+        self.assertIn('info?.role !== "assistant"', source)
+
+    def test_deliberate_interrupts_are_not_failures(self):
+        # Pressing escape is an instruction. With failures now persisting until
+        # acknowledged, treating it as an error would light red on every
+        # interrupt.
+        self.assertIn("MessageAbortedError", self.plugin_source())
+
+    def test_recoverable_context_overflow_is_not_a_failure(self):
+        # Auto-compaction publishes session.error and then carries on; only the
+        # fatal variant also marks the assistant message.
+        source = self.plugin_source()
+        self.assertIn("SESSION_ERROR_IGNORED", source)
+        self.assertIn("ContextOverflowError", source)
+
+    def test_failure_events_map_to_blocked_error(self):
+        from sidepulse.collector import mode_for_event
+        from sidepulse.models import HookEvent
+        from sidepulse.providers import canonical_event_name
+
+        for raw_name in (
+            "session.error",
+            "session.next.step.failed",
+            "session.next.tool.failed",
+        ):
+            canonical = canonical_event_name(raw_name)
+            self.assertEqual(canonical, "StopFailure", raw_name)
+            record = HookEvent(
+                provider="opencode",
+                logged_at=NOW,
+                event_name=canonical,
+                raw={},
+                session_id="ses_1",
+            )
+            self.assertEqual(mode_for_event(record), AgentMode.BLOCKED_ERROR, raw_name)
+
