@@ -0,0 +1,392 @@
+"""Signals addressed to a person do not expire on a clock."""
+
+from __future__ import annotations
+
+import unittest
+from datetime import datetime, timedelta, timezone
+
+from sidepulse.collector import mode_awaits_a_human, status_is_stale
+from sidepulse.models import MODE_PRIORITY, AgentMode, AgentStatus
+
+NOW = datetime(2026, 1, 1, 12, 0, 0, tzinfo=timezone.utc)
+
+# Far past every timeout in the product: the idle timeout is an hour and the
+# recent-session retention is 48h.
+ANCIENT = NOW - timedelta(days=7)
+
+
+def row(mode: AgentMode, updated_at: datetime = ANCIENT) -> AgentStatus:
+    return AgentStatus(
+        provider="opencode",
+        agent_id="ses_1",
+        display_name="repo",
+        mode=mode,
+        event_name="x",
+        updated_at=updated_at,
+    )
+
+
+def is_stale(mode: AgentMode, updated_at: datetime = ANCIENT) -> bool:
+    return status_is_stale(
+        row(mode, updated_at),
+        NOW,
+        stale_after_seconds=3600.0,
+        tool_running_timeout_seconds=0.0,
+        completed_visible_seconds=1200.0,
+        idle_visible_seconds=0.0,
+    )
+
+
+class AwaitingHumanTests(unittest.TestCase):
+    def test_a_failure_never_goes_stale(self):
+        # A week-old dead run is still a dead run.
+        self.assertFalse(is_stale(AgentMode.BLOCKED_ERROR))
+
+    def test_a_permission_prompt_never_goes_stale(self):
+        self.assertFalse(is_stale(AgentMode.WAITING_FOR_INPUT))
+
+    def test_machine_states_still_expire(self):
+        # The timeout is right for these: an hour later they are simply untrue.
+        for mode in (
+            AgentMode.WORKING,
+            AgentMode.TOOL_RUNNING,
+            AgentMode.LONG_TASK_PROGRESS,
+            AgentMode.COMPLETED,
+            AgentMode.IDLE_READY,
+            AgentMode.UNKNOWN,
+        ):
+            self.assertTrue(is_stale(mode), mode)
+
+    def test_only_the_two_human_facing_modes_are_exempt(self):
+        exempt = {mode for mode in AgentMode if mode_awaits_a_human(mode)}
+        self.assertEqual(
+            exempt,
+            {AgentMode.BLOCKED_ERROR, AgentMode.WAITING_FOR_INPUT},
+        )
+
+    def test_fresh_rows_are_not_stale_either(self):
+        self.assertFalse(is_stale(AgentMode.WORKING, NOW))
+
+    def test_monitor_and_function_agree(self):
+        # Two independent copies of this rule exist; a fix to one that misses
+        # the other would leave the LEDs and the menu disagreeing.
+        from sidepulse.collector import AgentMonitor
+
+        monitor = AgentMonitor(
+            sources=(),
+            stale_after_seconds=3600.0,
+            completed_visible_seconds=1200.0,
+            idle_visible_seconds=0.0,
+        )
+        for mode in AgentMode:
+            self.assertEqual(
+                monitor.is_stale_status(row(mode), NOW),
+                is_stale(mode),
+                mode,
+            )
+
+
+class CompletionHoldPriorityTests(unittest.TestCase):
+    """A held completion must not sit on top of something more urgent."""
+
+    def test_the_hold_defers_to_modes_awaiting_a_human(self):
+        for mode in (AgentMode.BLOCKED_ERROR, AgentMode.WAITING_FOR_INPUT):
+            self.assertTrue(mode_awaits_a_human(mode), mode)
+
+    def test_the_hold_still_covers_ordinary_work(self):
+        # These are the modes the hold is *supposed* to override, which is the
+        # whole reason the completion signal exists.
+        for mode in (
+            AgentMode.WORKING,
+            AgentMode.TOOL_RUNNING,
+            AgentMode.LONG_TASK_PROGRESS,
+            AgentMode.IDLE_READY,
+            AgentMode.UNKNOWN,
+        ):
+            self.assertFalse(mode_awaits_a_human(mode), mode)
+
+    def test_mode_priority_cannot_express_this_exemption(self):
+        # Guards the comment in `led_mode_for_aggregate`: WORKING ranks above
+        # COMPLETED, so a priority comparison would suppress the completion
+        # signal in exactly the case it was built for. If this ever stops being
+        # true, that code can be simplified - but not before.
+        self.assertLess(
+            MODE_PRIORITY[AgentMode.WORKING],
+            MODE_PRIORITY[AgentMode.COMPLETED],
+        )
+
+
+class FailureSurvivesSilenceTests(unittest.TestCase):
+    """A run that died must not be redrawn as a run that finished."""
+
+    def transition(self, previous: AgentStatus, current: AgentStatus) -> bool:
+        from sidepulse.collector import should_ignore_status_transition
+
+        return should_ignore_status_transition(previous, current, set())
+
+    def status(self, mode: AgentMode, event: str, offset: int = 0) -> AgentStatus:
+        return AgentStatus(
+            provider="opencode",
+            agent_id="ses_1",
+            display_name="repo",
+            mode=mode,
+            event_name=event,
+            updated_at=NOW + timedelta(seconds=offset),
+        )
+
+    def setUp(self):
+        self.failed = self.status(AgentMode.BLOCKED_ERROR, "StopFailure")
+
+    def test_the_idle_that_follows_a_failure_does_not_erase_it(self):
+        # This is the real-world sequence: every harness reports the error and
+        # then immediately reports the session idle. Both land in one 15s
+        # sample, and before this the idle won and the failure was invisible.
+        for event in ("Stop", "SessionEnd"):
+            self.assertTrue(
+                self.transition(self.failed, self.status(AgentMode.COMPLETED, event, 1)),
+                event,
+            )
+
+    def test_a_session_restart_does_not_erase_a_failure(self):
+        self.assertTrue(
+            self.transition(self.failed, self.status(AgentMode.IDLE_READY, "SessionStart", 1))
+        )
+
+    def test_real_activity_clears_the_failure(self):
+        # Otherwise the row could never recover on its own.
+        for mode, event in (
+            (AgentMode.WORKING, "UserPromptSubmit"),
+            (AgentMode.TOOL_RUNNING, "PreToolUse"),
+            (AgentMode.WAITING_FOR_INPUT, "PermissionRequest"),
+        ):
+            self.assertFalse(
+                self.transition(self.failed, self.status(mode, event, 1)),
+                event,
+            )
+
+    def test_a_later_failure_replaces_an_earlier_one(self):
+        self.assertFalse(
+            self.transition(self.failed, self.status(AgentMode.BLOCKED_ERROR, "StopFailure", 1))
+        )
+
+    def test_an_ordinary_completion_is_untouched(self):
+        # The guard must be scoped to failures; a session that simply finishes
+        # still has to be able to report that it finished.
+        working = self.status(AgentMode.WORKING, "UserPromptSubmit")
+        self.assertFalse(
+            self.transition(working, self.status(AgentMode.COMPLETED, "Stop", 1))
+        )
+
+    def test_no_previous_status_is_not_a_failure(self):
+        from sidepulse.collector import failure_would_be_erased_by_silence
+
+        self.assertFalse(
+            failure_would_be_erased_by_silence(None, self.status(AgentMode.COMPLETED, "Stop"))
+        )
