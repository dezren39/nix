+class ClosedSessionTests(unittest.TestCase):
+    """A question nobody can answer any more must stop being asked.
+
+    Prompts and failures no longer expire on a clock, which is only safe while
+    the session is still there to answer to. These are the two ways it stops
+    being there.
+    """
+
+    def stale(self, status: AgentStatus) -> bool:
+        return status_is_stale(
+            status,
+            NOW,
+            stale_after_seconds=3600.0,
+            tool_running_timeout_seconds=0.0,
+            completed_visible_seconds=1200.0,
+            idle_visible_seconds=0.0,
+        )
+
+    def row(self, mode: AgentMode, pid: int | None) -> AgentStatus:
+        return AgentStatus(
+            provider="opencode",
+            agent_id="ses_1",
+            display_name="repo",
+            mode=mode,
+            event_name="PermissionRequest",
+            updated_at=ANCIENT,
+            session_id="ses_1",
+            agent_pid=pid,
+        )
+
+    def dead_pid(self) -> int:
+        import subprocess
+
+        process = subprocess.Popen(["/usr/bin/true"])
+        process.wait()
+        return process.pid
+
+    def test_a_closed_terminal_releases_the_prompt(self):
+        # The harness died mid-prompt and no further event is ever coming.
+        dead = self.dead_pid()
+        for mode in (AgentMode.WAITING_FOR_INPUT, AgentMode.BLOCKED_ERROR):
+            self.assertTrue(self.stale(self.row(mode, dead)), mode)
+
+    def test_a_live_session_still_persists_indefinitely(self):
+        import os
+
+        for mode in (AgentMode.WAITING_FOR_INPUT, AgentMode.BLOCKED_ERROR):
+            self.assertFalse(self.stale(self.row(mode, os.getpid())), mode)
+
+    def test_a_provider_without_a_pid_keeps_persisting(self):
+        # Hook-based providers run short-lived subprocesses, so their pid would
+        # describe the hook rather than the agent. Absent must not read as dead.
+        for mode in (AgentMode.WAITING_FOR_INPUT, AgentMode.BLOCKED_ERROR):
+            self.assertFalse(self.stale(self.row(mode, None)), mode)
+
+    def test_unknown_pid_counts_as_alive(self):
+        from sidepulse.collector import process_is_alive
+
+        self.assertTrue(process_is_alive(None))
+
+    def test_a_deleted_session_is_removed_not_completed(self):
+        from sidepulse.collector import StatusMetadata, mark_ignored_session
+        from sidepulse.models import HookEvent
+
+        statuses = {"opencode:session:ses_1": self.row(AgentMode.WAITING_FOR_INPUT, None)}
+        ignored: set[str] = set()
+        record = HookEvent(
+            provider="opencode",
+            logged_at=NOW,
+            event_name="SessionDeleted",
+            raw={},
+            session_id="ses_1",
+        )
+        self.assertTrue(
+            mark_ignored_session(record, StatusMetadata(), statuses, ignored)
+        )
+        self.assertEqual(statuses, {})
+        self.assertIn("opencode:session:ses_1", ignored)
+
+    def test_deleting_a_session_takes_its_subagents_with_it(self):
+        # Subagents never receive a deletion of their own, and one stuck
+        # waiting would hold the device amber for a session that is gone.
+        from sidepulse.collector import StatusMetadata, mark_ignored_session
+        from sidepulse.models import HookEvent
+
+        child = AgentStatus(
+            provider="opencode",
+            agent_id="opencode:agent:ses_2",
+            display_name="child",
+            mode=AgentMode.WAITING_FOR_INPUT,
+            event_name="PermissionRequest",
+            updated_at=ANCIENT,
+            session_id="ses_2",
+            parent_session_id="ses_1",
+        )
+        statuses = {
+            "opencode:session:ses_1": self.row(AgentMode.WAITING_FOR_INPUT, None),
+            "opencode:agent:ses_2": child,
+        }
+        record = HookEvent(
+            provider="opencode",
+            logged_at=NOW,
+            event_name="SessionDeleted",
+            raw={},
+            session_id="ses_1",
+        )
+        mark_ignored_session(record, StatusMetadata(), statuses, set())
+        self.assertEqual(statuses, {})
+
+    def test_deletion_is_mapped_distinctly_from_completion(self):
+        # "Removed" and "finished" must stay tellable apart: a failure survives
+        # a completion, but nothing survives deletion.
+        from sidepulse.providers import canonical_event_name
+
+        self.assertEqual(canonical_event_name("session.deleted"), "SessionDeleted")
+        self.assertNotEqual(
+            canonical_event_name("session.deleted"),
+            canonical_event_name("session.idle"),
+        )
+
+    def test_the_plugin_reports_a_pid_and_deletions(self):
+        from pathlib import Path
+
+        from sidepulse.install import opencode_plugin_source
+
+        source = opencode_plugin_source(Path("/tmp/sidepulse-test.jsonl"))
+        self.assertIn("AGENT_PID", source)
+        self.assertIn("agent_pid", source)
+        self.assertIn("session.deleted", source)
+
+    def test_pid_is_parsed_from_either_spelling(self):
+        from sidepulse.collector import _agent_pid_from_raw
+
+        self.assertEqual(_agent_pid_from_raw({"agent_pid": 42}), 42)
+        self.assertEqual(_agent_pid_from_raw({"agentPid": "42"}), 42)
+        self.assertIsNone(_agent_pid_from_raw({}))
+        self.assertIsNone(_agent_pid_from_raw({"agent_pid": 0}))
+        self.assertIsNone(_agent_pid_from_raw({"agent_pid": -1}))
+        # `True` is an int in Python; it is not a pid.
+        self.assertIsNone(_agent_pid_from_raw({"agent_pid": True}))
+
+
+if __name__ == "__main__":
+    unittest.main()
