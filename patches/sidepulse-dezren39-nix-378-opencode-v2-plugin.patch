+def opencode_v2_plugin_runner(
+    events: list[dict],
+    after: str = "",
+    parents: dict[str, str] | None = None,
+    prelude: str = "",
+) -> str:
+    """A node script that drives the generated plugin through a fake v2 `ctx`.
+
+    The fake event stream yields `events`, then blocks until cleanup, so the
+    plugin's own resubscribe loop is exercised without spinning. The stream only
+    asks for the next event once the previous one has been handled, so `drained`
+    resolving means every event has been written. `after` runs next, with the
+    registered hooks in `hooks.session` / `hooks.tool`. `parents` answers
+    `ctx.session.get` lineage lookups.
+    """
+
+    return (
+        'import plugin from "./sidepulse.mjs"\n'
+        + prelude
+        + f"const events = {json.dumps(events)}\n"
+        + f"const parents = {json.dumps(parents or {})}\n"
+        + """const hooks = { session: {}, tool: {} }
+let drained
+const drainedPromise = new Promise((resolve) => (drained = resolve))
+const ctx = {
+  location: { directory: "/tmp/project" },
+  event: {
+    async *subscribe({ signal }) {
+      for (const event of events) yield event
+      drained()
+      await new Promise((resolve) => signal.addEventListener("abort", resolve, { once: true }))
+    },
+  },
+  session: {
+    hook: async (name, fn) => {
+      hooks.session[name] = fn
+      return { dispose: async () => {} }
+    },
+    get: async ({ sessionID }) => ({ id: sessionID, parentID: parents[sessionID] }),
+  },
+  tool: {
+    hook: async (name, fn) => {
+      hooks.tool[name] = fn
+      return { dispose: async () => {} }
+    },
+  },
+}
+if (plugin.id !== "sidepulse" || typeof plugin.setup !== "function") process.exit(5)
+const cleanup = await plugin.setup(ctx)
+await drainedPromise
+"""
+        + after
+        + "await cleanup()\n"
+    )
+
+
+def opencode_v2_event(event_type: str, session_id: str, **data: object) -> dict:
+    return {
+        "id": f"evt_{event_type}_{session_id}",
+        "created": 0,
+        "type": event_type,
+        "location": {"directory": "/tmp/project"},
+        "data": {"sessionID": session_id, **data},
+    }
+
+
