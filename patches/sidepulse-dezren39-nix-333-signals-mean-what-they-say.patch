+# --- a latched signal must stay retirable -----------------------------------
+
+
+def test_a_persisted_row_keeps_what_makes_it_retirable():
+    """`latest.json` is reloaded on every status bar start.
+
+    `BLOCKED_ERROR` and `WAITING_FOR_INPUT` never expire on a clock, so a row
+    that survives that round-trip without its pid, its lineage or its last
+    prompt has nothing left that could ever clear it: no process to test for
+    liveness, no ancestor to inherit a prompt from, and no prompt of its own.
+    One restart turned a finished failure into a permanently red device.
+    """
+    from sidepulse.collector import agent_status_from_dict, status_awaits_a_reachable_human
+
+    row = status(
+        "opencode:session:a",
+        AgentMode.BLOCKED_ERROR,
+        session_id="a",
+        parent_session_id="parent",
+        prompted_at=5,
+    )
+    row = row.__class__(**{**row.__dict__, "agent_pid": 4242})
+
+    restored = agent_status_from_dict(row.to_dict())
+    assert restored is not None
+    assert restored.agent_pid == 4242
+    assert restored.parent_session_id == "parent"
+    assert restored.last_user_prompt_at == row.last_user_prompt_at
+
+    # And the liveness escape hatch works on the restored row rather than
+    # silently defaulting to "unknown pid, assume alive, never expire".
+    dead = restored.__class__(**{**restored.__dict__, "agent_pid": 2 ** 22})
+    assert not status_awaits_a_reachable_human(dead)
+
