+# --- presence is an act, not a twitch ---------------------------------------
+
+
+def test_presence_ignores_mouse_movement(monkeypatch):
+    """Acknowledgement has to be deliberate.
+
+    `kCGAnyInputEventType` counts the pointer drifting one pixel, so a cat on
+    the desk or a window animation under the cursor retired a completion
+    nobody had looked at.
+    """
+    import sidepulse.presence as presence
+
+    class FakeQuartz:
+        kCGEventSourceStateHIDSystemState = 1
+        kCGEventKeyDown = 10
+        kCGEventLeftMouseDown = 1
+        kCGEventRightMouseDown = 3
+        kCGEventOtherMouseDown = 25
+        kCGEventScrollWheel = 22
+        kCGEventMouseMoved = 5
+        asked: list[int] = []
+
+        @staticmethod
+        def CGEventSourceSecondsSinceLastEventType(_source, event_type):
+            FakeQuartz.asked.append(event_type)
+            # Mouse moved a moment ago; nothing was clicked or typed for a
+            # minute. The answer must be the minute.
+            return 0.1 if event_type == FakeQuartz.kCGEventMouseMoved else 60.0
+
+    monkeypatch.setitem(__import__("sys").modules, "Quartz", FakeQuartz)
+    assert presence.seconds_since_last_input() == 60.0
+    assert FakeQuartz.kCGEventMouseMoved not in FakeQuartz.asked
+    assert FakeQuartz.kCGEventKeyDown in FakeQuartz.asked
+    assert FakeQuartz.kCGEventScrollWheel in FakeQuartz.asked
