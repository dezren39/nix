{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "opencode-pty@latest",
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz"
  ],
  "default_agent": "build",
  "agent": {
    "plan": {
      "disable": true
    }
  },
  "subagent_depth": 10,
  "model": "github-copilot/claude-opus-5.5",
  "small_model": "github-copilot/claude-opus-5.5",
  "permission": {
    "read": "deny",
    "lsp": "deny",
    "todowrite": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "bash -c *": "ask",
      "sh -c *": "ask",
      "zsh -c *": "ask",
      "eval *": "ask",
      "git remote add *": "ask",
      "git stash *": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git branch --delete*": "ask",
      "git worktree remove *": "ask",
      "git worktree prune *": "ask",
      "git push* :*": "ask",
      "git rm *": "ask",
      "git tag -d*": "ask",
      "git commit*--amend*": "ask",
      "git remote set-url*": "deny",
      "git remote remove*": "deny",
      "git remote rename*": "deny",
      "git remote rm*": "deny",
      "git config*remote.*url*": "deny",
      "git config*--remove-section*": "deny",
      "git config*--unset*": "deny",
      "git push*--force*": "deny",
      "git push*-f *": "deny",
      "git push*--delete*": "deny",
      "git push*-d *": "deny",
      "git push*--mirror*": "deny",
      "git push*--prune*": "deny",
      "git reset --hard origin/main*": "ask",
      "git reset --hard */origin/main*": "ask",
      "git reset --hard*": "deny",
      "git reset --merge*": "deny",
      "git reset --keep*": "deny",
      "git checkout -- *": "deny",
      "git checkout .*": "deny",
      "git checkout --ours*": "deny",
      "git checkout --theirs*": "deny",
      "git restore *": "deny",
      "git checkout -f*": "deny",
      "git checkout --force*": "deny",
      "git switch*--discard-changes*": "deny",
      "git switch -f*": "deny",
      "git switch --force*": "deny",
      "git checkout -B*": "deny",
      "git switch -C*": "deny",
      "git branch -f*": "deny",
      "git branch --force*": "deny",
      "git clean*-f*": "deny",
      "git clean*-x*": "deny",
      "git update-ref *": "deny",
      "git symbolic-ref *": "deny",
      "git reflog expire*": "deny",
      "git gc*--prune*": "deny",
      "git prune *": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git submodule deinit*": "deny",
      "git submodule*--force*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git stash list *": "allow",
      "git stash show *": "allow",
      "git config --get *": "allow",
      "git config --get-regexp *": "allow",
      "git config --list *": "allow"
    },
    "plan_enter": "deny",
    "plan_exit": "deny",
    "task": {
      "custom": "ask"
    }
  },
  "instructions": [
    "~/.config/opencode/instructions/lootbox.md",
    "~/.config/opencode/instructions/worktrees.md",
    "~/.config/opencode/instructions/recordings.md",
    "~/.config/opencode/instructions/work-strategies.md"
  ],
  "compaction": {
    "reserved": 8192
  },
  "warming": true
}