{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    // "@tarquinen/opencode-dcp@latest", // causes large GitHub API request counts — use manual /compact instead
    // "opencode-working-memory@latest",
    // "octto@latest",
    // "@forks.developing.today/octto@latest",
    // "micode@latest", // forces context7 MCP server with no opt-out: https://github.com/vtemian/micode/issues/49
    // "opencode-scheduler@latest",
    // "@openspoon/subtask2@latest",
    //"@tmegit/opencode-worktree-session@latest",
    "@mohak34/opencode-notifier@latest",
    "opencode-pty@latest",
    //"opencode-devcontainers@latest",
    // "opencode-dir",
    // "opencode-pilot@latest",
    "@franlol/opencode-md-table-formatter@latest",
    // "@ramtinj95/opencode-tokenscope" — NOT installable from this array. It is a
    // locally-installed plugin: run the upstream tokenscope install steps
    // (https://github.com/ramtinj95/opencode-tokenscope) which drop it into
    // ~/.config/opencode/plugin/, where opencode auto-discovers it. Its
    // tokenscope-config.json and command/tokenscope.md are intentionally NOT
    // tracked in this repo; install the plugin to make them available.
    // "true-mem@latest",
    // "@knikolov/opencode-plugin-simple-memory@latest",
    // "opencode-mem@latest",
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz",
    // plugins/tool-definitions.ts is NOT listed here. A relative spec resolves
    // against dirname() of the config file opencode loaded (config/plugin.ts:48),
    // which is ~/.config/opencode, not this repo. It is symlinked into
    // ~/.config/opencode/plugin/ instead, where opencode auto-discovers it —
    // the same mechanism tokenscope uses above. Relink with:
    //   ln -sfn ~/.config/nix/plugins/tool-definitions.ts \
    //           ~/.config/opencode/plugin/tool-definitions.ts
  ],
  // Provider/model restrictions disabled — every authenticated provider and every
  // model it exposes is allowed through. Re-enable any line below to pin again.
  // "enabled_providers": ["github-copilot"],
  "default_agent": "build",
  // plan is a built-in primary agent. agents/plan.md was an empty stub that
  // never loaded, so disable the built-in explicitly rather than leaving a
  // dead file implying it was handled.
  "agent": { "plan": { "disable": true } },
  // Delegation topology. Enforced per-agent by the `task` rulesets in
  // agents/*.md, since opencode has no per-agent depth setting — subagent_depth
  // below is global. Tiers descend strictly, so the edge set is acyclic and
  // recursion terminates structurally rather than by exhausting a counter:
  //
  //   tier 0  build, plan                      (primary)
  //   tier 1  general, custom, explore
  //   tier 2  general-2wide, custom-2wide, explore-2wide
  //   tier 3  general-wide, custom-wide, explore-wide
  //   tier 4  general-deep, custom-deep, explore-deep
  //
  // The `-2wide` / `-wide` / `-deep` suffixes ARE the tier, and the rulesets
  // match on them rather than on agent names: tier 2 allows `"*-wide"` and
  // `"*-deep"`, tier 3 allows `"*-deep"` and `"explore*"`, tier 4 allows only
  // `"explore*"`. Wildcard.match compiles `*` to `.*` anchored at both ends
  // (util/wildcard.ts:3-13), so `"*-wide"` matches general-wide but not
  // general-2wide, and `"explore-*"` matches the variants but not explore
  // itself. Name a new worker with the right suffix and it slots in with no
  // edits elsewhere; name it anything else and nothing can reach it.
  //
  // An agent may call anything in a strictly lower tier, across families —
  // general-2wide may call custom-wide. Two carve-outs: toplevel general and
  // custom do not call each other or themselves, and the explore family is a
  // closed descending chain (everything may call into it; it never calls out).
  // explore-deep is the only terminal node.
  //
  // build and plan carry no `task` rule of their own: the shared default
  // `"*": allow` (agent/agent.ts:119) already lets them reach every subagent,
  // which is the orchestrator role. Built-in plan additionally denies `general`
  // (agent/agent.ts:163-165). Every agent below them is deny-by-default with
  // explicit allows, so adding a global `task: { x: "deny" }` here still holds
  // everywhere except explore, whose `"*": allow` is needed to clear the
  // built-in read-only ruleset and shadows it.
  //
  // Longest chain is build -> general -> custom-2wide -> custom-wide ->
  // custom-deep -> explore -> explore-2wide -> explore-wide -> explore-deep,
  // which puts the deepest task call at depth 7 and needs subagent_depth >= 8.
  // 10 is a backstop for agents added outside this topology, not a control —
  // the edge set is what bounds recursion. Default is 1, which rejects any task
  // call from inside a subagent at task.ts:111 before the permission check runs.
  //
  // Nothing tells an agent how deep it currently is — depth is computed only
  // inside the task call (task.ts:104-110) and surfaces as a tool error. The
  // topology is what keeps agents from discovering the limit by hitting it.
  "subagent_depth": 10,
  // Last-resort default, read only at provider.ts:2010 (`if (cfg.model)`).
  // Unreachable today: every agent in agents/*.md pins claude-opus-5 except the
  // custom family, which inherits the caller's model by design
  // (task.ts:181-184), and default_agent is build, which pins. Set anyway so an
  // agent added later without a `model:` can't fall through to the
  // family-priority picker.
  "model": "github-copilot/claude-opus-5",
  // "small_model": "github-copilot/gpt-5.6-terra",
  // Fallback for `small: true` calls (title generation). Unused in practice —
  // agent.title sets its own model, which takes precedence at prompt.ts:216.
  // Set anyway so a future small-call path can't silently fall through to the
  // family-priority picker: ["gemini-flash", "gpt-nano", "claude-haiku"].
  "small_model": "github-copilot/claude-opus-5",
  // "provider": {
  //   "github-copilot": {
      // Disable models per policy: any gpt < 5.6, any claude < 4.8, and all Gemini,
      // Kimi, and MAI models.
      // Blacklist entries are exact upstream (models.dev) model ids; unknown ids are
      // harmless no-ops. Kept enabled: gpt-5.6-{sol,terra,luna}, claude-fable-5,
      // claude-sonnet-5, and claude-opus-5.
      // "blacklist": [
        // gpt < 5.6
        // "gpt-4.1",
        // "gpt-5-mini",
        // "gpt-5.2",
        // "gpt-5.2-codex",
        // "gpt-5.3-codex",
        // "gpt-5.4",
        // "gpt-5.4-mini",
        // "gpt-5.4-nano",
        // "gpt-5.5",
        // claude < 4.8 (incl. opencode-generated `-fast` mode variants)
        // "claude-haiku-4.5",
        // "claude-opus-4.5",
        // "claude-opus-4.6",
        // "claude-opus-4.6-fast",
        // "claude-opus-4.7",
        // "claude-opus-4.7-fast",
        // "claude-opus-4.8",
        // "claude-opus-4.8-fast",
        // "claude-sonnet-4",
        // "claude-sonnet-4.5",
        // "claude-sonnet-4.6",
        // gemini < 3.1
        // "gemini-2.5-pro",
        // "gemini-3-flash-preview",
        // disabled model families
        // "gemini-3.1-pro-preview",
        // "gemini-3.5-flash",
        // "kimi-k2.7-code",
        // "mai-code-1-flash-picker",
      // ],
      // "models": {
        // "claude-opus-5": {},
        // ---------------------------------------------------------------
        // Model-limit shaping DISABLED — use each model's upstream (models.dev)
        // limits. Kept commented for reference / easy re-enable. The trailing
        // comments are GitHub Copilot premium-request cost multipliers, not
        // opencode settings.
        // ---------------------------------------------------------------
        // "claude-haiku-4.5": {
        //   "limit": { "context": 200000, "output": 64000 }, // 0.33x
        // },
        // "claude-opus-4.5": {
        //   "limit": { "context": 200000, "output": 32000 }, // 3x
        // },
        // "claude-opus-4.6": {
        //   "limit": { "context": 200000, "output": 32000 }, // 3x
        // },
        // "claude-opus-4.7": {
        //   "limit": { "context": 200000, "output": 32000 },
        // },
        // "claude-opus-4.8": {
        //   "limit": { "context": 200000, "output": 32000 },
        // },
        // "claude-sonnet-4": {
        //   "limit": { "context": 216000, "output": 16000 }, // 1x
        // },
        // "claude-sonnet-4.5": {
        //   "limit": { "context": 200000, "output": 32000 }, // 1x
        // },
        // "claude-sonnet-4.6": {
        //   "limit": { "context": 200000, "output": 32000 }, // 1x
        // },
        // "gemini-2.5-pro": {
        //   "limit": { "context": 173000, "output": 64000 }, // 1x
        // },
        // "gemini-3-flash-preview": {
        //   "limit": { "context": 173000, "output": 64000 }, // 0.33x
        // },
        // "gemini-3-pro-preview": {
        //   "limit": { "context": 200000, "output": 64000 }, // 1x
        // },
        // "gemini-3.1-pro-preview": {
        //   "limit": { "context": 200000, "output": 64000 }, // 1x
        // },
        // "gpt-4.1": {
        //   "limit": { "context": 128000, "output": 16384 }, // 0x
        // },
        // "gpt-4o": {
        //   "limit": { "context": 128000, "output": 4096 }, // 0x
        // },
        // "gpt-5-mini": {
        //   "limit": { "context": 264000, "output": 64000 }, // 0x
        // },
        // "gpt-5.1": {
        //   "limit": { "context": 264000, "output": 64000 }, // 1x
        // },
        // "gpt-5.1-codex": {
        //   "limit": { "context": 400000, "output": 128000 }, // 1x
        // },
        // "gpt-5.1-codex-max": {
        //   "limit": { "context": 400000, "output": 128000 }, // 1x
        // },
        // "gpt-5.2": {
        //   "limit": { "context": 400000, "output": 128000 }, // 1x
        // },
        // "gpt-5.2-codex": {
        //   "limit": { "context": 400000, "output": 128000 }, // 1x
        // },
        // "gpt-5.3-codex": {
        //   "limit": { "context": 400000, "output": 128000 }, // 1x
        // },
        // "gpt-5.4": {
        //   "limit": { "context": 400000, "output": 128000 }, // 1x
        // },
        // "grok-code-fast-1": {
        //   "limit": { "context": 256000, "output": 64000 }, // 0.25x
        // },
      // },
    // },
  // },
  "permission": {
    // read/lsp denied globally: `cat -n` covers reading, and codedb +
    // codebase-memory cover what lsp answered (definitions, callers, call
    // graph). Denying with pattern "*" is what actually removes a tool from the
    // request - permission/index.ts:204-213 requires the last matching rule to
    // be `"*": deny` before session/llm/request.ts:207 drops it.
    "read": "deny",
    "lsp": "deny",
    // A literal `todowrite` key here satisfies subagent-permissions.ts:19, which
    // tests `rule.permission === "todowrite"` with `===`. Without it every
    // subagent session gets an injected `todowrite: deny *`. One global line
    // replaces a per-agent frontmatter entry on all 12.
    "todowrite": "allow",
    "edit": "allow",
    "external_directory": "allow",
    // plan_enter/plan_exit only exist to suggest switching to/from the plan
    // agent (tool/plan-enter.txt). Unused here, and the shared defaults already
    // deny them for every agent except build and plan, so denying globally just
    // drops the two descriptions from build's payload (~297 tokens).
    "plan_enter": "deny",
    "plan_exit": "deny",
    // Gate the `custom` delegate. task.ts:120-122 passes the subagent_type as
    // the permission pattern, so this matches per-agent. Enforced, not
    // advisory: the model cannot invoke custom without an explicit approval.
    // Replying "always" allows it for the rest of the session only — that lives
    // in an in-memory approved list (permission/index.ts:146), never persisted.
    "task": {
      "custom": "ask",
    },
  },
  // Agents are defined in agents/*.md (frontmatter = the same ConfigAgentV1
  // schema as this file). Install with ./symlink-agents, which links
  // ~/.opencode/agents -> this repo's agents/ so they are tracked in git.
  //
  // Why markdown rather than here: explore/compaction/title/summary each carry
  // a built-in prompt, and the merge is `item.prompt = value.prompt ?? item.prompt`.
  // A markdown body is assigned unconditionally (config/agent.ts:27), so those
  // four keep their prompt verbatim in the file; build/general/custom have empty
  // bodies and fall through to the model's default prompt.

  // "agent": {
  // "build": {
  //   "mode": "subagent",
  //   "model": "github-copilot/claude-opus-4.8",
  // },
  // "plan": {
  //   "mode": "subagent",
  //   "model": "github-copilot/claude-opus-4.8",
  // },
  // "octto": {
  //   "variant": "thinking",
  //   "model": "github-copilot/claude-opus-4.8",
  // },
  // "bootstrapper": {
  //   "variant": "thinking",
  //   "model": "github-copilot/claude-opus-4.8",
  // },
  // "probe": {
  //   "variant": "thinking",
  //   "model": "github-copilot/claude-opus-4.8",
  // },
  //   "compaction": {
  //     "model": "github-copilot/gpt-5.4",
  //     "threshold": 0.5,
  //   },
  //   "title": {
  //     "model": "github-copilot/gpt-5.4",
  //   },
  //   "summary": {
  //     "model": "github-copilot/gpt-5.4",
  //   },
  // },
  "instructions": [
    "~/.config/opencode/instructions/lootbox.md",
    // subagents.md archived to instructions/archive/ — it named agents
    // (explore/general/plan) that the trimmed agent set no longer defines, so it
    // was describing a topology that does not exist. Re-add only if rewritten
    // to match the current agents.
  ],
  "compaction": {
    "reserved": 8192,
  },
}
