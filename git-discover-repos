#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# git-discover-repos — find every git repository and worktree, once, and print
# them in a form the other scripts can consume.
#
# WHY THIS EXISTS
#   clean.sh, git-maintain-repos and spotlight-exclude-artifacts each grew their
#   own discovery. Two of them defaulted to ~/git and used a single find(1),
#   which missed repos living directly in ~ under names like ez-stack and
#   DeepFilterNet, worktrees under .worktrees/, and worktrees some tools stash
#   inside .git/. This is the union of all three, implemented once.
#
# TWO INDEPENDENT AXES
#   RECURSION  does the given path get walked to find repos inside it?
#              --recursive (default) / --no-recursive
#   FOLLOWING  once a repo or worktree is found, do we hop along git's own
#              links -- `rev-parse --git-common-dir` from a worktree back to its
#              real repo, and `worktree list` from a repo out to all of its
#              worktrees -- and then keep discovering from there?
#              --follow / --no-follow
#
#   They are genuinely separate: you can walk a tree without following links out
#   of it, or point at one worktree and follow to its siblings without walking.
#   --no-recursive --follow is rejected: with nothing to walk there is no seed
#   to follow from beyond the path itself, so it would silently mean --follow
#   only from one dir; say what you mean with --path plus --follow.
#
# DEFAULTS DIFFER BY MODE, deliberately
#   --auto  (no --path)  recursive + follow   -- "everything on this machine"
#   --path DIR           recursive + NO follow -- "just this, and what is in it"
#
# OUTPUT
#   One record per line: TYPE<TAB>PATH
#     repo      a real repository (.git is a directory, or a bare repo)
#     worktree  a linked worktree (.git is a gitdir-pointer file)
#   Filter with --repos-only / --worktrees-only. Order is stable (sorted).
#
#   Maintenance must run once per REAL repo: worktrees share the parent's object
#   store, so running it per worktree repeats the same work N times.

set -uo pipefail

_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
. "$_self_dir/lib/common.sh"
ARG_PROGRAM="git-discover-repos"

usage() {
  cat <<'EOF'
git-discover-repos — enumerate every git repository and worktree

USAGE
  git-discover-repos [--auto] [options]         whole machine (default)
  git-discover-repos --path DIR [options]       one location
  git-discover-repos --path DIR --follow        one location + everything linked

SCOPE
  --auto              Scan the full default set (below). Implies --follow.
                      Conflicts with --path.
  --path DIR          Scan DIR only. Implies --no-follow. May be repeated.
                      May also be given positionally.

RECURSION (how far down the path do we go?)
  --recursive         Descend without limit. Default.
  --no-recursive      Equivalent to --depth 1: the path itself and its direct
                      children. `--path X --no-recursive` finds X/.trash but
                      not X/a/b/.trash. (Depth 0 would only test whether X is
                      itself named .trash, which is never what you want.)
  --depth N           Explicit find(1) -maxdepth. 1 = path + direct children.

FOLLOWING (do we hop along git's links to related repos/worktrees?)
  --follow            worktree -> its real repo, repo -> all its worktrees,
                      then keep discovering from whatever that turns up, until
                      no new paths appear.
  --no-follow         Stay put.

FILTERING (output shape, orthogonal to scope)
  --repos-only        Print only real repositories.
  --worktrees-only    Print only linked worktrees.
  --both              Print both, TYPE-tagged. Default.
  --paths-only        Print bare paths with no TYPE column, for piping into
                      xargs. (Orthogonal to --repos-only/--worktrees-only,
                      which choose WHICH records are printed, not their shape.)
  --bare-only         Print only bare repositories.
  --no-bare           Exclude bare repositories. (They are included by default
                      and tagged "repo" like any other; --bare-only narrows to
                      just them, mirroring --repos-only/--worktrees-only.)

FINDING ARTIFACTS TOO
  --find NAME[,NAME]  Also emit artifact hits inside every discovered location,
                      as  FOUND<TAB>REASON<TAB>STATUS<TAB>PATH
                      Special values: cache, risky, trash, all
  --status            For --find hits, ask git whether the dir is tracked /
                      ignored / untracked. Costs one git call per hit.

OTHER
  --user USER         Scan USER's home instead of the caller's (needs root).
  --print0            NUL-separate records instead of newline.
  --count             Print only a summary count.
  --dry-run           Describe the plan, discover nothing.
  -h, --help          This help

DEFAULT SCAN SET (--auto), mirroring clean.sh's rules
  1. ~/.local/share/opencode/worktree                 (deep)
  2. /private/var/folders/*/*/T/opencode               (deep; second opencode
     scratch root some sandboxed contexts use instead of ~/.local/share;
     override the /private/var/folders parent with VAR_FOLDERS_ROOT in tests)
  3. ~/<dir> where the name is all digits or contains "git"   (deep)
  4. every dir/symlinked dir directly in ~, whatever its name, tested for being
     a repo; if it is one, its .git/ and .worktrees/ are also scanned
  Symlinked roots are resolved to physical paths first, so a repo reachable as
  both ~/foo and ~/git/foo is reported once.
EOF
}

MODE="auto"
DEPTH_LIMIT=""
FOLLOW=""            # empty = "mode decides"
FILTER="both"
INCLUDE_BARE=1
FIND_SPEC=""
WANT_STATUS=0
PRINT0=0
PATHS_ONLY=0
COUNT_ONLY=0
DRY_RUN=0
TARGET_USER=""
PATHS=()
RECURSIVE_SET=0
FOLLOW_SET=0
DEPTH_SET=0
FIND_SET=0
USER_SET=0
FILTER_FLAG=""
FOLLOW_YES_SET=0
FOLLOW_NO_SET=0
AUTO_SET=0
PATH_SET=0

while [ $# -gt 0 ]; do
  case "$1" in
    --auto)           { arg_conflict --auto --path "$PATH_SET"; MODE="auto"; AUTO_SET=1; } ;;
    --path)           { arg_require_value "$1" "${2:-}"; arg_conflict --auto --path "$AUTO_SET"; MODE="path"; PATHS+=("$2"); PATH_SET=1; shift; } ;;
    --recursive|--walk)       DEPTH_LIMIT=""; RECURSIVE_SET=1 ;;
    --no-recursive|--no-walk) DEPTH_LIMIT=1;  RECURSIVE_SET=1 ;;
    --depth)                  { arg_require_value "$1" "${2:-}"; arg_once "$1" DEPTH_SET; DEPTH_LIMIT="$2"; RECURSIVE_SET=1; shift; } ;;
    --follow)         { arg_conflict --follow --no-follow "$FOLLOW_NO_SET"; FOLLOW=1; FOLLOW_SET=1; FOLLOW_YES_SET=1; } ;;
    --no-follow)      { arg_conflict --follow --no-follow "$FOLLOW_YES_SET"; FOLLOW=0; FOLLOW_SET=1; FOLLOW_NO_SET=1; } ;;
    --repos-only)     { [ -z "$FILTER_FLAG" ] || arg_die "$1 may not be combined with $FILTER_FLAG (only one filter option may be given)"; FILTER="repos"; FILTER_FLAG="$1"; } ;;
    --worktrees-only) { [ -z "$FILTER_FLAG" ] || arg_die "$1 may not be combined with $FILTER_FLAG (only one filter option may be given)"; FILTER="worktrees"; FILTER_FLAG="$1"; } ;;
    --both)           { [ -z "$FILTER_FLAG" ] || arg_die "$1 may not be combined with $FILTER_FLAG (only one filter option may be given)"; FILTER="both"; FILTER_FLAG="$1"; } ;;
    --bare-only)      { [ -z "$FILTER_FLAG" ] || arg_die "$1 may not be combined with $FILTER_FLAG (only one filter option may be given)"; FILTER="bare"; FILTER_FLAG="$1"; } ;;
    --paths-only)     PATHS_ONLY=1 ;;
    --no-bare)        INCLUDE_BARE=0 ;;
    --find)           { arg_require_value "$1" "${2:-}"; arg_once "$1" FIND_SET; FIND_SPEC="$2"; shift; } ;;
    --status)         WANT_STATUS=1 ;;
    --user)           { arg_require_value "$1" "${2:-}"; arg_once "$1" USER_SET; TARGET_USER="$2"; shift; } ;;
    --print0)         PRINT0=1 ;;
    --count)          COUNT_ONLY=1 ;;
    --dry-run)        DRY_RUN=1 ;;
    -h|--help)        usage; exit 0 ;;
    -*)               echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)                { arg_conflict --auto --path "$AUTO_SET"; MODE="path"; PATHS+=("$1"); PATH_SET=1; } ;;
  esac
  shift
done

# --depth is turned into a find -maxdepth fragment below, where a
# non-numeric value fails mid-walk and 0 silently means "the path itself
# only". Judge it whole, at parse time, with the shared arg_decimal
# helper (lib/common.sh), like opencode-db-prune.sh judges
# --protect-days/--batch (#830); the INT_MAX range backstop is #858's.
# Empty means unbounded (--recursive). This judge is the same in all
# four discovery-vocabulary scripts.
if [ -n "$DEPTH_LIMIT" ]; then
  arg_decimal DEPTH_LIMIT --depth "$DEPTH_LIMIT" positive
fi

if [ "$DEPTH_LIMIT" = "1" ] && [ "${FOLLOW:-0}" = "1" ] && [ "$RECURSIVE_SET" = "1" ]; then
  echo "git-discover-repos: --no-recursive conflicts with --follow" >&2
  echo "                    (use --depth N with N>1 if you want a bounded walk plus following)" >&2
  exit 2
fi

# find(1) depth fragment, shared by the repo walk and the artifact sweep.
DEPTH_ARGS=()
[ -n "$DEPTH_LIMIT" ] && DEPTH_ARGS=(-maxdepth "$DEPTH_LIMIT")

# Mode-specific default for following, applied only if not set explicitly.
if [ -z "$FOLLOW" ]; then
  if [ "$MODE" = "auto" ]; then FOLLOW=1; else FOLLOW=0; fi
fi

# Resolve the home directory being scanned.
if [ -n "$TARGET_USER" ]; then
  # The tilde expansion below goes through eval, so judge the username whole
  # first (#875): a value carrying shell metacharacters ($(...), backticks,
  # ';', whitespace, '/') would otherwise execute as commands during the
  # eval, before the "no home" check ever runs. A real username is only
  # letters, digits, '.', '_' and '-', and never starts with '-' or '~'.
  case "$TARGET_USER" in
    -*|'~'*|*[!A-Za-z0-9._-]*)
      echo "git-discover-repos: --user must be a plain username (got: $TARGET_USER)" >&2
      exit 2 ;;
  esac
  SCAN_HOME="$(eval echo "~$TARGET_USER")"
  [ -d "$SCAN_HOME" ] || { echo "git-discover-repos: no home for $TARGET_USER" >&2; exit 1; }
else
  SCAN_HOME="${HOME}"
fi

# Second opencode scratch root's parent (env seam so tests can point it at
# a fixture, #1346 — same VAR_FOLDERS_ROOT precedent as clean.sh's
# --tmpdir sweep; unset means the production /private/var/folders).
VAR_FOLDERS_ROOT="${VAR_FOLDERS_ROOT:-/private/var/folders}"

# git refuses to touch repos owned by another user; every consumer here is
# read-only discovery, so assert safety rather than fail.
git_q() { git -c safe.directory='*' "$@"; }

canon() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s\n' "$1"; }
is_repo() { [ -e "$1/.git" ]; }
# A bare repo has no .git entry; the directory itself is the object store.
is_bare_repo() {
  [ -d "$1" ] || return 1
  [ -f "$1/HEAD" ] && [ -d "$1/objects" ] && [ -d "$1/refs" ]
}
is_numeric() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

build_name_expr PRUNE_EXPR "${ALL_ARTIFACT_NAMES[@]}"

# Two find passes identify bare-repo candidates from their objects directories,
# then produce discovery and artifact results while pruning those exact paths.
# Checking every directory with find -exec would launch a shell once per dir;
# the candidate pass only runs the shape checks for directories named objects.
# The exact-path prune also leaves ordinary .git directories traversable
# because Git stores linked worktrees beneath them.
#
# The candidate pass looks one level deeper than --depth because a bare repo
# at depth N has its objects directory at depth N+1. Artifact directories stay
# pruned in both passes.
ARTIFACTS_FILE="$(mktemp)"
BARE_CANDIDATES_FILE="$(mktemp)"

escape_find_pattern() {
  local pattern="$1"
  pattern="${pattern//\\/\\\\}"
  pattern="${pattern//\*/\\*}"
  pattern="${pattern//\?/\\?}"
  pattern="${pattern//\[/\\[}"
  printf '%s' "$pattern"
}

scan_deep() {
  [ -d "$1" ] || return 0
  # A failed find enumeration (e.g. an unreadable subdirectory) must not be
  # silently swallowed (#1325): find's stderr is captured, not discarded,
  # and a non-zero find status is returned to the caller. In --path mode
  # the failure is named on stderr (find's own lines name the unreadable
  # directory; the clean line names the scan root, #1321 style) and
  # seed_path turns the status into the script's exit status. --auto is
  # best-effort by design, so seed_auto ignores the status and the
  # failure stays quiet there.
  local candidate_status_file candidate_stderr_file candidate_status
  local status_file stderr_file find_status candidate_failed=0 bare_maxdepth
  local bare_path first=1
  # shellcheck disable=SC2016
  local bare_candidate_probe='
parent="${1%/objects}"
case "${parent##*/}" in
  .git|.worktrees) exit 0 ;;
esac
case "$parent" in
  */.git/modules/*) exit 0 ;;
esac
if [ -d "$1" ] && [ -f "$parent/HEAD" ] && [ -d "$parent/refs" ]; then
  printf "%s\n" "$parent" >> "$2"
else
  exit 1
fi
'
  local -a bare_depth_args=() bare_prune_args=()
  : > "$BARE_CANDIDATES_FILE"
  if [ -n "$DEPTH_LIMIT" ]; then
    if [ "$DEPTH_LIMIT" -lt 2147483647 ]; then
      bare_maxdepth=$((DEPTH_LIMIT + 1))
    else
      # The deepest representable limit cannot have an additional child level
      # on supported find implementations; avoid overflowing their depth type.
      bare_maxdepth="$DEPTH_LIMIT"
    fi
    bare_depth_args=(-maxdepth "$bare_maxdepth")
  fi

  candidate_status_file="$(mktemp)"
  candidate_stderr_file="$(mktemp)"
  outcome_enumerate "$candidate_status_file" "$candidate_stderr_file" -- \
    find -H "$1" "${bare_depth_args[@]}" \
      \( "${PRUNE_EXPR[@]}" \) -prune -o \
      \( -name objects -exec sh -c "$bare_candidate_probe" sh {} "$BARE_CANDIDATES_FILE" \; \) -prune
  candidate_status=0
  IFS= read -r candidate_status < "$candidate_status_file" || candidate_status=0
  if [ "$candidate_status" -ne 0 ]; then
    candidate_failed=1
    if [ "$MODE" = "path" ]; then
      cat "$candidate_stderr_file" >&2
      echo "git-discover-repos: failed to find bare-repo candidates under: $1" >&2
    fi
  fi
  rm -f "$candidate_status_file" "$candidate_stderr_file"

  while IFS= read -r bare_path; do
    [ -n "$bare_path" ] || continue
    if [ "$first" = "1" ]; then
      first=0
    else
      bare_prune_args+=(-o)
    fi
    bare_prune_args+=(-path "$(escape_find_pattern "$bare_path")")
  done < <(sort -u "$BARE_CANDIDATES_FILE")
  if [ "$first" = "0" ]; then
    bare_prune_args=( \( "${bare_prune_args[@]}" \) -prune -print -o )
  fi

  status_file="$(mktemp)"
  stderr_file="$(mktemp)"
  outcome_enumerate "$status_file" "$stderr_file" -- \
    find -H "$1" "${DEPTH_ARGS[@]}" \
      \( "${PRUNE_EXPR[@]}" \) -prune -print -o \
      "${bare_prune_args[@]}" \
      -name .git -print |
    while IFS= read -r hit; do
      # Fast parameter expansion avoids subshell execution of basename in discovery loop
      case "${hit##*/}" in
        .git) printf '%s\n' "${hit%/.git}" ;;
        *)
          if is_bare_repo "$hit"; then
            printf '%s\n' "$hit"
          else
            printf '%s\n' "$hit" >> "$ARTIFACTS_FILE"
          fi
          ;;
      esac
    done
  find_status=0
  IFS= read -r find_status < "$status_file" || find_status=0
  if [ "$find_status" -ne 0 ]; then
    if [ "$MODE" = "path" ]; then
      cat "$stderr_file" >&2
      echo "git-discover-repos: failed to enumerate: $1" >&2
    fi
    rm -f "$status_file" "$stderr_file"
    return 1
  fi
  rm -f "$status_file" "$stderr_file"
  [ "$candidate_failed" = "0" ] || return 1
  return 0
}

SEEN_FILE="$(mktemp)"
OUT_FILE="$(mktemp)"
QUEUE_FILE="$(mktemp)"
trap 'rm -f "$SEEN_FILE" "$OUT_FILE" "$QUEUE_FILE" "$ARTIFACTS_FILE" "$BARE_CANDIDATES_FILE"' EXIT

seen() { grep -qxF "$1" "$SEEN_FILE" 2>/dev/null; }
mark_seen() { printf '%s\n' "$1" >> "$SEEN_FILE"; }

# classify PATH -> prints "repo" or "worktree", or nothing if neither
classify() {
  local d="$1"
  if [ -f "$d/.git" ]; then
    # A .git file is a gitdir pointer: read where it points (#1511).
    # A linked worktree points at <repo>/.git/worktrees/<name> and
    # shares that repo's object store, so it stays a worktree. A
    # submodule checkout points at <super>/.git/modules/<name> and
    # owns an independent object store, so it is a repo in its own
    # right: maintenance must target it (via the checkout path)
    # exactly once.
    local line target
    line="$(head -n 1 "$d/.git" 2>/dev/null)"
    target="${line#gitdir: }"
    case "$target" in
      /*) ;;
      *) target="$d/$target" ;;
    esac
    target="$(canon "$target")"
    case "$target" in
      */.git/modules/*) echo repo ;;
      *) echo worktree ;;
    esac
  elif [ -d "$d/.git" ]; then echo repo
  elif is_bare_repo "$d"; then echo repo
  fi
}

emit() {
  local kind="$1" path="$2"
  seen "$path" && return 0
  mark_seen "$path"
  printf '%s\t%s\n' "$kind" "$path" >> "$OUT_FILE"
  [ "$FOLLOW" = "1" ] && printf '%s\n' "$path" >> "$QUEUE_FILE"
  return 0
}

consider() {
  local d="$1" kind
  [ -d "$d" ] || return 0
  # Never emit a record inside a .git/modules tree (#1511): that is a
  # submodule's object store, and its canonical record is the
  # submodule checkout (kind repo). The follow hop reaches here with
  # the modules path because `git worktree list` run inside a
  # submodule names the gitdir as the worktree path.
  case "$d" in
    */.git/modules/*) return 0 ;;
  esac
  kind="$(classify "$d")"
  [ -z "$kind" ] && return 0
  if [ "$kind" = "repo" ] && [ "$INCLUDE_BARE" = "0" ] && is_bare_repo "$d"; then return 0; fi
  emit "$kind" "$d"
}

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
seed_auto() {
  scan_deep "$(canon "$SCAN_HOME/.local/share/opencode/worktree")"
  # Second opencode scratch root: some sandboxed contexts default it to
  # $TMPDIR instead of ~/.local/share, so the SAME worktrees/artifacts turn up
  # a second time at $VAR_FOLDERS_ROOT/*/*/T/opencode -- see clean.sh's
  # "short-lived scratch" and "opencode scratch dirs" sections for why this
  # one in particular earned a named root instead of being left to --tmpdir.
  local _vf
  for _vf in "$VAR_FOLDERS_ROOT"/*/*/T/opencode; do
    [ -d "$_vf" ] && scan_deep "$(canon "$_vf")"
  done
  local d b
  for d in "$SCAN_HOME"/*/; do
    d="${d%/}"; b="${d##*/}"
    case "$b" in
      *git*) scan_deep "$(canon "$d")" ;;
      *)     is_numeric "$b" && scan_deep "$(canon "$d")" ;;
    esac
  done
  for d in "$SCAN_HOME"/*/; do
    d="${d%/}"
    if is_repo "$d"; then
      local c; c="$(canon "$d")"
      printf '%s\n' "$c"
      scan_deep "$c/.git"
      scan_deep "$c/.worktrees"
    fi
  done
}

seed_path() {
  # A bad --path is a partial failure, not a successful empty scan (#940):
  # keep scanning the valid paths (their results are still printed), but
  # return 1 — the house contract git-maintain-repos uses for a
  # non-directory root — so exit-code-checking callers (clean.sh's
  # `|| warn "discovery failed"`) can see the failure. The caller captures
  # this status out of the seeding step and makes it the script's exit
  # status; see SEED_STATUS below.
  local p c failed=0
  for p in "${PATHS[@]}"; do
    [ -d "$p" ] || { echo "git-discover-repos: not a directory: $p" >&2; failed=1; continue; }
    c="$(canon "$p")"
    printf '%s\n' "$c"
    scan_deep "$c" || failed=1
    scan_deep "$c/.git" || failed=1
    scan_deep "$c/.worktrees" || failed=1
  done
  return "$failed"
}

if [ "$DRY_RUN" = "1" ]; then
  echo "git-discover-repos: plan"
  echo "  mode:       $MODE"
  echo "  depth:      ${DEPTH_LIMIT:-unlimited}"
  echo "  follow:     $([ "$FOLLOW" = 1 ] && echo yes || echo no)"
  echo "  filter:     $FILTER"
  echo "  bare repos: $([ "$INCLUDE_BARE" = 1 ] && echo included || echo skipped)"
  echo "  home:       $SCAN_HOME"
  if [ "$MODE" = "auto" ]; then
    echo "  roots:      ~/.local/share/opencode/worktree, /private/var/folders/*/*/T/opencode, ~/<numeric|*git*>, every repo directly in ~"
  else
    printf '  roots:      %s\n' "${PATHS[@]}"
  fi
  [ -n "$FIND_SPEC" ] && echo "  also find:  $FIND_SPEC"
  # A dry run still judges its --path arguments (#940): a bad one is the
  # same non-zero failure as in a real run, not a clean plan.
  if [ "$MODE" = "path" ]; then
    _dry_failed=0
    for _p in "${PATHS[@]}"; do
      [ -d "$_p" ] || { echo "git-discover-repos: not a directory: $_p" >&2; _dry_failed=1; }
    done
    [ "$_dry_failed" = "0" ] || exit 1
  fi
  exit 0
fi

# Seeding used to run in a pipeline (`seed_path | sort -u`), where its exit
# status could not reach the script's. Seed to a file instead and capture
# the status: SEED_STATUS (1 when any --path was not a directory, else 0)
# becomes the exit status at --count and at the end of the script, after
# every valid result has been printed. --auto's roots are best-effort by
# design (missing scan roots are skipped), so its status is not captured.
SEED_FILE="$(mktemp)"
SEED_STATUS=0
if [ "$MODE" = "auto" ]; then
  seed_auto > "$SEED_FILE" || true
else
  seed_path > "$SEED_FILE" || SEED_STATUS=$?
fi
sort -u "$SEED_FILE" | while IFS= read -r d
do
  consider "$d"
done
rm -f "$SEED_FILE"

# ---------------------------------------------------------------------------
# Following: hop along git's own links until nothing new turns up.
# ---------------------------------------------------------------------------
FOLLOW_STATUS=0
if [ "$FOLLOW" = "1" ]; then
  round=0
  while [ -s "$QUEUE_FILE" ] && [ "$round" -lt 20 ]; do
    round=$((round + 1))
    CURRENT="$(mktemp)"
    mv "$QUEUE_FILE" "$CURRENT"
    : > "$QUEUE_FILE"
    while IFS= read -r d; do
      [ -d "$d" ] || continue
      # worktree -> the real repository backing it
      # A failed rev-parse must not read as "no common dir" (#1343):
      # capture git's stderr and status instead of discarding them.
      # Only a non-zero status is a failure -- a successful rev-parse
      # that prints nothing still means "no common dir" and stays
      # quiet. In --path mode the failure is named on stderr (git's
      # own lines, then a clean line naming the directory) and counted
      # into FOLLOW_STATUS, the exit verdict below; --auto stays
      # best-effort, like its seeding enumerations (#1325).
      common_err="$(mktemp)"
      common_status=0
      common="$(git_q -C "$d" rev-parse --path-format=absolute --git-common-dir 2>"$common_err")" || common_status=$?
      if [ "$common_status" -ne 0 ]; then
        if [ "$MODE" = "path" ]; then
          cat "$common_err" >&2
          echo "git-discover-repos: failed to resolve git common dir for: $d" >&2
          FOLLOW_STATUS=1
        fi
        common=""
      fi
      rm -f "$common_err"
      if [ -n "$common" ] && [ -d "$common" ]; then
        case "$common" in
          */.git/modules/*)
            # A submodule's common dir lives inside the superproject's
            # .git/modules (#1511): the submodule checkout itself is
            # the canonical repo record (classify kinds it repo), so
            # never emit a record inside another repo's .git.
            ;;
          *)
            main="${common%/.git}"
            [ "$main" = "$common" ] || consider "$main"
            # a bare repo's common dir IS the repo
            [ "$main" = "$common" ] && is_bare_repo "$common" && consider "$common"
            ;;
        esac
      fi
      # repository -> every worktree attached to it
      # `worktree list` used to run in a process substitution, whose
      # status cannot reach the script, with stderr discarded: a
      # failed list ran the loop zero times and the worktrees silently
      # vanished (#1343). Run it to files instead, like the artifact
      # sweep's find (#1325): output it did produce is still consumed,
      # the failure is named the same way, and its status is counted.
      wt_file="$(mktemp)"; wt_err_file="$(mktemp)"; wt_status=0
      git_q -C "$d" worktree list --porcelain > "$wt_file" 2> "$wt_err_file" || wt_status=$?
      if [ "$wt_status" -ne 0 ] && [ "$MODE" = "path" ]; then
        cat "$wt_err_file" >&2
        echo "git-discover-repos: failed to list worktrees for: $d" >&2
        FOLLOW_STATUS=1
      fi
      while IFS= read -r line; do
        case "$line" in
          worktree\ *) consider "${line#worktree }" ;;
        esac
      done < "$wt_file"
      rm -f "$wt_file" "$wt_err_file"
    done < "$CURRENT"
    rm -f "$CURRENT"
  done
fi

# ---------------------------------------------------------------------------
# Emit
# ---------------------------------------------------------------------------
filter_out() {
  case "$FILTER" in
    repos)     awk -F'\t' '$1=="repo"' ;;
    bare)      awk -F'\t' '$1=="repo"' | while IFS=$'\t' read -r k pth; do
                 [ -f "$pth/HEAD" ] && [ -d "$pth/objects" ] && printf '%s\t%s\n' "$k" "$pth"
               done ;;
    worktrees) awk -F'\t' '$1=="worktree"' ;;
    *)         cat ;;
  esac
}

if [ "$COUNT_ONLY" = "1" ]; then
  r=$(awk -F'\t' '$1=="repo"' "$OUT_FILE" | wc -l | tr -d ' ')
  w=$(awk -F'\t' '$1=="worktree"' "$OUT_FILE" | wc -l | tr -d ' ')
  echo "repos=$r worktrees=$w total=$((r + w))"
  if [ "$SEED_STATUS" -ne 0 ]; then
    exit "$SEED_STATUS"
  fi
  exit "${FOLLOW_STATUS:-0}"
fi

sort -u "$OUT_FILE" | filter_out \
  | if [ "$PATHS_ONLY" = "1" ]; then cut -f2; else cat; fi \
  | if [ "$PRINT0" = "1" ]; then tr '\n' '\0'; else cat; fi

# ---------------------------------------------------------------------------
# Optional artifact sweep inside every discovered location
# ---------------------------------------------------------------------------
if [ -n "$FIND_SPEC" ]; then
  FIND_NAMES=()
  IFS=',' read -r -a _specs <<< "$FIND_SPEC"
  for _s in "${_specs[@]}"; do
    case "$_s" in
      cache) FIND_NAMES+=("${CACHE_NAMES[@]}") ;;
      risky) FIND_NAMES+=("${RISKY_NAMES[@]}") ;;
      trash) FIND_NAMES+=("${TRASH_NAMES[@]}") ;;
      all)   FIND_NAMES+=("${ALL_ARTIFACT_NAMES[@]}") ;;
      *)     FIND_NAMES+=("$_s") ;;
    esac
  done
  build_name_expr FIND_EXPR "${FIND_NAMES[@]}"

  reason_for() {
    local b; b="${1##*/}"
    local n
    for n in "${TRASH_NAMES[@]}"; do [ "$b" = "$n" ] && { echo trash; return; }; done
    for n in "${RISKY_NAMES[@]}"; do [ "$b" = "$n" ] && { echo risky; return; }; done
    echo cache
  }

  status_for() {
    [ "$WANT_STATUS" = "1" ] || { echo -; return; }
    local d="$1" repo
    repo="$(git_q -C "$d" rev-parse --show-toplevel 2>/dev/null)" || { echo unknown; return; }
    [ -n "$(git_q -C "$repo" ls-files -- "$d" 2>/dev/null | head -1)" ] && { echo tracked; return; }
    [ -n "$(git_q -C "$repo" diff --cached --name-only -- "$d" 2>/dev/null | head -1)" ] && { echo staged; return; }
    [ -n "$(git_q -C "$repo" ls-files --others --exclude-standard -- "$d" 2>/dev/null | head -1)" ] && { echo untracked; return; }
    echo ignored
  }

  # --walk descends the whole location; --no-walk looks only at the location
  # and its direct children, so `--path X --no-walk` finds X/.trash but not
  # X/a/b/.trash. -prune on match means a dist/ nested inside node_modules/ is
  # never reported separately -- the parent already covers it.
  # The sweep's find used to run in a process substitution with its
  # stderr discarded, so an enumeration failure vanished the same way
  # scan_deep's did (#1325). Run it to files instead so its status can be
  # checked: hits still print, the failure is named on stderr, and
  # FIND_STATUS joins the script's exit status below.
  FIND_STATUS=0
  while IFS=$'\t' read -r _kind loc; do
    [ -d "$loc" ] || continue
    hits_file="$(mktemp)"; find_err_file="$(mktemp)"
    find "$loc" "${DEPTH_ARGS[@]}" \( -name .git -o -name .worktrees \) -prune -o \
               -type d \( "${FIND_EXPR[@]}" \) -prune -print 2>"$find_err_file" > "$hits_file"
    sweep_status=$?
    if [ "$sweep_status" -ne 0 ]; then
      cat "$find_err_file" >&2
      echo "git-discover-repos: failed to enumerate artifacts under: $loc" >&2
      FIND_STATUS=1
    fi
    while IFS= read -r hit; do
      printf 'FOUND\t%s\t%s\t%s\n' "$(reason_for "$hit")" "$(status_for "$hit")" "$hit"
    done < "$hits_file"
    rm -f "$hits_file" "$find_err_file"
  done < <(sort -u "$OUT_FILE")
fi

# The seeding verdict is the script's verdict (#940): without this explicit
# exit, a run that printed a bad --path error above would still exit 0 here.
# An artifact-sweep enumeration failure (#1325) is the same kind of
# partial failure and shares the verdict when seeding itself was clean.
if [ "$SEED_STATUS" -ne 0 ]; then
  exit "$SEED_STATUS"
fi
# A follow-loop git failure (#1343) is the same kind of partial
# failure and shares the verdict when seeding itself was clean.
if [ "${FOLLOW_STATUS:-0}" -ne 0 ]; then
  exit "$FOLLOW_STATUS"
fi
exit "${FIND_STATUS:-0}"
