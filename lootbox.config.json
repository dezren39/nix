{
  "port": 9420,
  "serverUrl": "ws://127.0.0.1:9420/ws",
  "lootboxRoot": "/Users/drewry.pope/.config/nix/.lootbox",
  "mcpServers": {
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "codedb": {
      "command": "codedb",
      "args": ["mcp"],
      "env": {
        "CODEDB_NO_TELEMETRY": "1"
      }
    },
    "fff-nix": {
      "command": "fff-mcp",
      "args": [
        "--no-update-check",
        "--frecency-db", "/Users/drewry.pope/.local/share/fff/frecency.db",
        "--history-db", "/Users/drewry.pope/.local/share/fff/history.db",
        "/Users/drewry.pope/.config/nix"
      ]
    },
    "fff-worktree": {
      "command": "fff-mcp",
      "args": [
        "--no-update-check",
        "--frecency-db", "/Users/drewry.pope/.local/share/fff/frecency.db",
        "--history-db", "/Users/drewry.pope/.local/share/fff/history.db",
        "/Users/drewry.pope/.local/share/opencode/worktree"
      ]
    },
    "fff": {
      "command": "fff-mcp",
      "args": [
        "--no-update-check",
        "--frecency-db", "/Users/drewry.pope/.local/share/fff/frecency.db",
        "--history-db", "/Users/drewry.pope/.local/share/fff/history.db",
        "/Users/drewry.pope/git"
      ]
    },
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--viewport=800x600",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-category-emulation"
      ]
    },
    "context7": {
      "command": "mcp-remote",
      "args": ["https://mcp.context7.com/mcp"]
    },
    "datadog": {
      "command": "mcp-remote",
      "args": ["https://mcp.datadoghq.com/v1/mcp?toolsets=core,workflows,alerting&omit_tools=delete_datadog_workflow"]
    },
    "atlassian": {
      "command": "mcp-remote",
      "args": ["https://mcp.atlassian.com/v2/mcp?tools=all"]
    },
    "github": {
      "command": "/run/current-system/sw/bin/github-mcp",
      "args": []
    },
    "aws": {
      "command": "/run/current-system/sw/bin/uvx",
      "args": [
        "mcp-proxy-for-aws-cli@1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata", "AWS_REGION=us-east-1"
      ]
    },
    "aws-knowledge": {
      "transport": "streamable_http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "deepwiki": {
      "transport": "streamable_http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "terraform": {
      "command": "/run/current-system/sw/bin/terraform-mcp-server",
      "args": ["stdio", "--toolsets=registry"]
    },
    "nixos": {
      "command": "/run/current-system/sw/bin/mcp-nixos",
      "args": []
    },
    "playwright": {
      "command": "/run/current-system/sw/bin/playwright-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--viewport-size=1280x720",
        "--output-dir", "/Users/drewry.pope/.cache/playwright-mcp"
      ]
    },
    "markitdown": {
      "command": "/run/current-system/sw/bin/markitdown-mcp",
      "args": []
    },
    "sequential-thinking": {
      "command": "/run/current-system/sw/bin/mcp-server-sequential-thinking",
      "args": [],
      "env": {
        "DISABLE_THOUGHT_LOGGING": "true"
      }
    }
  }
}
